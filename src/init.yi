  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, "\n")

  plist = stdr.str_concat(plist, "  ")
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "key")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, "NSHighResolutionCapable")
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "/key")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "true/")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, "\n")

  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "/dict")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, "\n")
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "/plist")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, "\n")

  <- stdr.write_text_file(plist_path, plist)
;

-- Resolve a bring name to a file path. Checks src_dir/<name>.yi
: file_exists(path = string) (( num ))
  if stdr.file_exists(path) { <- 0 }
  <- 1
;

: find_runtime_src(argv = any) (( string ))
  let ?runtime_src = stdr.read_text_file("src/runtime.inc")
  if !stdr.is_null(runtime_src) { <- runtime_src }
  runtime_src = stdr.read_text_file("src/bootstrap/runtime.inc")
  if !stdr.is_null(runtime_src) { <- runtime_src }

  let ?exe0_in = argv[0] ?? ""
  let ?exe_path = exe0_in
  if stdr.len(exe0_in) > 0 && stdr.len(dir_of(exe0_in)) == 0
    let which_cmd = stdr.str_concat("command -v ", shell_quote_arg(exe0_in))
    let which_res = stdr.run_command(which_cmd)
    let which_code = which_res[0] ?? 1
    if which_code == 0
      let ?p = which_res[1] ?? ""
      let pn = stdr.len(p)
      if pn > 0 && stdr.slice(p, pn - 1, pn) == "\n"
        p = stdr.slice(p, 0, pn - 1)
      if stdr.len(p) > 0 { exe_path = p }

  if stdr.len(exe_path) > 0
    let exe_dir = dir_of(exe_path)
    if stdr.len(exe_dir) > 0
      let ?p = stdr.str_concat(exe_dir, "../src/runtime.inc")
      if file_exists(p) == 0
        runtime_src = stdr.read_text_file(p)
        if !stdr.is_null(runtime_src) { <- runtime_src }
      p = stdr.str_concat(exe_dir, "../src/bootstrap/runtime.inc")
      if file_exists(p) == 0
        runtime_src = stdr.read_text_file(p)
        if !stdr.is_null(runtime_src) { <- runtime_src }
      p = stdr.str_concat(exe_dir, "../../src/runtime.inc")
      if file_exists(p) == 0
        runtime_src = stdr.read_text_file(p)
        if !stdr.is_null(runtime_src) { <- runtime_src }
      p = stdr.str_concat(exe_dir, "../../src/bootstrap/runtime.inc")
      if file_exists(p) == 0
        runtime_src = stdr.read_text_file(p)
        if !stdr.is_null(runtime_src) { <- runtime_src }
      p = stdr.str_concat(exe_dir, "../share/yis/runtime.inc")
      if file_exists(p) == 0
        runtime_src = stdr.read_text_file(p)
        if !stdr.is_null(runtime_src) { <- runtime_src }

  runtime_src = stdr.read_text_file("/opt/homebrew/share/yis/runtime.inc")
  if !stdr.is_null(runtime_src) { <- runtime_src }
  runtime_src = stdr.read_text_file("/usr/local/share/yis/runtime.inc")
  if !stdr.is_null(runtime_src) { <- runtime_src }
  runtime_src = stdr.read_text_file("/usr/share/yis/runtime.inc")
  if !stdr.is_null(runtime_src) { <- runtime_src }

  <- ""
;

: _chomp_newline(text = string) (( string ))
  let n = stdr.len(text)
  if n > 0 && stdr.slice(text, n - 1, n) == "\n"
    <- stdr.slice(text, 0, n - 1)
  <- text
;

: _env_value(name = string) (( string ))
  let cached = g_env_cache[name]
  if !stdr.is_null(cached) { <- cached ?? "" }
  let val = stdr.getenv(name) ?? ""
  g_env_cache[name] = val
  <- val
;

: resolve_stdlib_module_path(bname = string) (( string ))
  let ?p = ""

  let stdlib_env = _env_value("YIS_STDLIB")
  if stdr.len(stdlib_env) > 0
    p = stdr.str_concat(stdr.str_concat(stdlib_env, "/"), bname)
    p = stdr.str_concat(p, ".yi")
    if file_exists(p) == 0 { <- p }

  p = stdr.str_concat(stdr.str_concat("src/stdlib/", bname), ".yi")
  if file_exists(p) == 0 { <- p }
  p = stdr.str_concat(stdr.str_concat("src/bootstrap/stdlib/", bname), ".yi")
  if file_exists(p) == 0 { <- p }

  p = stdr.str_concat(stdr.str_concat("yis/src/stdlib/", bname), ".yi")
  if file_exists(p) == 0 { <- p }
  p = stdr.str_concat(stdr.str_concat("../Yis/src/stdlib/", bname), ".yi")
  if file_exists(p) == 0 { <- p }
  p = stdr.str_concat(stdr.str_concat("../../Yis/src/stdlib/", bname), ".yi")
  if file_exists(p) == 0 { <- p }
  p = stdr.str_concat(stdr.str_concat("../../../Yis/src/stdlib/", bname), ".yi")
  if file_exists(p) == 0 { <- p }
  p = stdr.str_concat(stdr.str_concat("../yis/src/stdlib/", bname), ".yi")
  if file_exists(p) == 0 { <- p }
  p = stdr.str_concat(stdr.str_concat("../../yis/src/stdlib/", bname), ".yi")
  if file_exists(p) == 0 { <- p }
  p = stdr.str_concat(stdr.str_concat("../../../yis/src/stdlib/", bname), ".yi")
  if file_exists(p) == 0 { <- p }

  p = stdr.str_concat(stdr.str_concat("/opt/homebrew/share/yis/stdlib/", bname), ".yi")
  if file_exists(p) == 0 { <- p }
  p = stdr.str_concat(stdr.str_concat("/usr/local/share/yis/stdlib/", bname), ".yi")
  if file_exists(p) == 0 { <- p }
  p = stdr.str_concat(stdr.str_concat("/usr/share/yis/stdlib/", bname), ".yi")
  if file_exists(p) == 0 { <- p }

  <- ""
;

: resolve_bring(bname = string, src_dir = string) (( string ))
  -- Convert dots to path separators for subdirectory bring
  let ?path_name = bname
  let ?pi = 0
  let pn = stdr.len(bname)
  for (; pi < pn; pi = pi + 1)
    if stdr.slice(bname, pi, pi + 1) == "."
      path_name = stdr.str_concat(stdr.str_concat(stdr.slice(path_name, 0, pi), "/"), stdr.slice(path_name, pi + 1, stdr.len(path_name)))
  -- Check cache first
  let cache_key = stdr.str_concat(stdr.str_concat(bname, ":"), src_dir)
  let cached = g_path_cache[cache_key]
  if !stdr.is_null(cached) { <- cached ?? "" }
  -- First try: same directory as the source file
  let ?p = stdr.str_concat(stdr.str_concat(src_dir, path_name), ".yi")
  if file_exists(p) == 0 { g_path_cache[cache_key] = p; <- p }
  -- Second try: parent directory of source
  p = stdr.str_concat(stdr.str_concat(stdr.str_concat(src_dir, "../"), path_name), ".yi")
  if file_exists(p) == 0 { g_path_cache[cache_key] = p; <- p }
  -- Third try: project src tree from cwd
  p = stdr.str_concat(stdr.str_concat("src/", path_name), ".yi")
  if file_exists(p) == 0 { g_path_cache[cache_key] = p; <- p }
  p = stdr.str_concat(stdr.str_concat("../src/", path_name), ".yi")
  if file_exists(p) == 0 { g_path_cache[cache_key] = p; <- p }
  p = stdr.str_concat(stdr.str_concat("../../src/", path_name), ".yi")
  if file_exists(p) == 0 { g_path_cache[cache_key] = p; <- p }
  -- Fourth try: stdlib search (env/install/dev paths)
  p = resolve_stdlib_module_path(bname)
  if stdr.len(p) > 0 { g_path_cache[cache_key] = p; <- p }
  -- Fifth try: cwd-relative paths for external modules (e.g. ../name/src/name.yi)
  if is_external_module(bname)
    let dev1 = stdr.str_concat(stdr.str_concat("../", bname), stdr.str_concat("/src/", stdr.str_concat(bname, ".yi")))
    if file_exists(dev1) == 0 { g_path_cache[cache_key] = dev1; <- dev1 }
    let dev2 = stdr.str_concat(stdr.str_concat("../", bname), stdr.str_concat("/", stdr.str_concat(bname, ".yi")))
    if file_exists(dev2) == 0 { g_path_cache[cache_key] = dev2; <- dev2 }
    let dev3 = stdr.str_concat(stdr.str_concat("../../", bname), stdr.str_concat("/src/", stdr.str_concat(bname, ".yi")))
    if file_exists(dev3) == 0 { g_path_cache[cache_key] = dev3; <- dev3 }
  -- Fallback to original behavior
  p = stdr.str_concat(stdr.str_concat(src_dir, path_name), ".yi")
  g_path_cache[cache_key] = p
  <- p
;

-- Load and parse a module, with caching
: load_module(fpath = string) (( any ))
  let cached = g_ast_cache[fpath]
  if !stdr.is_null(cached) { <- cached }
  let src = stdr.read_text_file(fpath)
  if stdr.is_null(src)
    stdr.write(stdr.str_concat("ERR: Cannot read module: ", stdr.str_concat(fpath, "\n")))
    stdr.exit_process(1)
  g_source_hashes[fpath] = stdr.hash_text(src)
  let toks = lexer.lex_with_escapes(src, should_decode_escapes(fpath))
  let ast = parser.parse(toks)
  if stdr.is_null(ast)
    stdr.write(stdr.str_concat("ERR: Cannot parse module: ", stdr.str_concat(fpath, "\n")))
    stdr.exit_process(1)
  g_ast_cache[fpath] = ast
  <- ast
;

-- ============================================================
-- Optimizer: literal folding, immutable scalar propagation and dead code.
-- Keep transformations conservative: values are dynamically typed, and an
-- expression can perform calls or assignments even inside a literal container.
-- ============================================================

: lit_int(v = any) (( any ))
  let ?n = []: [string => any]
  n["tag"] = "int"
  n["value"] = stdr.str(v)
  <- n
;

: lit_bool(v = bool) (( any ))
  let ?n = []: [string => any]
  n["tag"] = "bool"
  n["value"] = v
  <- n
;

: is_lit(e = any) (( bool ))
  if stdr.is_null(e) { <- false }
  let t = e["tag"] ?? ""
  <- t == "int" || t == "float" || t == "bool" || t == "str" || t == "null"
;

: is_non_null_lit(e = any) (( bool ))
  if stdr.is_null(e) { <- false }
  let t = e["tag"] ?? ""
  <- t == "int" || t == "float" || t == "bool" || t == "str" || t == "array" || t == "dict"
;

: is_int_lit(e = any) (( bool ))
  if stdr.is_null(e) { <- false }
  <- (e["tag"] ?? "") == "int"
;

: int_lit_val(e = any) (( num ))
  <- stdr.num(e["value"] ?? 0)
;

: is_bool_lit(e = any) (( bool ))
  if stdr.is_null(e) { <- false }
  <- (e["tag"] ?? "") == "bool"
;

: bool_lit_val(e = any) (( bool ))
  <- e["value"] ?? false
;

: env_new() (( any ))
  <- []: [string => any]
;

: env_clone(env = any) (( any ))
  let ?out = []: [string => any]
  let ks = stdr.keys(env)
  let ?i = 0
  let n = stdr.len(ks)
  for (; i < n; i = i + 1)
    let k = ks[i] ?? ""
    out[k] = env[k]
  <- out
;

: env_get(env = any, name = string) (( any ))
  let writes = env["$writes"]
  if !stdr.is_null(writes) && !stdr.is_null(writes[name]) { <- null }
  <- env[name]
;

: env_set(env = any, name = string, value = any) (( any ))
  let ?out = env_clone(env)
  let writes = env["$writes"]
  if !stdr.is_null(writes) && !stdr.is_null(writes[name]) { out[name] = null }
  else { out[name] = value }
  <- out
;

: env_kill(env = any, name = string) (( any ))
  let ?out = env_clone(env)
  out[name] = null
  <- out
;

-- A write anywhere in a function, including a loop or captured lambda, makes
-- scalar propagation unsafe. Gather writes before optimizing its statements.
-- The internal key cannot collide with a Yis identifier.
: opt_collect_expr_writes(e = any, writes = any) (( -- ))
  let ?write_map = writes
  if stdr.is_null(e) { <- }
  let t = e["tag"] ?? ""
  if t == "assign"
    let lhs = e["lhs"]
    let lhs_tag = lhs["tag"] ?? ""
    if lhs_tag == "ident" { write_map[lhs["name"] ?? ""] = true }
    opt_collect_expr_writes(lhs, writes)
    opt_collect_expr_writes(e["rhs"], writes)
  elif t == "unary"
    opt_collect_expr_writes(e["operand"], writes)
  elif t == "binop"
    opt_collect_expr_writes(e["left"], writes)
    opt_collect_expr_writes(e["right"], writes)
  elif t == "member" || t == "index"
    opt_collect_expr_writes(e["obj"], writes)
    opt_collect_expr_writes(e["idx"], writes)
  elif t == "call" || t == "bang_call"
    opt_collect_expr_writes(e["func"], writes)
    opt_collect_expr_writes(e["recv"], writes)
    let args = e["args"] ?? []: [any]
    let ?i = 0
    for (; i < stdr.len(args); i = i + 1) { opt_collect_expr_writes(args[i], writes) }
  elif t == "array"
    let xs = e["elems"] ?? []: [any]
    let ?i = 0
    for (; i < stdr.len(xs); i = i + 1) { opt_collect_expr_writes(xs[i], writes) }
  elif t == "dict"
    let xs = e["entries"] ?? []: [any]
    let ?i = 0
    for (; i < stdr.len(xs); i = i + 1)
      opt_collect_expr_writes(xs[i]["key"], writes)
      opt_collect_expr_writes(xs[i]["value"], writes)
  elif t == "if_expr"
    opt_collect_expr_writes(e["cond"], writes)
    opt_collect_expr_writes(e["then"], writes)
    opt_collect_expr_writes(e["else"], writes)
  elif t == "lambda"
    opt_collect_block_writes(e["body"] ?? []: [any], writes)
  elif t == "match"
    opt_collect_expr_writes(e["scrut"], writes)
    let arms = e["arms"] ?? []: [any]
    let ?i = 0
    for (; i < stdr.len(arms); i = i + 1) { opt_collect_expr_writes(arms[i]["expr"], writes) }
  elif t == "interp"
    let parts = e["parts"] ?? []: [any]
    let ?i = 0
    for (; i < stdr.len(parts); i = i + 1)
      let p = parts[i]
      let part_kind = p["kind"] ?? ""
      if part_kind == "expr"
        opt_collect_expr_writes(interp_expr_to_ast(p["val"] ?? ""), writes)
;

: opt_collect_stmt_writes(s = any, writes = any) (( -- ))
  if stdr.is_null(s) { <- }
  let t = s["tag"] ?? ""
  if t == "let" || t == "const" { opt_collect_expr_writes(s["init"], writes) }
  elif t == "return" { opt_collect_expr_writes(s["value"], writes) }
  elif t == "expr_stmt" { opt_collect_expr_writes(s["expr"], writes) }
  elif t == "if"
    opt_collect_expr_writes(s["cond"], writes)
    opt_collect_block_writes(s["then"] ?? []: [any], writes)
    opt_collect_block_writes(s["else"] ?? []: [any], writes)
  elif t == "for"
    opt_collect_stmt_writes(s["init_stmt"], writes)
    opt_collect_expr_writes(s["init"], writes)
    opt_collect_expr_writes(s["cond"], writes)
    opt_collect_expr_writes(s["step"], writes)
    opt_collect_block_writes(s["body"] ?? []: [any], writes)
  elif t == "foreach"
    opt_collect_expr_writes(s["iter"], writes)
    opt_collect_block_writes(s["body"] ?? []: [any], writes)
;

: opt_collect_block_writes(stmts = any, writes = any) (( -- ))
  let ?i = 0
  for (; i < stdr.len(stmts); i = i + 1) { opt_collect_stmt_writes(stmts[i], writes) }
;

: opt_body_env(stmts = any) (( any ))
  let ?env = env_new()
  let ?writes = []: [string => any]
  opt_collect_block_writes(stmts, writes)
  env["$writes"] = writes
  <- env
;

-- Folding must not overflow in the compiler process. Leave such operations
-- to the runtime rather than evaluating undefined signed arithmetic here.
: can_fold_int_op(op = string, a = num, b = num) (( bool ))
  let hi = 9223372036854775807
  let lo = 0 - hi - 1
  if op == "plus"
    if b > 0 { <- a <= hi - b }
    <- a >= lo - b
  if op == "minus"
    if b > 0 { <- a >= lo + b }
    <- a <= hi + b
  if op == "star"
    if a == 0 || b == 0 { <- true }
    if a > 0
      if b > 0 { <- a <= hi / b }
      <- b >= lo / a
    if b > 0 { <- a >= lo / b }
    <- a >= hi / b
  <- false
;

: expr_has_side_effect(e = any) (( bool ))
  if stdr.is_null(e) { <- false }
  let t = e["tag"] ?? ""
  if t == "call" || t == "bang_call" || t == "assign" { <- true }
  -- Dynamic arithmetic and indexing can trap. Treat them as observable too.
  if t == "unary"
    let unary_op = e["op"] ?? ""
    if unary_op == "bang" || unary_op == "hash"
      <- expr_has_side_effect(e["operand"])
    <- true
  if t == "binop"
    let op = e["op"] ?? ""
    if op == "ampamp" || op == "barbar" || op == "qq" || op == "eqeq" || op == "ne"
      <- expr_has_side_effect(e["left"]) || expr_has_side_effect(e["right"])
    <- true
  if t == "member" || t == "index" { <- true }
  if t == "array"
    let xs = e["elems"] ?? []: [any]
    let ?i = 0
    let n = stdr.len(xs)
    for (; i < n; i = i + 1) { if expr_has_side_effect(xs[i]) { <- true } }
    <- false
  if t == "dict"
    let es = e["entries"] ?? []: [any]
    let ?i = 0
    let n = stdr.len(es)
    for (; i < n; i = i + 1)
      let it = es[i]
      if expr_has_side_effect(it["key"]) || expr_has_side_effect(it["value"]) { <- true }
    <- false
  if t == "if_expr"
    <- expr_has_side_effect(e["cond"]) || expr_has_side_effect(e["then"]) || expr_has_side_effect(e["else"])
  if t == "int" || t == "float" || t == "bool" || t == "str" || t == "null" { <- false }
  -- Interpolation contains parsed expressions; match arms may contain calls.
  -- Retain unknown expression forms rather than silently deleting their work.
  <- true
;

: opt_expr(e = any, env = any) (( any ))
  if stdr.is_null(e) { <- null }
  let t = e["tag"] ?? ""

  if t == "ident"
    let name = e["name"] ?? ""
    let v = env_get(env, name)
    if !stdr.is_null(v) { <- v }
    <- e

  if t == "unary"
    let op = e["op"] ?? ""
    let x = opt_expr(e["operand"], env)
    if op == "minus" && is_int_lit(x)
      let xv = int_lit_val(x)
      if xv != 0 - 9223372036854775807 - 1 { <- lit_int(0 - xv) }
    if op == "bang" && is_bool_lit(x)
      if bool_lit_val(x) { <- lit_bool(false) }
      <- lit_bool(true)
    if op == "hash"
      let xt = x["tag"] ?? ""
      if xt == "array" && !expr_has_side_effect(x) { <- lit_int(stdr.len(x["elems"] ?? []: [any])) }
      if xt == "str" { <- lit_int(stdr.len(x["value"] ?? "")) }
    let ?n = env_clone(e)
    n["tag"] = "unary"
    n["op"] = op
    n["operand"] = x
    <- n

  if t == "binop"
    let op = e["op"] ?? ""
    let a = opt_expr(e["left"], env)
    let b = opt_expr(e["right"], env)

    if op == "qq"
      let at = a["tag"] ?? ""
      if at == "null" { <- b }
      if is_non_null_lit(a) { <- a }

    if is_int_lit(a) && is_int_lit(b)
      let av = int_lit_val(a)
      let bv = int_lit_val(b)
      if can_fold_int_op(op, av, bv)
        if op == "plus" { <- lit_int(av + bv) }
        if op == "minus" { <- lit_int(av - bv) }
        if op == "star" { <- lit_int(av * bv) }
      if op == "eqeq" { <- lit_bool(av == bv) }
      if op == "ne" { <- lit_bool(av != bv) }
      if op == "lt" { <- lit_bool(av < bv) }
      if op == "le" { <- lit_bool(av <= bv) }
      if op == "gt" { <- lit_bool(av > bv) }
      if op == "ge" { <- lit_bool(av >= bv) }

    if is_bool_lit(a) && is_bool_lit(b)
      let av = bool_lit_val(a)
      let bv = bool_lit_val(b)
      if op == "ampamp" { <- lit_bool(av && bv) }
      if op == "barbar" { <- lit_bool(av || bv) }
      if op == "eqeq" { <- lit_bool(av == bv) }
      if op == "ne" { <- lit_bool(av != bv) }

    -- Algebraic identities on unknown values can change dynamic types (for
    -- example, string + 0 concatenates), coerce values, or discard side effects.
    -- Fold only the two literal integer case above.
    if op == "ampamp"
      if is_bool_lit(a) && !bool_lit_val(a) { <- lit_bool(false) }
    if op == "barbar"
      if is_bool_lit(a) && bool_lit_val(a) { <- lit_bool(true) }

    let ?n = env_clone(e)
    n["tag"] = "binop"
    n["op"] = op
    n["left"] = a
    n["right"] = b
    <- n

  if t == "call"
    let fn = opt_expr(e["func"], env)
    let args = e["args"] ?? []: [any]
    let ?out_args = []: [any]
    let ?i = 0
    let an = stdr.len(args)
    for (; i < an; i = i + 1) { stdr.push(out_args, opt_expr(args[i], env)) }

    let fnt = fn["tag"] ?? ""

    -- Phase 2: peepholes for stdr calls
    if fnt == "member"
      let obj = fn["obj"]
      let field = fn["field"] ?? ""
      let objt = dict_get_or(obj, "tag", "")
      let objn = dict_get_or(obj, "name", "")
      if objt == "ident" && objn == "stdr"
        if field == "str" && stdr.len(out_args) == 1
          let a0 = out_args[0]
          let a0t = dict_get_or(a0, "tag", "")
          if a0t == "str" { <- a0 }
        if field == "num" && stdr.len(out_args) == 1
          let a0 = out_args[0]
          let a0t = dict_get_or(a0, "tag", "")
          if a0t == "int" { <- a0 }
        if field == "is_null" && stdr.len(out_args) == 1
          let a0 = out_args[0]
          let a0t = dict_get_or(a0, "tag", "")
          if a0t == "null" { <- lit_bool(true) }
          if is_non_null_lit(a0) && !expr_has_side_effect(a0) { <- lit_bool(false) }
        if field == "len" && stdr.len(out_args) == 1
          let a0 = out_args[0]
          let t0 = dict_get_or(a0, "tag", "")
          if t0 == "array" && !expr_has_side_effect(a0) { <- lit_int(stdr.len(dict_get_or(a0, "elems", []: [any]))) }
          if t0 == "str" { <- lit_int(stdr.len(dict_get_or(a0, "value", ""))) }

    let ?n = env_clone(e)
    n["tag"] = "call"
    n["func"] = fn
    n["args"] = out_args
    <- n

  if t == "member"
    let ?n = env_clone(e)
    n["tag"] = "member"
    n["obj"] = opt_expr(e["obj"], env)
    n["field"] = e["field"]
    <- n

  if t == "index"
    let ?n = env_clone(e)
    n["tag"] = "index"
    n["obj"] = opt_expr(e["obj"], env)
    n["idx"] = opt_expr(e["idx"], env)
    <- n

  if t == "assign"
    -- An assignment target names storage, not its previously known value.
    let orig_lhs = e["lhs"]
    let ?lhs = orig_lhs
    let orig_lhs_tag = orig_lhs["tag"] ?? ""
    if orig_lhs_tag != "ident" { lhs = opt_expr(orig_lhs, env) }
    let rhs = opt_expr(e["rhs"], env)
    let ?n = env_clone(e)
    n["tag"] = "assign"
    n["lhs"] = lhs
    n["rhs"] = rhs
    <- n

  if t == "array"
    let xs = e["elems"] ?? []: [any]
    let ?out = []: [any]
    let ?i = 0
    let n = stdr.len(xs)
    for (; i < n; i = i + 1) { stdr.push(out, opt_expr(xs[i], env)) }
    let ?r = env_clone(e)
    r["tag"] = "array"
    r["elems"] = out
    <- r

  if t == "dict"
    let xs = e["entries"] ?? []: [any]
    let ?out = []: [any]
    let ?i = 0
    let n = stdr.len(xs)
    for (; i < n; i = i + 1)
      let it = xs[i]
      let ?u = env_clone(it)
      u["key"] = opt_expr(it["key"], env)
      u["value"] = opt_expr(it["value"], env)
      stdr.push(out, u)
    let ?r = env_clone(e)
    r["tag"] = "dict"
    r["entries"] = out
    <- r

  if t == "if_expr"
    let c = opt_expr(e["cond"], env)
    let tv = opt_expr(e["then"], env)
    let ev = opt_expr(e["else"], env)
    if is_bool_lit(c)
      if bool_lit_val(c) { <- tv }
      <- ev
    let ?n = env_clone(e)
    n["tag"] = "if_expr"
    n["cond"] = c
    n["then"] = tv
    n["else"] = ev
    <- n

  <- e
;

: stmt_has_return(s = any) (( bool ))
  if stdr.is_null(s) { <- false }
  let st = s["tag"] ?? ""
  if st == "return" { <- true }
  if st == "if"
    let tb = s["then"] ?? []: [any]
    let eb = s["else"] ?? []: [any]
    if block_has_return(tb) { <- true }
    if block_has_return(eb) { <- true }
    <- false
  if st == "for" || st == "foreach"
    <- block_has_return(s["body"] ?? []: [any])
  <- false
;

: block_has_return(stmts = any) (( bool ))
  let ?i = 0
  let n = stdr.len(stmts)
  for (; i < n; i = i + 1)
    if stmt_has_return(stmts[i]) { <- true }
  <- false
;

: opt_stmt(s = any, env = any) (( any ))
  if stdr.is_null(s) { <- pair(null, env) }
  let st = s["tag"] ?? ""

  if st == "let"
    let name = s["name"] ?? ""
    let mut = s["mutable"] ?? false
    let init = opt_expr(s["init"], env)
    let ?next_env = env
    if !mut && is_lit(init) { next_env = env_set(env, name, init) }
    else { next_env = env_kill(env, name) }
    let ?n = env_clone(s)
    n["tag"] = "let"
    n["name"] = name
    n["mutable"] = mut
    n["init"] = init
    <- pair(n, next_env)

  if st == "const"
    let name = s["name"] ?? ""
    let init = opt_expr(s["init"], env)
    let ?next_env = env
    if is_lit(init) { next_env = env_set(env, name, init) }
    else { next_env = env_kill(env, name) }
    let ?n = env_clone(s)
    n["tag"] = "const"
    n["name"] = name
    n["init"] = init
    <- pair(n, next_env)

  if st == "return"
    let ?n = env_clone(s)
    n["tag"] = "return"
    n["value"] = opt_expr(s["value"], env)
    <- pair(n, env)

  if st == "expr_stmt"
    let ex = opt_expr(s["expr"], env)
    if !expr_has_side_effect(ex) { <- pair(null, env) }
    let ?n = env_clone(s)
    n["tag"] = "expr_stmt"
    n["expr"] = ex
    <- pair(n, env)

  if st == "if"
    let c = opt_expr(s["cond"], env)
    let then_env = env_clone(env)
    let else_env = env_clone(env)
    let then_b = opt_block(s["then"] ?? []: [any], then_env)
    let else_b = opt_block(s["else"] ?? []: [any], else_env)
    let ?n = env_clone(s)
    n["tag"] = "if"
    n["cond"] = c
    n["then"] = then_b
    n["else"] = else_b
    -- Retain the block boundary when selecting a constant branch. Its locals
    -- must not escape their scope or conflict with surrounding declarations.
    if is_bool_lit(c)
      if bool_lit_val(c) { n["else"] = []: [any] }
      else { n["then"] = []: [any] }
    <- pair(n, env)

  if st == "for"
    let init_s = s["init_stmt"]
    let init_e = s["init"]
    let ?loop_env = env_clone(env)
    let ?opt_init_s = null
    if !stdr.is_null(init_s)
      let ip = opt_stmt(init_s, loop_env)
      opt_init_s = ip[0]
      -- Even an immutable loop variable must refer to the scoped declaration.
      loop_env = env_kill(ip[1] ?? loop_env, init_s["name"] ?? "")
    let cond = opt_expr(s["cond"], loop_env)
    let step = opt_expr(s["step"], loop_env)
    let body = opt_block(s["body"] ?? []: [any], loop_env)
    let ?n = env_clone(s)
    n["tag"] = "for"
    n["init"] = if stdr.is_null(init_e) { null } else { opt_expr(init_e, env) }
    if is_bool_lit(cond) && bool_lit_val(cond) { n["cond"] = null } else { n["cond"] = cond }
    if !stdr.is_null(step) && !expr_has_side_effect(step) { n["step"] = null } else { n["step"] = step }
    n["body"] = body
    if !stdr.is_null(init_s) { n["init_stmt"] = opt_init_s }
    <- pair(n, env)

  if st == "foreach"
    let iter = opt_expr(s["iter"], env)
    let body_env = env_kill(env, s["item"] ?? "")
    let body = opt_block(s["body"] ?? []: [any], body_env)
    let itag = iter["tag"] ?? ""
    if itag == "array" && stdr.len(iter["elems"] ?? []: [any]) == 0 { <- pair(null, env) }
    if itag == "str" && stdr.len(iter["value"] ?? "") == 0 { <- pair(null, env) }
    let ?n = env_clone(s)
    n["tag"] = "foreach"
    n["item"] = s["item"]
    n["iter"] = iter
    n["body"] = body
    <- pair(n, env)

  <- pair(s, env)
;

: opt_block(stmts = any, env = any) (( any ))
  let ?out = []: [any]
  let ?cur_env = env
  let ?i = 0
  let n = stdr.len(stmts)
  for (; i < n; i = i + 1)
    let s = stmts[i]
    let sp = opt_stmt(s, cur_env)
    let os = sp[0]
    cur_env = sp[1] ?? cur_env
    if stdr.is_null(os) { continue }
    let ot = os["tag"] ?? ""
    stdr.push(out, os)
    if ot == "return" || ot == "break" || ot == "continue" { <- out }
  <- out
;

: opt_decl(d = any) (( any ))
  if stdr.is_null(d) { <- d }
  let t = d["tag"] ?? ""
  if t == "fun" || t == "macro"
    let ?n = env_clone(d)
    let ret = n["ret"] ?? "any"
    if t == "macro" && ret != "void" && ret != "--"
      let original = n["body"] ?? []: [any]
      let ?normalized = []: [any]
      let count = stdr.len(original)
      for (let ?bi = 0; bi < count; bi += 1)
        let stmt = original[bi]
        let stmt_tag = stmt["tag"] ?? ""
        if bi == count - 1 && stmt_tag == "expr_stmt"
          let ?returned = env_clone(stmt)
          returned["tag"] = "return"
          returned["value"] = stmt["expr"]
          stdr.push(normalized, returned)
        else
          stdr.push(normalized, stmt)
      n["body"] = normalized
    let ?env = opt_body_env(n["body"] ?? []: [any])
    let params = n["params"] ?? []: [any]
    let ?i = 0
    let pn = stdr.len(params)
    for (; i < pn; i = i + 1)
      let p = params[i]
      env = env_kill(env, p["name"] ?? "")
    n["body"] = opt_block(n["body"] ?? []: [any], env)
    <- n
  if t == "exit"
    let ?n = env_clone(d)
    n["body"] = opt_block(n["body"] ?? []: [any], opt_body_env(n["body"] ?? []: [any]))
    <- n
  if t == "class"
    let ?n = env_clone(d)
    let methods = n["methods"] ?? []: [any]
    let ?out = []: [any]
    let ?i = 0
    let mn = stdr.len(methods)
    for (; i < mn; i = i + 1)
      let ?m = env_clone(methods[i])
      let ?env = opt_body_env(m["body"] ?? []: [any])
      let params = m["params"] ?? []: [any]
      let ?pi = 0
      let pn = stdr.len(params)
      for (; pi < pn; pi = pi + 1)
        let p = params[pi]
        env = env_kill(env, p["name"] ?? "")
      m["body"] = opt_block(m["body"] ?? []: [any], env)
      stdr.push(out, m)
    n["methods"] = out
    <- n
  if t == "def"
    let ?n = env_clone(d)
    n["init"] = opt_expr(n["init"], env_new())
    <- n
  <- d
;

: optimize_program_once(ast = any) (( any ))
  if stdr.is_null(ast) { <- ast }
  let decls = ast["decls"] ?? []: [any]
  let ?out = []: [any]
  let ?i = 0
  let n = stdr.len(decls)
  for (; i < n; i = i + 1)
    stdr.push(out, opt_decl(decls[i]))
  let ?p = env_clone(ast)
  p["tag"] = ast["tag"] ?? "program"
  p["decls"] = out
  <- p
;

: optimize_program(ast = any) (( any ))
  if stdr.is_null(ast) { <- ast }
  <- optimize_program_once(ast)
;

-- Emit a single brought module. Returns the emitted C code string.
: emit_one_bring(bname = string, src_dir = string) (( string ))
  let decls_key = "decls"
  let fpath = resolve_bring(bname, src_dir)
  let mod_ast = load_module(fpath)
  if stdr.is_null(mod_ast) { <- "" }
  let saved_path = g_emit_file_path
  g_emit_file_path = fpath
  g_last_line_num = 0
  let mod_c = emit_unit(mod_ast)
  g_emit_file_path = saved_path
  let ?parts = []: [any]
  stdr.push(parts, "\n/* begin embedded module: ")
  stdr.push(parts, bname)
  stdr.push(parts, " */\n")
  stdr.push(parts, mod_c)
  stdr.push(parts, "/* end embedded module: ")
  stdr.push(parts, bname)
  stdr.push(parts, " */\n")
  <- stdr.join(parts)
;

-- Visit imported modules before their dependents, including arbitrary depth.
: collect_brings_visit(decls = any, src_dir = string, seen = any, result = any) (( -- ))
  let ?seen_map = seen
  let ?i = 0
  let n = stdr.len(decls)
  for (; i < n; i = i + 1)
    let d = decls[i]
    if d["tag"] != "bring" { continue }
    let bname = d["name"] ?? ""
    if bname == "math" { continue }
    let fpath = resolve_bring(bname, src_dir)
    let identity = driver_absolute_path(fpath)
    let state = seen[identity] ?? 0
    if state == 1
      stdr.write(stdr.str_concat("ERR: Cyclic module import: ", stdr.str_concat(fpath, "\n")))
      stdr.exit_process(1)
    if state == 2 { continue }
    seen_map[identity] = 1
    let module = load_module(fpath)
    if !stdr.is_null(module)
      collect_brings_visit(module["decls"] ?? []: [any], dir_of(fpath), seen, result)
    stdr.push(result, [bname, src_dir])
    seen_map[identity] = 2
;

: collect_brings(decls = any, src_dir = string) (( any ))
  let result = []: [any]
  let seen = []: [string => any]
  collect_brings_visit(decls, src_dir, seen, result)
  <- result
;

-- Collect all cask names that have defs from an AST's decls
: collect_def_inits(decls = any) (( any ))
  let tag = "tag"
  let name_key = "name"
  let n = stdr.len(decls)
  let ?i = 0
  let ?cname = "init"
  let ?has_defs = false
  for (; i < n; i = i + 1)
    let d = decls[i]
    if d[tag] == "cask" { cname = d[name_key] ?? "init" }
    if d[tag] == "def" { has_defs = true }
  let ?r = []: [string => any]
  let ck = "cask"
  let dk = "has_defs"
  r[ck] = cname
  r[dk] = has_defs
  <- r
;

-- Search for external module bindings file ({name}_bindings.inc).
-- Checks env var YIS_<NAME>_BINDINGS first, then installed and dev paths.
: find_ext_module_bindings(mod_name = string) (( string ))
  if stdr.len(mod_name) == 0 { <- "" }
  -- Check env var first: YIS_<NAME>_BINDINGS
  let upper = str_to_upper(mod_name)
  let env_name = stdr.str_concat(stdr.str_concat("YIS_", upper), "_BINDINGS")
  let env_val = _env_value(env_name)
  if stdr.len(env_val) > 0 && file_exists(env_val) == 0 { <- env_val }
  -- Build the bindings filename: {name}_bindings.inc
  let bfile = stdr.str_concat(mod_name, "_bindings.inc")
  -- Installed paths: {datadir}/yis/{name}/{name}_bindings.inc
  let ?p = ""
  p = stdr.str_concat(stdr.str_concat("/opt/homebrew/share/yis/", mod_name), stdr.str_concat("/", bfile))
  if file_exists(p) == 0 { <- p }
  p = stdr.str_concat(stdr.str_concat("/usr/local/share/yis/", mod_name), stdr.str_concat("/", bfile))
  if file_exists(p) == 0 { <- p }
  p = stdr.str_concat(stdr.str_concat("/usr/share/yis/", mod_name), stdr.str_concat("/", bfile))
  if file_exists(p) == 0 { <- p }
  -- Dev paths: src/yis/{name}_bindings.inc, ../{name}/src/yis/{name}_bindings.inc
  p = stdr.str_concat("src/yis/", bfile)
  if file_exists(p) == 0 { <- p }
  p = stdr.str_concat("../src/yis/", bfile)
  if file_exists(p) == 0 { <- p }
  p = stdr.str_concat("../../src/yis/", bfile)
  if file_exists(p) == 0 { <- p }
  p = stdr.str_concat(stdr.str_concat("../", mod_name), stdr.str_concat("/src/yis/", bfile))
  if file_exists(p) == 0 { <- p }
  p = stdr.str_concat(stdr.str_concat("../../", mod_name), stdr.str_concat("/src/yis/", bfile))
  if file_exists(p) == 0 { <- p }
  -- Capitalized dir variants
  let cap_name = stdr.str_concat(str_to_upper(stdr.slice(mod_name, 0, 1)), stdr.slice(mod_name, 1, stdr.len(mod_name)))
  p = stdr.str_concat(stdr.str_concat("../", cap_name), stdr.str_concat("/src/yis/", bfile))
  if file_exists(p) == 0 { <- p }
  p = stdr.str_concat(stdr.str_concat("../../", cap_name), stdr.str_concat("/src/yis/", bfile))
  if file_exists(p) == 0 { <- p }
  p = stdr.str_concat(stdr.str_concat("../", cap_name), stdr.str_concat("/yis/", bfile))
  if file_exists(p) == 0 { <- p }
  p = stdr.str_concat(stdr.str_concat("../../", cap_name), stdr.str_concat("/yis/", bfile))
  if file_exists(p) == 0 { <- p }
  <- ""
;

: ext_module_native_owner(mod_name = string) (( string ))
  <- mod_name
;

-- Auto-detect C compiler include flags (-I...) for an external module.
-- Probes installed system paths, then dev-relative paths.
: detect_module_cflags(mod_name = string) (( string ))
  let ?native_mod = ext_module_native_owner(mod_name)
  if stdr.len(native_mod) == 0 { <- "" }
  let hfile = stdr.str_concat(native_mod, ".h")
  -- System installed: /opt/homebrew/include/{name}/{name}.h etc
  let sys_inc = ["/opt/homebrew/include", "/usr/local/include", "/usr/include"]
  let ?si = 0
  let sn = stdr.len(sys_inc)
  for (; si < sn; si = si + 1)
    let sd = sys_inc[si] ?? ""
    let p = stdr.str_concat(sd, stdr.str_concat("/", stdr.str_concat(native_mod, stdr.str_concat("/", hfile))))
    if stdr.file_exists(p) { <- stdr.str_concat("-I", stdr.str_concat(sd, stdr.str_concat("/", native_mod))) }
  -- Dev-relative paths: ../{name}/src/src, ../{name}/src
  let dev_paths = [
    stdr.str_concat("../", stdr.str_concat(native_mod, "/src/src")),
    stdr.str_concat("../", stdr.str_concat(native_mod, "/src")),
    stdr.str_concat("../../", stdr.str_concat(native_mod, "/src/src")),
    stdr.str_concat("../../", stdr.str_concat(native_mod, "/src"))
  ]
  let ?di = 0
  let dn = stdr.len(dev_paths)
  for (; di < dn; di = di + 1)
    let dp = dev_paths[di] ?? ""
    let p = stdr.str_concat(dp, stdr.str_concat("/", hfile))
    if stdr.file_exists(p) { <- stdr.str_concat("-I", dp) }
  <- ""
;

-- Auto-detect linker flags for an external module.
-- Probes installed system paths, then dev-relative build dirs.
: detect_module_ldflags(mod_name = string) (( string ))
  let ?native_mod = ext_module_native_owner(mod_name)
  if stdr.len(native_mod) == 0 { <- "" }
  let lib_name = stdr.str_concat("lib", stdr.str_concat(native_mod, ".dylib"))
  -- System installed
  let sys_dirs = ["/opt/homebrew/lib", "/usr/local/lib", "/usr/lib"]
  let ?si = 0
  let sn = stdr.len(sys_dirs)
  for (; si < sn; si = si + 1)
    let sd = sys_dirs[si] ?? ""
    let p = stdr.str_concat(sd, stdr.str_concat("/", lib_name))
    if stdr.file_exists(p)
      let ?flags = stdr.str_concat("-L", sd)
      flags = stdr.str_concat(flags, stdr.str_concat(" -l", native_mod))
      flags = stdr.str_concat(flags, stdr.str_concat(" -Wl,-rpath,", sd))
      flags = stdr.str_concat(flags, " -Wl,-rpath,@executable_path/../Frameworks")
      <- flags
  -- Dev-relative build dirs
  let dev_dirs = [
    stdr.str_concat("../", stdr.str_concat(native_mod, "/build")),
    stdr.str_concat("../", stdr.str_concat(native_mod, "/_build")),
    stdr.str_concat("../../", stdr.str_concat(native_mod, "/build")),
    stdr.str_concat("../../", stdr.str_concat(native_mod, "/_build"))
  ]
  let ?di = 0
  let dn = stdr.len(dev_dirs)
  for (; di < dn; di = di + 1)
    let dd = dev_dirs[di] ?? ""
    let p = stdr.str_concat(dd, stdr.str_concat("/", lib_name))
    if stdr.file_exists(p)
      let ?flags = stdr.str_concat("-L", dd)
      flags = stdr.str_concat(flags, stdr.str_concat(" -l", native_mod))
      flags = stdr.str_concat(flags, stdr.str_concat(" -Wl,-rpath,", dd))
      flags = stdr.str_concat(flags, " -Wl,-rpath,@executable_path/../Frameworks")
      <- flags
  -- Fallback: just -l{name}
  <- stdr.str_concat("-l", native_mod)
;

-- Main emit_c: walks the full AST, emits modules, then current unit, and wraps with runtime+main.
: emit_c(ast = any, runtime_src = string, src_dir = string, entry_path = string) (( string ))
  let tag = "tag"
  let name_key = "name"
  let decls_key = "decls"
  let decls = ast[decls_key]
  if stdr.is_null(decls) { <- "int main(void) { return 0; }\n" }

  g_next_lambda_id = 1
  g_def_init_modules = []: [any]
  g_src_dir = src_dir
  _reset_diag_demangle_context()
  _register_diag_file(entry_path)

  let ?p = []: [any]
  if stdr.len(runtime_src) > 0
    stdr.push(p, runtime_src)
    stdr.push(p, "\n")
  else
    stdr.push(p, "#include \"src/runtime.inc\"\n\n")
  stdr.push(p, "/* inlined runtime helpers */\n")
  stdr.push(p, "static YisVal yis_dict_member_get(YisVal obj, YisVal key) {\n")
  stdr.push(p, "  if (obj.tag != EVT_DICT) yis_trap(\"member access requires a dictionary or object\");\n")
  stdr.push(p, "  return yis_dict_get((YisDict*)obj.as.p, key);\n}\n\n")
  stdr.push(p, "static void yis_dict_member_set(YisVal obj, YisVal key, YisVal val) {\n")
  stdr.push(p, "  if (obj.tag != EVT_DICT) yis_trap(\"member assignment requires a dictionary or object\");\n")
  stdr.push(p, "  yis_dict_set((YisDict*)obj.as.p, key, val);\n}\n\n")
  stdr.push(p, "static YisVal yis_index(YisVal obj, YisVal idx) {\n")
  stdr.push(p, "  if (obj.tag == EVT_ARR) return yis_arr_get((YisArr*)obj.as.p, yis_as_int(idx));\n")
  stdr.push(p, "  if (obj.tag == EVT_DICT) return yis_dict_get((YisDict*)obj.as.p, idx);\n")
  stdr.push(p, "  if (obj.tag == EVT_STR) return stdr_str_at(obj, yis_as_int(idx));\n")
  stdr.push(p, "  return YV_NULLV;\n")
  stdr.push(p, "}\n\n")
  stdr.push(p, "static YisVal yis_index_set(YisVal obj, YisVal idx, YisVal val) {\n")
  stdr.push(p, "  if (obj.tag == EVT_ARR) { yis_arr_set((YisArr*)obj.as.p, yis_as_int(idx), val); return val; }\n")
  stdr.push(p, "  if (obj.tag == EVT_DICT) { yis_dict_set((YisDict*)obj.as.p, idx, val); return val; }\n")
  stdr.push(p, "  return YV_NULLV;\n")
  stdr.push(p, "}\n\n")
  -- Build class info for all brought modules (before emitting code)
  let ?n = 0
  n = stdr.len(decls)
  let ?i = 0
  let ?has_entry = false
  let ?ext_module_names = []: [any]
  let brings = collect_brings(decls, src_dir)
  let nb = stdr.len(brings)
  g_bring_names = []: [string => any]
  g_fun_origin = []: [string => any]
  let ?bi = 0
  for (; bi < nb; bi = bi + 1)
    let binfo = brings[bi]
    let bname = binfo[0] ?? ""
    let bdir = binfo[1] ?? ""
    -- Register last segment of dotted name as the namespace key
    let ?bring_key = bname
    let ?bk_i = 0
    let bk_n = stdr.len(bname)
    for (; bk_i < bk_n; bk_i = bk_i + 1)
      if stdr.slice(bname, bk_i, bk_i + 1) == "."
        bring_key = stdr.slice(bname, bk_i + 1, bk_n)
    _remember_demangle_module(bring_key)
    g_bring_names[bring_key] = true
    if is_external_module(bname)
      if !array_has_string(ext_module_names, bname)
        stdr.push(ext_module_names, bname)
    -- Parse and build class info for this module
    let mod_fpath = resolve_bring(bname, bdir)
    _register_diag_file(mod_fpath)
    let mod_ast3 = load_module(mod_fpath)
    if !stdr.is_null(mod_ast3)
      let mod_decls = mod_ast3[decls_key] ?? []: [any]
      -- Find module's cask name
      let ?mod_cask = bring_key
      let ?mi = 0
      let mdn = stdr.len(mod_decls)
      for (; mi < mdn; mi = mi + 1)
        let md2 = mod_decls[mi]
        if md2[tag] == "cask" { mod_cask = md2[name_key] ?? bring_key }
      _remember_demangle_module(mod_cask)
      build_class_info(mod_decls, mod_cask)
  -- Build class info for main unit too
  build_class_info(decls, "")

  -- Include external module bindings if needed
  let ?ext_bi = 0
  let ext_bn = stdr.len(ext_module_names)
  for (; ext_bi < ext_bn; ext_bi = ext_bi + 1)
    let ext_module_name = ext_module_names[ext_bi] ?? ""
    let bind_path = find_ext_module_bindings(ext_module_name)
    if stdr.len(bind_path) > 0
      let bind_src = stdr.read_text_file(bind_path)
      if !stdr.is_null(bind_src)
        stdr.push(p, "\n/* ")
        stdr.push(p, ext_module_name)
        stdr.push(p, " bindings */\n")
        stdr.push(p, bind_src)
        stdr.push(p, "\n")

  -- Embed all brought modules
  bi = 0
  for (; bi < nb; bi = bi + 1)
    let binfo = brings[bi]
    let bname = binfo[0] ?? ""
    let bdir = binfo[1] ?? ""
    stdr.push(p, emit_one_bring(bname, bdir))

  -- Check for entry/exit in main unit
  let ?has_exit = false
  for (; i < n; i = i + 1)
    let d = decls[i]
    if d[tag] == "fun"
      let fname = d[name_key] ?? ""
      if fname == "entry" { has_entry = true }
    if d[tag] == "exit" { has_exit = true }

  -- Build class info for main unit with actual cask name
  let ?main_cask = "init"
  i = 0
  for (; i < n; i = i + 1)
    let d = decls[i]
    if d[tag] == "cask" { main_cask = d[name_key] ?? "init" }
  _remember_demangle_module(main_cask)
  build_class_info(decls, main_cask)

  stdr.push(p, "\n/* begin main unit */\n")
  g_emit_file_path = entry_path
  g_last_line_num = 0
  stdr.push(p, emit_unit(ast))
  stdr.push(p, "/* end main unit */\n\n")

  -- Every emitted module is included, including transitive imports.
  let init_calls = g_def_init_modules

  stdr.push(p, "int main(int argc, char **argv) {\n")
  stdr.push(p, "  yis_set_args(argc, argv);\n")
  stdr.push(p, "  yis_runtime_init();\n")
  -- Call def init functions
  let ?ci = 0
  let cn = stdr.len(init_calls)
  for (; ci < cn; ci = ci + 1)
    let cname = init_calls[ci] ?? ""
    stdr.push(p, "  atexit(__yis_")
    stdr.push(p, cname)
    stdr.push(p, "_cleanup);\n")
    stdr.push(p, "  __yis_")
    stdr.push(p, cname)
    stdr.push(p, "_init();\n")
  if has_exit { stdr.push(p, "  atexit(yis_exit_fn);\n") }
  if has_entry { stdr.push(p, "  yis_entry();\n") }
  stdr.push(p, "  return 0;\n")
  stdr.push(p, "}\n")
  <- stdr.join(p)
;

-> ()
  let argv = stdr.args()
  let ?is_run_mode = false
  let ?run_arg_start = 0
  let usage = "Usage: yis file.yi | yis run file.yi [-- arguments...]\n"
  if stdr.len(argv) < 2
    stdr.write(usage)
    stdr.exit_process(1)
  let ?entry_path = argv[1] ?? ""
  if entry_path == "--help" || entry_path == "-h"
    stdr.write(usage)
    stdr.exit_process(0)
  if entry_path == "run"
    is_run_mode = true
    if stdr.len(argv) < 3
      stdr.write("ERR: Missing file path after 'run'\n")
      stdr.write(usage)
      stdr.exit_process(1)
    entry_path = argv[2] ?? ""
    run_arg_start = 3
    if stdr.len(argv) > 3
      let arg3 = argv[3] ?? ""
      if arg3 == "--"
        run_arg_start = 4
      else
        run_arg_start = 3
  if entry_path == ""
    stdr.write("ERR: No entry path\n")
    stdr.exit_process(1)
  if stdr.starts_with(entry_path, "-")
    stdr.write(stdr.str_concat("ERR: Unknown option: ", stdr.str_concat(entry_path, "\n")))
    stdr.write(usage)
    stdr.exit_process(1)
  if !is_run_mode && stdr.len(argv) > 2
    stdr.write("ERR: Unexpected arguments; use 'yis run' to pass program arguments\n")
    stdr.exit_process(1)
  let ep_len = stdr.len(entry_path)
  let ?is_self_host = false
  if ep_len >= 11
    let tail = stdr.slice(entry_path, ep_len - 11, ep_len)
    if tail == "src/init.yi" { is_self_host = true }

  let source_raw = stdr.read_text_file(entry_path)
  if stdr.is_null(source_raw)
    stdr.write(stdr.str_concat("ERR: Cannot read file: ", stdr.str_concat(entry_path, "\n")))
    stdr.exit_process(1)
  -- Preserve the supplied source directory for relative imports through symlinks.
  if !stdr.starts_with(entry_path, "/")
    entry_path = stdr.str_concat(stdr.str_concat(stdr.getcwd(), "/"), entry_path)

  let ?source = source_raw
  if !is_self_host
    source = strip_line_comments(source_raw)

  let toks = lexer.lex_with_escapes(source, should_decode_escapes(entry_path))
  let ast = parser.parse(toks)
  if stdr.is_null(ast)
    stdr.write("ERR: Parse failed\n")
    stdr.exit_process(1)
  let ?opt_ast = ast
  if !is_self_host && !is_run_mode
    opt_ast = optimize_program(ast)

  -- Discover native modules at every import depth so their flags and resources
  -- are handled even when the entry imports only an ordinary wrapper module.
  let src_dir = dir_of(entry_path)
  let all_brings = collect_brings(opt_ast["decls"] ?? []: [any], src_dir)
  let ?ext_mod_name = ""
  let ?ext_mod_dir = src_dir
  let ?ext_mod_names = []: [any]
  let ?uses_ext_module = false
  let decls_key2 = "decls"
  let ?di = 0
  let dn = stdr.len(all_brings)
  for (; di < dn; di = di + 1)
      let bname2 = all_brings[di][0] ?? ""
      if is_external_module(bname2)
        if !array_has_string(ext_mod_names, bname2)
          stdr.push(ext_mod_names, bname2)
          if stdr.len(ext_mod_name) == 0
            ext_mod_name = bname2
            ext_mod_dir = all_brings[di][1] ?? src_dir
          uses_ext_module = true

  let uname_res = stdr.run_command("uname")
  let ?uname_out = uname_res[1] ?? ""
  let ?is_macos = false
  let ?is_linux = false
  if stdr.len(uname_out) >= 6
    if stdr.slice(uname_out, 0, 6) == "Darwin" { is_macos = true }
  if stdr.len(uname_out) >= 5
    if stdr.slice(uname_out, 0, 5) == "Linux" { is_linux = true }

  let ?app_name = sanitize_filename_component(stem_name(entry_path))
  if stdr.len(app_name) == 0 { app_name = "main" }
  let ?macos_display_name = ""
  if uses_ext_module
    let appid_name = find_appid_name(opt_ast)
    if stdr.len(appid_name) > 0
      app_name = appid_name
    macos_display_name = extract_app_display_name(source_raw)

  let ?ext_module_path = ""
  let ?ext_packager_path = ""
  if uses_ext_module
    ext_module_path = resolve_bring(ext_mod_name, ext_mod_dir)
    ext_packager_path = find_ext_module_packager(ext_mod_name, ext_module_path)

  let ?cc_value = _env_value("CC")
  if stdr.len(cc_value) == 0 { cc_value = "cc" }
  let ?cc_words = []: [any]
  -- A real executable path containing spaces is also a valid CC value.
  if stdr.file_exists(cc_value)
    stdr.push(cc_words, cc_value)
  else
    cc_words = driver_words(cc_value, "CC")
  if stdr.len(cc_words) == 0 || stdr.len(cc_words[0] ?? "") == 0
    stdr.write("ERR: CC must name a C compiler\n")
    stdr.exit_process(1)
  let cc_executable = driver_resolve_executable(cc_words[0] ?? "")
  cc_words[0] = cc_executable
  let cc_command = driver_quote_words(cc_words)
  let extra_words = driver_words(_env_value("YIS_CC_FLAGS"), "YIS_CC_FLAGS")
  let extra_flags = driver_quote_words(extra_words)
  let ?cc_opt_flags = "-Os -std=c11 -pipe"
  if is_run_mode { cc_opt_flags = "-O1 -std=c11 -pipe" }
  let ?mod_cflags = ""
  let ?mod_ldflags = ""
  if uses_ext_module
    let ?emi = 0
    for (; emi < stdr.len(ext_mod_names); emi += 1)
      let one_mod_name = ext_mod_names[emi] ?? ""
      let upper_mod = str_to_upper(one_mod_name)
      let cflags_env = stdr.str_concat(stdr.str_concat("YIS_", upper_mod), "_CFLAGS")
      let flags_env = stdr.str_concat(stdr.str_concat("YIS_", upper_mod), "_FLAGS")
      let ?one_cflags = _env_value(cflags_env)
      let ?one_ldflags = _env_value(flags_env)
      if stdr.len(one_cflags) == 0 { one_cflags = detect_module_cflags(one_mod_name) }
      if stdr.len(one_ldflags) == 0 { one_ldflags = detect_module_ldflags(one_mod_name) }
      mod_cflags = stdr.str_concat(mod_cflags, " ")
      mod_cflags = stdr.str_concat(mod_cflags, driver_quote_words(driver_words(one_cflags, cflags_env)))
      mod_ldflags = stdr.str_concat(mod_ldflags, " ")
      mod_ldflags = stdr.str_concat(mod_ldflags, driver_quote_words(driver_words(one_ldflags, flags_env)))

  let ?out_path = app_name
  let ?output_dir = "."
  if is_self_host
    if is_run_mode { out_path = ".yi_run_out" }
    else { out_path = ".yi_out" }

  let ?bundle_dir = ""
  let ?macos_bundle_id = ""
  if uses_ext_module && is_macos
    bundle_dir = stdr.str_concat(app_name, ".app")
    if is_run_mode { bundle_dir = stdr.str_concat(stdr.str_concat(output_dir, "/"), bundle_dir) }
    out_path = stdr.str_concat(stdr.str_concat(bundle_dir, "/Contents/MacOS/"), app_name)
    if stdr.contains(app_name, ".") { macos_bundle_id = app_name }
    else { macos_bundle_id = stdr.str_concat("org.yi.", app_name) }

  -- Content fingerprints protect against backdated edits and changed import resolution.
  -- Parsing imports remains necessary to discover their current transitive dependency graph.
  let runtime_src = find_runtime_src(argv)
  if stdr.len(runtime_src) == 0
    stdr.write("ERR: Cannot find runtime.inc\n")
    stdr.exit_process(1)
  g_ast_cache[entry_path] = ast
  g_source_hashes[entry_path] = stdr.hash_text(source_raw)
  let ?stamp_parts = []: [any]
  stdr.push(stamp_parts, "yis-run-cache-v3\n")
  driver_cache_field(stamp_parts, "cwd", stdr.getcwd())
  driver_cache_field(stamp_parts, "entry", entry_path)
  let compiler_path = driver_resolve_executable(argv[0] ?? "")
  let compiler_content = stdr.read_text_file(compiler_path)
  let cc_content = stdr.read_text_file(cc_executable)
  driver_cache_field(stamp_parts, "compiler", compiler_path)
  driver_cache_field(stamp_parts, "compiler_content", stdr.hash_text(compiler_content ?? ""))
  driver_cache_field(stamp_parts, "cc", cc_command)
  driver_cache_field(stamp_parts, "cc_content", stdr.hash_text(cc_content ?? ""))
  driver_cache_field(stamp_parts, "cc_defaults", cc_opt_flags)
  driver_cache_field(stamp_parts, "cc_extra", extra_flags)
  driver_cache_field(stamp_parts, "module_cflags", mod_cflags)
  driver_cache_field(stamp_parts, "module_ldflags", mod_ldflags)
  driver_cache_field(stamp_parts, "runtime", stdr.hash_text(runtime_src))
  let ?seen_sources = []: [string => any]
  driver_dependency_stamp(entry_path, seen_sources, stamp_parts)
  let cache_stamp = stdr.join(stamp_parts)
  if is_run_mode && !is_self_host
    let cache_id = stdr.hash_text(cache_stamp)
    output_dir = stdr.str_concat(stdr.str_concat(driver_cache_directory(), "/"), cache_id)
    if !stdr.ensure_dir(output_dir)
      stdr.write("ERR: Cannot create program cache directory\n")
      stdr.exit_process(1)
    out_path = stdr.str_concat(stdr.str_concat(output_dir, "/"), app_name)
    if uses_ext_module && is_macos
      bundle_dir = stdr.str_concat(stdr.str_concat(output_dir, "/"), stdr.str_concat(app_name, ".app"))
      out_path = stdr.str_concat(stdr.str_concat(bundle_dir, "/Contents/MacOS/"), app_name)

  let manifest_path = stdr.str_concat(out_path, ".yis_manifest")
  let no_cache = _env_value("YIS_NO_CACHE")
  let keep_c = _env_value("YIS_KEEP_C") == "1"
  -- Native headers, shared libraries and packaged resources are not yet tracked.
  -- Rebuilding native-module apps is safer than reusing a possibly stale executable.
  let native_search_env = ["CPATH", "C_INCLUDE_PATH", "LIBRARY_PATH", "GCC_EXEC_PREFIX", "COMPILER_PATH"]
  let ?untracked_native_inputs = driver_has_native_inputs(extra_words) || stdr.len(cc_words) > 1
  let ?nsi = 0
  for (; nsi < stdr.len(native_search_env); nsi += 1)
    if stdr.len(_env_value(native_search_env[nsi] ?? "")) > 0 { untracked_native_inputs = true }
  let cache_enabled = (stdr.len(no_cache) == 0 || no_cache == "0") && !uses_ext_module && !keep_c && !untracked_native_inputs && !stdr.is_null(compiler_content) && !stdr.is_null(cc_content)
  let ?need_compile = true
  if is_run_mode && cache_enabled && stdr.file_exists(out_path)
    let previous_stamp = stdr.read_text_file(manifest_path)
    if !stdr.is_null(previous_stamp) && previous_stamp == cache_stamp { need_compile = false }

  let ?c_path = ""
  if need_compile
    if uses_ext_module && is_macos
      if !prepare_macos_app_bundle(out_path, macos_bundle_id, app_name, macos_display_name)
        stdr.write("ERR: failed to prepare macOS app bundle\n")
        stdr.exit_process(1)
    let c_src_str = stdr.str(emit_c(opt_ast, runtime_src, src_dir, entry_path))
    let c_temp = stdr.temp_file(output_dir, ".yis-c-")
    if stdr.is_null(c_temp)
      stdr.write("ERR: Cannot create temporary C output\n")
      stdr.exit_process(1)
    c_path = c_temp
    if !stdr.write_text_file(c_path, c_src_str)
      rm_file_quiet(c_path)
      stdr.write("ERR: Cannot write C output\n")
      stdr.exit_process(1)

    let ?compile_out_path = out_path
    if is_run_mode && !is_self_host
      let binary_temp = stdr.temp_file(dir_of(out_path), ".yis-bin-")
      if stdr.is_null(binary_temp)
        if !keep_c { rm_file_quiet(c_path) }
        stdr.write("ERR: Cannot create temporary executable output\n")
        stdr.exit_process(1)
      compile_out_path = binary_temp
    let ?cc_cmd = stdr.str_concat(cc_command, " -o ")
    cc_cmd = stdr.str_concat(cc_cmd, shell_quote_arg(compile_out_path))
    cc_cmd = stdr.str_concat(cc_cmd, " -x c ")
    cc_cmd = stdr.str_concat(cc_cmd, shell_quote_arg(c_path))
    cc_cmd = stdr.str_concat(cc_cmd, " -x none ")
    cc_cmd = stdr.str_concat(cc_cmd, cc_opt_flags)
    cc_cmd = stdr.str_concat(cc_cmd, " ")
    cc_cmd = stdr.str_concat(cc_cmd, extra_flags)
    cc_cmd = stdr.str_concat(cc_cmd, mod_cflags)
    cc_cmd = stdr.str_concat(cc_cmd, mod_ldflags)
    cc_cmd = stdr.str_concat(cc_cmd, " -lm ")

    let ?embed_resource_dir = ""
    if uses_ext_module && stdr.len(ext_packager_path) > 0
      if stdr.len(bundle_dir) > 0
        embed_resource_dir = stdr.str_concat(bundle_dir, "/Contents/Resources")
      else
        embed_resource_dir = output_dir
      let ?embed_cmd = "sh "
      embed_cmd = stdr.str_concat(embed_cmd, shell_quote_arg(ext_packager_path))
      embed_cmd = stdr.str_concat(embed_cmd, " --embed-resources ")
      embed_cmd = stdr.str_concat(embed_cmd, shell_quote_arg(entry_path))
      embed_cmd = stdr.str_concat(embed_cmd, " ")
      embed_cmd = stdr.str_concat(embed_cmd, shell_quote_arg(embed_resource_dir))
      embed_cmd = stdr.str_concat(embed_cmd, " 2>&1")
      stdr.run_command(embed_cmd)
      cc_cmd = stdr.str_concat(cc_cmd, " -I")
      cc_cmd = stdr.str_concat(cc_cmd, shell_quote_arg(embed_resource_dir))
    cc_cmd = stdr.str_concat(cc_cmd, " 2>&1")
    let result = stdr.run_command(cc_cmd)
    let code = result[0] ?? 1
    let out = result[1] ?? ""
    if !keep_c { rm_file_quiet(c_path) }
    if code != 0
      _translate_cc_output(out ?? "")
      if keep_c { stdr.write(stdr.str_concat("Generated C: ", stdr.str_concat(c_path, "\n"))) }
      rm_file_quiet(compile_out_path)
      stdr.exit_process(1)
    if compile_out_path != out_path
      if !stdr.move_file(compile_out_path, out_path)
        rm_file_quiet(compile_out_path)
        stdr.write("ERR: Cannot publish executable output\n")
        stdr.exit_process(1)
    if uses_ext_module && stdr.len(ext_packager_path) > 0
      if !run_ext_module_packager(ext_packager_path, entry_path, out_path, app_name)
        stdr.write("WARN: external module packager failed\n")
    if is_run_mode && cache_enabled
      driver_write_manifest(manifest_path, cache_stamp)

  if is_run_mode
    let executable_path = driver_absolute_path(out_path)
    let ?run_cmd = shell_quote_arg(executable_path)

    let ?ri = run_arg_start
    let rn = stdr.len(argv)
    for (; ri < rn; ri = ri + 1)
      let a = argv[ri] ?? ""
      run_cmd = stdr.str_concat(run_cmd, " ")
      run_cmd = stdr.str_concat(run_cmd, shell_quote_arg(a))

    let run_dir = dir_of(entry_path)
    if stdr.len(run_dir) > 0
      let ?pref = stdr.str_concat("cd ", shell_quote_arg(run_dir))
      pref = stdr.str_concat(pref, " && ")
      run_cmd = stdr.str_concat(pref, run_cmd)
    run_cmd = stdr.str_concat(run_cmd, " 2>&1")

    let run_res = stdr.run_command(run_cmd)
    let run_code = run_res[0] ?? 1
    let run_out = run_res[1] ?? ""
    if stdr.len(run_out) > 0
      stdr.write(run_out ?? "")
    stdr.exit_process(run_code)
;
