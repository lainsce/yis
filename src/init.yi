cask init

-- Yis self-hosted compiler (driver): read .yi path from args, lex, parse, emit C from AST, run cc.
bring stdr
bring lexer
bring parser

-- Global type/class tracking state (populated during bring processing)
def ?g_classes = []: [string => any]
def ?g_fun_rets = []: [string => any]
def ?g_fun_voids = []: [string => any]
def ?g_var_types = []: [string => any]
def ?g_cur_class = ""
def ?g_cur_mod = ""
def ?g_mod_funs = []: [string => any]
def ?g_all_funs = []: [string => any]
def ?g_interfaces = []: [string => any]
-- Module cache: resolved paths and parsed ASTs (avoid re-reading/re-parsing)
def ?g_path_cache = []: [string => any]
def ?g_ast_cache = []: [string => any]
def ?g_source_hashes = []: [string => any]
def ?g_env_cache = []: [string => any]
def ?g_scope_names = []: [string => any]
def ?g_scope_order = []: [any]
def ?g_owned_names = []: [string => any]
def ?g_global_def_names = []: [string => any]
def ?g_def_types = []: [string => any]
def ?g_bring_names = []: [string => any]
def ?g_fun_origin = []: [string => any]
def ?g_lambda_meta = []: [string => any]
def ?g_lambda_ids = []: [any]
def ?g_next_lambda_id = 1
def ?g_tmp_counter = 0
def ?g_src_dir = ""
def ?g_emit_file_path = ""
def ?g_last_line_num = 0
def ?g_demangle_mods = []: [string => any]
def ?g_demangle_mod_list = []: [any]
def ?g_diag_file_map = []: [string => any]
def ?g_diag_source_cache = []: [string => any]
def ?g_flat_names = []: [any]
def ?g_flat_exprs = []: [any]
def ?g_flat_counter = 0
def ?g_def_init_modules = []: [any]

-- ============================================================
-- C code emitter: walks AST and produces C using the Yis runtime.
-- All values are YisVal. Uses stdr_* / yis_* runtime functions.
-- ============================================================

-- Track the cask name for name-mangling.
: mangle_name(cask_name = string, fun_name = string) (( string ))
  if stdr.len(cask_name) == 0 { <- fun_name }
  let ?r = "yis_"
  r = stdr.str_concat(r, cask_name)
  r = stdr.str_concat(r, "_")
  r = stdr.str_concat(r, fun_name)
  <- r
;

-- Mangle a module-level def variable name: v_<cask>_<name>
: mangle_def(cask_name = string, def_name = string) (( string ))
  let ?r = "v_"
  if stdr.len(cask_name) > 0
    r = stdr.str_concat(r, cask_name)
    r = stdr.str_concat(r, "_")
  r = stdr.str_concat(r, def_name)
  <- r
;

-- Mangle a class method name: yis_m_<mod>_<class>_<method>
: mangle_method(mod_name = string, class_name = string, method_name = string) (( string ))
  -- Defensive: tolerate null/empty parts to avoid crashes when upstream names are missing
  let ?m0 = stdr.str(mod_name)
  if stdr.is_null(m0) { m0 = "" }
  let ?m1 = stdr.str(class_name)
  if stdr.is_null(m1) { m1 = "" }
  let ?m2 = stdr.str(method_name)
  if stdr.is_null(m2) { m2 = "" }

  let ?r = "yis_m_"
  r = stdr.str_concat(r, m0)
  r = stdr.str_concat(r, "_")
  r = stdr.str_concat(r, m1)
  r = stdr.str_concat(r, "_")
  r = stdr.str_concat(r, m2)
  <- r
;

: dict_get_or(d = any, k = any, fallback = any) (( any ))
  if stdr.is_null(d) { <- fallback }
  let v = d[k ?? ""]
  if stdr.is_null(v) { <- fallback }
  <- v
;

: pair(a = any, b = any) (( any ))
  let ?p = []: [any]
  p[0] = a
  p[1] = b
  <- p
;

: array_has_string(arr = any, value = string) (( bool ))
  let ?i = 0
  let n = stdr.len(arr)
  for (; i < n; i = i + 1)
    if stdr.str(arr[i] ?? "") == value
      <- true
  <- false
;

: unescape_interp_expr(text = string) (( string ))
  let ?out = ""
  let ?i = 0
  let n = stdr.len(text)
  for (; i < n; i = i + 1)
    let c = stdr.slice(text, i, i + 1)
    if c == "\\" && i + 1 < n
      out = stdr.str_concat(out, stdr.slice(text, i + 1, i + 2))
      i = i + 1
      continue
    out = stdr.str_concat(out, c)
  <- out
;

: _is_ident_start_char(ch = string) (( bool ))
  let c = stdr.char_code(ch)
  <- (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
;

: _is_ident_mid_char(ch = string) (( bool ))
  let c = stdr.char_code(ch)
  <- _is_ident_start_char(ch) || (c >= 48 && c <= 57)
;

: _is_int_text(text = string) (( bool ))
  let n = stdr.len(text)
  if n == 0 { <- false }
  let ?i = 0
  if stdr.slice(text, 0, 1) == "-"
    if n == 1 { <- false }
    i = 1
  for (; i < n; i = i + 1)
    let c = stdr.char_code(stdr.slice(text, i, i + 1))
    if c < 48 || c > 57 { <- false }
  <- true
;

: _hex_val(c = string) (( num ))
  let code = stdr.char_code(c)
  if code >= 48 && code <= 57 { <- code - 48 }
  if code >= 97 && code <= 102 { <- 10 + (code - 97) }
  if code >= 65 && code <= 70 { <- 10 + (code - 65) }
  <- -1
;

: _utf8_hex_escape(codepoint = num, hex = string) (( string ))
  -- Encode a Unicode codepoint as C hex escape bytes (\xNN\xNN...)
  let ?parts = []: [any]
  if codepoint <= 127
    let hi = codepoint / 16
    let lo = codepoint - hi * 16
    let ?hx = "\\x"
    hx = stdr.str_concat(hx, stdr.slice(hex, hi, hi + 1))
    hx = stdr.str_concat(hx, stdr.slice(hex, lo, lo + 1))
    <- hx
  -- Multi-byte UTF-8
  let ?bytes = []: [any]
  if codepoint <= 2047
    stdr.push(bytes, 192 + (codepoint / 64))
    stdr.push(bytes, 128 + (codepoint - (codepoint / 64) * 64))
  elif codepoint <= 65535
    let b0 = codepoint / 4096
    let rem1 = codepoint - b0 * 4096
    let b1 = rem1 / 64
    let b2 = rem1 - b1 * 64
    stdr.push(bytes, 224 + b0)
    stdr.push(bytes, 128 + b1)
    stdr.push(bytes, 128 + b2)
  elif codepoint <= 1114111
    let b0 = codepoint / 262144
    let rem1 = codepoint - b0 * 262144
    let b1 = rem1 / 4096
    let rem2 = rem1 - b1 * 4096
    let b2 = rem2 / 64
    let b3 = rem2 - b2 * 64
    stdr.push(bytes, 240 + b0)
    stdr.push(bytes, 128 + b1)
    stdr.push(bytes, 128 + b2)
    stdr.push(bytes, 128 + b3)
  else
    <- "?"
  let ?result = ""
  let ?bi = 0
  for (; bi < stdr.len(bytes); bi = bi + 1)
    let bv = bytes[bi] ?? 0
    let hi = bv / 16
    let lo = bv - hi * 16
    let ?hx = "\\x"
    hx = stdr.str_concat(hx, stdr.slice(hex, hi, hi + 1))
    hx = stdr.str_concat(hx, stdr.slice(hex, lo, lo + 1))
    result = stdr.str_concat(result, hx)
  <- result
;

: _c_quote(text = string) (( string ))
  let octal = "01234567"
  let ?parts = []: [any]
  stdr.push(parts, "\"")
  let n = stdr.len(text)
  let ?chunk_start = 0
  let ?i = 0
  for (; i < n; i = i + 1)
    let code = stdr.char_code(stdr.slice(text, i, i + 1))
    let ?esc = ""
    if code == 10 { esc = "\\n" }
    elif code == 9 { esc = "\\t" }
    elif code == 13 { esc = "\\r" }
    elif code == 7 { esc = "\\a" }
    elif code == 8 { esc = "\\b" }
    elif code == 11 { esc = "\\v" }
    elif code == 12 { esc = "\\f" }
    elif code < 32 || code == 127
      -- C octal escapes have a fixed maximum width; following digits stay literal.
      let high = code / 64
      let middle = code / 8 - high * 8
      let low = code - (code / 8) * 8
      esc = stdr.str_concat("\\", stdr.slice(octal, high, high + 1))
      esc = stdr.str_concat(esc, stdr.slice(octal, middle, middle + 1))
      esc = stdr.str_concat(esc, stdr.slice(octal, low, low + 1))
    elif code == 92 || code == 34
      if chunk_start < i { stdr.push(parts, stdr.slice(text, chunk_start, i)) }
      stdr.push(parts, "\\")
      chunk_start = i
      continue
    if stdr.len(esc) > 0
      if chunk_start < i { stdr.push(parts, stdr.slice(text, chunk_start, i)) }
      stdr.push(parts, esc)
      chunk_start = i + 1
  if chunk_start < n { stdr.push(parts, stdr.slice(text, chunk_start, n)) }
  stdr.push(parts, "\"")
  <- stdr.join(parts)
;

: _basename(path = string) (( string ))
  let p = stdr.str(path)
  let n = stdr.len(p)
  let ?i = n - 1
  for (; i >= 0; i = i - 1)
    let ch = stdr.slice(p, i, i + 1)
    if ch == "/" || ch == "\\"
      <- stdr.slice(p, i + 1, n)
  <- p
;

: _reset_diag_demangle_context() (( -- ))
  g_demangle_mods = []: [string => any]
  g_demangle_mod_list = []: [any]
  g_diag_file_map = []: [string => any]
  g_diag_source_cache = []: [string => any]
;

: _diag_source_text(path = string) (( string ))
  let key = stdr.str(path)
  let cached = g_diag_source_cache[key]
  if !stdr.is_null(cached)
    <- stdr.str(cached)
  let raw = stdr.read_text_file(key)
  if stdr.is_null(raw) { <- "" }
  let text = stdr.str(raw)
  g_diag_source_cache[key] = text
  <- text
;

: _remember_demangle_module(mod = string) (( -- ))
  let m = stdr.trim(stdr.str(mod))
  if stdr.len(m) == 0 { <- }
  if stdr.is_null(g_demangle_mods[m])
    g_demangle_mods[m] = true
    stdr.push(g_demangle_mod_list, m)
;

: _register_diag_file(path = string) (( -- ))
  if stdr.is_null(path) { <- }
  let p = stdr.trim(stdr.str(path))
  if stdr.len(p) == 0 { <- }
  let b = _basename(p)
  if stdr.len(b) > 0
    g_diag_file_map[b] = p
;

: _resolve_diag_file(fname = string) (( string ))
  let p = g_diag_file_map[fname]
  if stdr.is_null(p) { <- fname }
  <- stdr.str(p)
;

: _best_demangle_split(rest = string) (( any ))
  let ?best_mod = ""
  let ?best_tail = ""
  let ?best_len = -1
  let ?i = 0
  let n = stdr.len(g_demangle_mod_list)
  for (; i < n; i = i + 1)
    let mod = g_demangle_mod_list[i] ?? ""
    let ml = stdr.len(mod)
    if ml == 0 { continue }
    let pref = stdr.str_concat(mod, "_")
    if stdr.starts_with(rest, pref) && ml > best_len
      best_len = ml
      best_mod = mod
      best_tail = stdr.slice(rest, ml + 1, stdr.len(rest))
  if best_len >= 0
    <- pair(best_mod, best_tail)
  <- null
;

: _source_line_at(path = string, line_no = num) (( string ))
  if line_no <= 0 { <- "" }
  let text = _diag_source_text(path)
  if stdr.len(text) == 0 { <- "" }
  let n = stdr.len(text)
  let ?cur_line = 1
  let ?start = 0
  let ?i = 0
  for (; i <= n; i = i + 1)
    if i == n || stdr.slice(text, i, i + 1) == "\n"
      if cur_line == line_no
        let ?line = stdr.slice(text, start, i)
        let ln = stdr.len(line)
        if ln > 0 && stdr.slice(line, ln - 1, ln) == "\r"
          line = stdr.slice(line, 0, ln - 1)
        <- line
      cur_line = cur_line + 1
      start = i + 1
  <- ""
;

: _is_code_line_text(line = string) (( bool ))
  let t = stdr.trim(line)
  if stdr.len(t) == 0 { <- false }
  if stdr.starts_with(t, "--") { <- false }
  if t == ";" { <- false }
  <- true
;

: _nearest_code_line_in_file(path = string, target = num) (( num ))
  let ?want = target
  if want <= 0
    want = 1

  let text = _diag_source_text(path)
  if stdr.len(text) == 0 { <- want }
  let n = stdr.len(text)
  let ?cur_line = 1
  let ?start = 0
  let ?i = 0
  let ?max_line = 1
  let ?best_after = 0
  let ?best_before = 0

  for (; i <= n; i = i + 1)
    if i == n || stdr.slice(text, i, i + 1) == "\n"
      let ?line = stdr.slice(text, start, i)
      let ln = stdr.len(line)
      if ln > 0 && stdr.slice(line, ln - 1, ln) == "\r"
        line = stdr.slice(line, 0, ln - 1)

      if _is_code_line_text(line)
        if cur_line >= want && best_after == 0
          best_after = cur_line
        if cur_line <= want
          best_before = cur_line

      max_line = cur_line
      cur_line = cur_line + 1
      start = i + 1

  if best_after > 0 { <- best_after }
  if best_before > 0 { <- best_before }
  if want > max_line { <- max_line }
  <- want
;

: _declaration_loc_for_symbol(fname = string, symbol = string) (( string ))
  if stdr.len(fname) == 0 || stdr.len(symbol) == 0 { <- "" }
  let full_path = _resolve_diag_file(fname)
  let text = _diag_source_text(full_path)
  if stdr.len(text) == 0 { <- "" }
  let n = stdr.len(text)
  let ?line_no = 1
  let ?start = 0
  let ?i = 0
  let ?first = 0
  let ?second = 0

  for (; i <= n; i = i + 1)
    if i == n || stdr.slice(text, i, i + 1) == "\n"
      let ?line = stdr.slice(text, start, i)
      let ln = stdr.len(line)
      if ln > 0 && stdr.slice(line, ln - 1, ln) == "\r"
        line = stdr.slice(line, 0, ln - 1)
      let t = stdr.trim(line)
      if _is_code_line_text(t) && stdr.contains(t, symbol)
        if stdr.starts_with(t, "def ") ||
           stdr.starts_with(t, "let ") ||
           stdr.starts_with(t, "pub ")
          if first == 0
            first = line_no
          elif second == 0
            second = line_no
            break
      line_no = line_no + 1
      start = i + 1

  let ?chosen = second
  if chosen == 0 { chosen = first }
  if chosen <= 0 { <- "" }

  let ?loc = fname
  loc = stdr.str_concat(loc, ":")
  loc = stdr.str_concat(loc, stdr.str(chosen))
  loc = stdr.str_concat(loc, ":1")
  <- loc
;

: _refine_redefinition_loc(loc = string, symbol = string) (( string ))
  if stdr.len(loc) == 0 || stdr.len(symbol) == 0 { <- loc }
  let c1 = stdr.index_of(loc, ":")
  if c1 < 0 { <- loc }
  let fname = stdr.slice(loc, 0, c1)
  let rest = stdr.slice(loc, c1 + 1, stdr.len(loc))
  let c2 = stdr.index_of(rest, ":")
  let ?line_txt = rest
  if c2 >= 0
    line_txt = stdr.slice(rest, 0, c2)
  let line_no = stdr.num(line_txt)
  if line_no > 0
    let cur = _source_line_at(_resolve_diag_file(fname), line_no)
    if _is_code_line_text(cur) && stdr.contains(cur, symbol)
      <- _normalize_loc_to_code_line(loc)

  let decl_loc = _declaration_loc_for_symbol(fname, symbol)
  if stdr.len(decl_loc) > 0
    <- decl_loc
  <- _normalize_loc_to_code_line(loc)
;

: _normalize_loc_to_code_line(loc = string) (( string ))
  if stdr.len(loc) == 0 { <- "" }
  let c1 = stdr.index_of(loc, ":")
  if c1 < 0 { <- loc }
  let fname = stdr.slice(loc, 0, c1)
  let rest = stdr.slice(loc, c1 + 1, stdr.len(loc))
  let c2 = stdr.index_of(rest, ":")
  let ?line_txt = rest
  let ?col_txt = ""
  if c2 >= 0
    line_txt = stdr.slice(rest, 0, c2)
    col_txt = stdr.slice(rest, c2 + 1, stdr.len(rest))
  let line_no = stdr.num(line_txt)
  if line_no <= 0 { <- loc }

  let full_path = _resolve_diag_file(fname)
  let cur = _source_line_at(full_path, line_no)
  -- If the mapped line does not exist, preserve original location.
  if stdr.len(cur) == 0 { <- loc }
  if _is_code_line_text(cur)
    <- loc

  let best = _nearest_code_line_in_file(full_path, line_no)

  let ?out = fname
  out = stdr.str_concat(out, ":")
  out = stdr.str_concat(out, stdr.str(best))
  if stdr.len(col_txt) > 0
    out = stdr.str_concat(out, ":")
    out = stdr.str_concat(out, col_txt)
  <- out
;

: _source_line_from_loc(loc = string) (( string ))
  let norm = _normalize_loc_to_code_line(loc)
  if stdr.len(norm) == 0 { <- "" }
  let c1 = stdr.index_of(norm, ":")
  if c1 < 0 { <- "" }
  let fname = stdr.slice(norm, 0, c1)
  let rest = stdr.slice(norm, c1 + 1, stdr.len(norm))
  let c2 = stdr.index_of(rest, ":")
  let ?line_txt = rest
  if c2 >= 0
    line_txt = stdr.slice(rest, 0, c2)
  let line_no = stdr.num(line_txt)
  if line_no <= 0 { <- "" }
  let full_path = _resolve_diag_file(fname)
  <- _source_line_at(full_path, line_no)
;

: _hint_for_translated_error(msg = string) (( string ))
  if stdr.contains(msg, "no such function or method")
    <- "Yis cannot find this function name. Check spelling, make sure the module is imported, and call it as module.name(...)."
  if stdr.contains(msg, "undeclared identifier")
    <- "This name was never defined before use. Declare it first, or fix the spelling to match an existing variable."
  if stdr.contains(msg, "expects") && stdr.contains(msg, "argument(s)")
    <- "This call has the wrong number of values inside parentheses. Count what you passed, then match that count to the function definition."
  if stdr.contains(msg, "too few arguments") || stdr.contains(msg, "too many arguments")
    <- "This function call has too many or too few values in parentheses. Compare the call with the function definition and make them match."
  if stdr.contains(msg, "redefinition of")
    <- "This name is already used earlier in the same block. Rename one of them or delete the duplicate definition."
  if stdr.contains(msg, "no member named")
    <- "You are accessing a field or method that does not exist on this value. Check the value's type and the member name."
  if stdr.contains(msg, "called object type") || stdr.contains(msg, "is not a function")
    <- "This value is not callable. Make sure you are calling a function, not a plain value like text, number, or object."
  if stdr.contains(msg, "array subscript is not an integer")
    <- "Array indexes must be whole numbers like 0, 1, 2. Convert the index to an integer before indexing."
  if stdr.contains(msg, "subscripted value is not an array") || stdr.contains(msg, "subscripted value is not")
    <- "Only arrays and dictionaries can be indexed with [ ]. Check that the value on the left side is the right kind."
  if stdr.contains(msg, "expected expression")
    <- "Something is missing in this statement, such as a value or function call. Check this line for incomplete code."
  if stdr.contains(msg, "expected ';'")
    <- "A statement separator is missing before this point in generated C output. Check the Yis code around this line for malformed expressions."
  if stdr.contains(msg, "expected ')'")
    <- "A closing parenthesis is missing. Count opening and closing parentheses and add the missing one."
  if stdr.contains(msg, "expected '")
    <- "A required token is missing here (for example a bracket, parenthesis, or separator). Check nearby punctuation carefully."
  if stdr.contains(msg, "closure") && stdr.contains(msg, "does not return")
    <- "One code path does not return a value. Add a return in every if/else path, or make this function return nothing with (( -- ))."
  if stdr.contains(msg, "should return a value") || stdr.contains(msg, "non-void function")
    <- "This function says it returns a value, but one path returns nothing. Add a return value on every path."
  if stdr.contains(msg, "type mismatch") || stdr.contains(msg, "incompatible")
    <- "Two values here are different kinds (for example text vs number). Convert one value to match the other, and if null is possible, give a fallback first."
  if stdr.contains(msg, "Undefined symbols for architecture") || stdr.contains(msg, "undefined symbol")
    <- "A required function or global value was referenced but not found. Check function names and ensure the defining module/library is included."
  if stdr.contains(msg, "library not found") || stdr.contains(msg, "framework not found")
    <- "A required native library/framework is missing from link flags or system paths. Install it and add the correct linker flags."
  if stdr.contains(msg, "linker command failed")
    <- "Linking failed after compilation. Read the lines above this error for missing symbols or libraries, then fix the first missing item."
  <- "Fix this first error, then run again. Later errors are often side effects of the first one."
;

: _write_err_details(loc = string, msg = string) (( -- ))
  let src_line = _source_line_from_loc(loc)
  if stdr.len(src_line) > 0
    stdr.write("       line: ")
    stdr.write(src_line)
    stdr.write("\n")
  let hint = _hint_for_translated_error(msg)
  if stdr.len(hint) > 0
    stdr.write("       hint: ")
    stdr.write(hint)
    stdr.write("\n")
;

: _find_nearby_yi_location(lines = any, idx = num, nlines = num) (( string ))
  let ?from = idx - 2
  if from < 0 { from = 0 }
  let ?to = idx + 8
  if to > nlines { to = nlines }
  let ?k = from
  for (; k < to; k = k + 1)
    let line = lines[k] ?? ""
    let ?mark = stdr.index_of(line, ": error: ")
    if mark < 0
      mark = stdr.index_of(line, ": note: ")
    if mark < 0 { continue }
    let loc = _extract_yi_location(line, mark)
    if stdr.len(loc) > 0
      let norm = _normalize_loc_to_code_line(loc)
      if stdr.len(norm) > 0 { <- norm }
  <- ""
;

-- ============================================================
-- C compiler error translation: demangle C names → Yis names
-- ============================================================

: _is_upper_char(ch = string) (( bool ))
  let c = stdr.char_code(ch)
  <- c >= 65 && c <= 90
;

-- Extract text between first pair of single-quote characters
: _extract_single_quoted(text = string) (( string ))
  let q1 = stdr.index_of(text, "'")
  if q1 < 0 { <- "" }
  let rest = stdr.slice(text, q1 + 1, stdr.len(text))
  let q2 = stdr.index_of(rest, "'")
  if q2 < 0 { <- "" }
  <- stdr.slice(rest, 0, q2)
;

-- Strip trailing __N suffix (codegen local variable numbering).
: _strip_local_suffix(name = string) (( string ))
  let n = stdr.len(name)
  if n < 3 { <- name }
  let ?i = n - 1
  for (; i >= 2; i -= 1)
    if stdr.slice(name, i - 2, i) == "__"
      let ?all_digits = true
      let ?j = i
      for (; j < n; j += 1)
        let c = stdr.char_code(stdr.slice(name, j, j + 1))
        if c < 48 || c > 57 { all_digits = false }
      if all_digits && i < n
        <- stdr.slice(name, 0, i - 2)
      <- name
  <- name
;

-- Demangle a C function name back to a Yis-readable form.
-- Local variables: v_foo or foo__N           → foo
-- Methods:         yis_m_<mod>_<Class>_<meth> → Class.method()
-- Globals:         yis_g_<mod>_<name>         → <name>
-- Functions:       yis_<mod>_<name>           → <mod>.<name>() (module-aware split)
: _demangle_c_name(name = string) (( string ))
  if stdr.starts_with(name, "v_")
    <- _strip_local_suffix(stdr.slice(name, 2, stdr.len(name)))

  let stripped = _strip_local_suffix(name)
  if stdr.len(stripped) < stdr.len(name)
    <- stripped

  -- Method: yis_m_<mod>_<Class>_<method>
  if stdr.starts_with(name, "yis_m_")
    let rest = stdr.slice(name, 6, stdr.len(name))
    let n = stdr.len(rest)
    let ?cls_start = -1
    let ?i = 0
    for (; i < n; i = i + 1)
      let ch = stdr.slice(rest, i, i + 1)
      if _is_upper_char(ch) && (i == 0 || stdr.slice(rest, i - 1, i) == "_")
        cls_start = i
        break
    if cls_start < 0 { <- name }
    let ?cls_end = n
    i = cls_start + 1
    for (; i < n; i = i + 1)
      if stdr.slice(rest, i, i + 1) == "_"
        cls_end = i
        break
    let cls = stdr.slice(rest, cls_start, cls_end)
    if cls_end >= n
      <- cls
    let method = stdr.slice(rest, cls_end + 1, n)
    let ?r = cls
    r = stdr.str_concat(r, ".")
    r = stdr.str_concat(r, method)
    r = stdr.str_concat(r, "()")
    <- r

  if stdr.starts_with(name, "yis_g_")
    let rest = stdr.slice(name, 6, stdr.len(name))
    let split = _best_demangle_split(rest)
    if !stdr.is_null(split)
      let vname = split[1] ?? ""
      if stdr.len(vname) > 0 { <- vname }
    <- rest

  if stdr.starts_with(name, "yis_")
    let rest = stdr.slice(name, 4, stdr.len(name))
    let split = _best_demangle_split(rest)
    if !stdr.is_null(split)
      let mod = split[0] ?? ""
      let fun = split[1] ?? ""
      if stdr.len(mod) > 0 && stdr.len(fun) > 0
        let ?r = mod
        r = stdr.str_concat(r, ".")
        r = stdr.str_concat(r, fun)
        r = stdr.str_concat(r, "()")
        <- r
    -- If the module split is ambiguous, keep underscores intact.
    <- stdr.str_concat(rest, "()")

  <- name
;

: _demangle_error_message(msg = string) (( string ))
  let ?out = ""
  let n = stdr.len(msg)
  let ?i = 0
  for (; i < n; i += 1)
    let ch = stdr.slice(msg, i, i + 1)
    if ch == "'"
      let ?j = i + 1
      for (; j < n; j += 1)
        if stdr.slice(msg, j, j + 1) == "'" { break }
      if j < n && j > i + 1
        let cname = stdr.slice(msg, i + 1, j)
        if stdr.starts_with(cname, "v_") || stdr.starts_with(cname, "yis_") || stdr.index_of(cname, "__") >= 0
          out = stdr.str_concat(out, "'")
          out = stdr.str_concat(out, _demangle_c_name(cname))
          out = stdr.str_concat(out, "'")
          i = j
          continue
    out = stdr.str_concat(out, ch)
  <- out
;

-- Extract expected/have counts from "expected N, have M" error text.
-- Returns [expected, have] adjusted for methods (subtracts 1 for self).
: _extract_arg_counts(msg = string, fname = string) (( any ))
  let ei = stdr.index_of(msg, "expected ")
  let hi = stdr.index_of(msg, "have ")
  if ei < 0 || hi < 0 { <- null }

  let after_exp = stdr.slice(msg, ei + 9, stdr.len(msg))
  let comma = stdr.index_of(after_exp, ",")
  if comma < 0 { <- null }
  let expected_s = stdr.slice(after_exp, 0, comma)

  let after_have = stdr.slice(msg, hi + 5, stdr.len(msg))
  let ?hlen = 0
  for (; hlen < stdr.len(after_have); hlen = hlen + 1)
    let c = stdr.char_code(stdr.slice(after_have, hlen, hlen + 1))
    if c < 48 || c > 57 { break }
  let have_s = stdr.slice(after_have, 0, hlen)
  let ?expected = stdr.num(expected_s)
  let ?have = stdr.num(have_s)

  -- Methods have an implicit self parameter; subtract it for Yis-level counts
  if stdr.starts_with(fname, "yis_m_")
    expected = expected - 1
    have = have - 1
  <- pair(expected, have)
;

-- Translate raw C compiler output into Yis-friendly error messages.
-- Extract "file.yi:LINE" location prefix from a C compiler error line.
-- Input line format: "/path/to/file.yi:6:12: error: ..."
-- Returns short location like "file.yi:6:12" or "" if not a .yi source.
: _extract_yi_location(line = string, err_idx = num) (( string ))
  let prefix = stdr.slice(line, 0, err_idx)
  -- prefix is like "/path/to/file.yi:6:12"
  -- Find last colon (column), then second-to-last (line number)
  let ?last_colon = -1
  let ?second_colon = -1
  let ?ci = stdr.len(prefix) - 1
  for (; ci >= 0; ci = ci - 1)
    if stdr.slice(prefix, ci, ci + 1) == ":"
      if last_colon < 0
        last_colon = ci
      elif second_colon < 0
        second_colon = ci
        break
  if second_colon < 0 { <- "" }
  let fpath = stdr.slice(prefix, 0, second_colon)
  let line_num = stdr.slice(prefix, second_colon + 1, last_colon)
  let col_num = stdr.slice(prefix, last_colon + 1, stdr.len(prefix))
  -- Only show .yi files, not .c files
  if !stdr.ends_with(fpath, ".yi") { <- "" }
  -- Extract just the filename from the path
  let ?fi = stdr.len(fpath) - 1
  for (; fi >= 0; fi = fi - 1)
    if stdr.slice(fpath, fi, fi + 1) == "/" { break }
  let fname = stdr.slice(fpath, fi + 1, stdr.len(fpath))
  let ?loc = fname
  loc = stdr.str_concat(loc, ":")
  loc = stdr.str_concat(loc, line_num)
  if stdr.len(col_num) > 0
    loc = stdr.str_concat(loc, ":")
    loc = stdr.str_concat(loc, col_num)
  <- loc
;

-- Write error prefix: "  ERR: [file.yi:N]: " or "  ERR: "
: _write_err_prefix(loc = string) (( -- ))
  if stdr.len(loc) > 0
    stdr.write("  ERR: [")
    stdr.write(loc)
    stdr.write("]: ")
  else
    stdr.write("  ERR: ")
;

: _translate_cc_output(output = string) (( -- ))
  -- Split output into lines
  let ?lines = []: [any]
  let ?line_start = 0
  let ?i = 0
  let n = stdr.len(output)
  for (; i <= n; i = i + 1)
    if i == n || stdr.slice(output, i, i + 1) == "\n"
      stdr.push(lines, stdr.slice(output, line_start, i))
      line_start = i + 1

  let nlines = stdr.len(lines)
  let ?j = 0
  let ?err_count = 0
  let ?seen = []: [string => any]

  for (; j < nlines; j = j + 1)
    let line = lines[j] ?? ""
    -- Skip warning lines (artifacts of generated C code)
    if stdr.contains(line, ": warning: ") { continue }
    let err_idx = stdr.index_of(line, ": error: ")
    if err_idx < 0 { continue }

    let ?msg = stdr.slice(line, err_idx + 9, stdr.len(line))
    let msg_bracket = stdr.index_of(msg, " [-W")
    if msg_bracket >= 0
      msg = stdr.slice(msg, 0, msg_bracket)

    let direct_loc = _extract_yi_location(line, err_idx)
    let ?loc = direct_loc
    if stdr.len(loc) == 0
      loc = _find_nearby_yi_location(lines, j, nlines)
    if stdr.len(loc) > 0
      loc = _normalize_loc_to_code_line(loc)

    -- Clang spillover: keep only Yis-facing function lookup message.
    if stdr.contains(msg, "implicit function declaration") ||
       stdr.contains(msg, "ISO C99 and later do not support implicit function declarations")
      -- If this came only from generated C (no direct .yi location), suppress it.
      if stdr.len(direct_loc) == 0 { continue }
      let cname = _extract_single_quoted(msg)
      let ?pretty = ""
      if stdr.len(cname) > 0
        pretty = "no such function or method '"
        pretty = stdr.str_concat(pretty, _demangle_c_name(cname))
        pretty = stdr.str_concat(pretty, "'")
      else
        pretty = "no such function or method in this call"
      let ?dedup_key = "implicit_decl:"
      dedup_key = stdr.str_concat(dedup_key, loc)
      dedup_key = stdr.str_concat(dedup_key, ":")
      dedup_key = stdr.str_concat(dedup_key, pretty)
      if stdr.is_null(seen[dedup_key])
        seen[dedup_key] = true
        err_count = err_count + 1
        _write_err_prefix(loc)
        stdr.write(pretty)
        stdr.write("\n")
        _write_err_details(loc, pretty)
      continue

    -- 1) Undeclared function → "no such function or method"
    if stdr.contains(msg, "undeclared function")
      let ?handled = false
      let cname = _extract_single_quoted(msg)
      if stdr.len(cname) > 0
        if stdr.is_null(seen[cname])
          seen[cname] = true
          let yname = _demangle_c_name(cname)
          let ?pretty = "no such function or method '"
          pretty = stdr.str_concat(pretty, yname)
          pretty = stdr.str_concat(pretty, "'")
          err_count = err_count + 1
          _write_err_prefix(loc)
          stdr.write(pretty)
          stdr.write("\n")
          _write_err_details(loc, pretty)
          handled = true
      if !handled
        let ?pretty = _demangle_error_message(msg)
        let ?dedup_key = "undeclared_fn_raw:"
        dedup_key = stdr.str_concat(dedup_key, loc)
        dedup_key = stdr.str_concat(dedup_key, ":")
        dedup_key = stdr.str_concat(dedup_key, pretty)
        if stdr.is_null(seen[dedup_key])
          seen[dedup_key] = true
          err_count = err_count + 1
          _write_err_prefix(loc)
          stdr.write(pretty)
          stdr.write("\n")
          _write_err_details(loc, pretty)
      continue

    -- 2) Too few / too many arguments → "expects N argument(s), but M given"
    if stdr.contains(msg, "too few arguments") || stdr.contains(msg, "too many arguments")
      let ?handled = false
      -- Look ahead for note: line with function name
      let ?fname = ""
      let ?k = j + 1
      for (; k < nlines && k < j + 8; k = k + 1)
        let nline = lines[k] ?? ""
        if stdr.contains(nline, ": note:") && stdr.contains(nline, "declared here")
          fname = _extract_single_quoted(nline)
          break
        if stdr.contains(nline, ": error:") { break }
      let counts = _extract_arg_counts(msg, fname)
      if !stdr.is_null(counts)
        let expected = counts[0] ?? 0
        let have = counts[1] ?? 0
        let ?dedup_key = "args:"
        dedup_key = stdr.str_concat(dedup_key, fname)
        dedup_key = stdr.str_concat(dedup_key, ":")
        dedup_key = stdr.str_concat(dedup_key, stdr.str(expected))
        dedup_key = stdr.str_concat(dedup_key, ":")
        dedup_key = stdr.str_concat(dedup_key, stdr.str(have))
        if stdr.is_null(seen[dedup_key])
          seen[dedup_key] = true
          let yname = _demangle_c_name(fname)
          let ?target = yname
          if stdr.len(target) == 0
            target = "this function"
          let ?pretty = target
          pretty = stdr.str_concat(pretty, " expects ")
          pretty = stdr.str_concat(pretty, stdr.str(expected))
          pretty = stdr.str_concat(pretty, " argument(s), but ")
          pretty = stdr.str_concat(pretty, stdr.str(have))
          pretty = stdr.str_concat(pretty, " given")
          err_count = err_count + 1
          _write_err_prefix(loc)
          stdr.write(pretty)
          stdr.write("\n")
          _write_err_details(loc, pretty)
          handled = true
      if !handled
        let ?pretty = _demangle_error_message(msg)
        let ?dedup_key = "args_raw:"
        dedup_key = stdr.str_concat(dedup_key, loc)
        dedup_key = stdr.str_concat(dedup_key, ":")
        dedup_key = stdr.str_concat(dedup_key, pretty)
        if stdr.is_null(seen[dedup_key])
          seen[dedup_key] = true
          err_count = err_count + 1
          _write_err_prefix(loc)
          stdr.write(pretty)
          stdr.write("\n")
          _write_err_details(loc, pretty)
      continue

    -- 3) Redefinition of variable → strip v_ prefix
    if stdr.contains(msg, "redefinition of")
      let ?handled = false
      let cname = _extract_single_quoted(msg)
      if stdr.len(cname) > 0
        let yname = _demangle_c_name(cname)
        if stdr.is_null(seen[cname])
          seen[cname] = true
          let emit_loc = _refine_redefinition_loc(loc, yname)
          let ?pretty = "redefinition of '"
          pretty = stdr.str_concat(pretty, yname)
          pretty = stdr.str_concat(pretty, "'")
          err_count = err_count + 1
          _write_err_prefix(emit_loc)
          stdr.write(pretty)
          stdr.write("\n")
          _write_err_details(emit_loc, pretty)
          handled = true
      if !handled
        let ?pretty = _demangle_error_message(msg)
        let ?dedup_key = "redef_raw:"
        dedup_key = stdr.str_concat(dedup_key, loc)
        dedup_key = stdr.str_concat(dedup_key, ":")
        dedup_key = stdr.str_concat(dedup_key, pretty)
        if stdr.is_null(seen[dedup_key])
          seen[dedup_key] = true
          err_count = err_count + 1
          _write_err_prefix(loc)
          stdr.write(pretty)
          stdr.write("\n")
          _write_err_details(loc, pretty)
      continue

    -- 4) Incompatible type details
    if stdr.contains(msg, "incompatible type")
      let ?pretty = _demangle_error_message(msg)
      let ?dedup_key = "incompat:"
      dedup_key = stdr.str_concat(dedup_key, loc)
      dedup_key = stdr.str_concat(dedup_key, ":")
      dedup_key = stdr.str_concat(dedup_key, pretty)
      if !stdr.is_null(seen[dedup_key]) { continue }
      seen[dedup_key] = true
      err_count = err_count + 1
      _write_err_prefix(loc)
      stdr.write(pretty)
      stdr.write("\n")
      _write_err_details(loc, pretty)
      continue

    -- 5) Non-void function <-: translate __lambda_N to "closure"
    if stdr.contains(msg, "should return a value") || stdr.contains(msg, "non-void function")
      let ?cleaned = msg
      -- Deduplicate: only show "a closure does not return a value on all paths" once
      if stdr.contains(cleaned, "__lambda_")
        if !stdr.is_null(seen["closure_return"]) { continue }
        seen["closure_return"] = true
        cleaned = "a closure does not return a value on all code paths"
      err_count = err_count + 1
      _write_err_prefix(loc)
      stdr.write(cleaned)
      stdr.write("\n")
      _write_err_details(loc, cleaned)
      continue

    -- 6) Generic fallback for unrecognized errors
    let ?fallback_msg = msg
    -- Strip [-Wfoo-bar] diagnostic suffix
    let fb_bracket = stdr.index_of(fallback_msg, " [-W")
    if fb_bracket >= 0
      fallback_msg = stdr.slice(fallback_msg, 0, fb_bracket)
    fallback_msg = _demangle_error_message(fallback_msg)
    let ?fallback_key = "fallback:"
    fallback_key = stdr.str_concat(fallback_key, loc)
    fallback_key = stdr.str_concat(fallback_key, ":")
    fallback_key = stdr.str_concat(fallback_key, fallback_msg)
    if !stdr.is_null(seen[fallback_key]) { continue }
    seen[fallback_key] = true
    err_count = err_count + 1
    _write_err_prefix(loc)
    stdr.write(fallback_msg)
    stdr.write("\n")
    _write_err_details(loc, fallback_msg)

  if err_count > 0
    stdr.write(stdr.str(err_count))
    stdr.write(" error(s) found\n")
  stdr.write("hint: set YIS_KEEP_C=1 to inspect the generated C code\n")
;

: interp_path_to_c(raw = string) (( any ))
  let s = stdr.trim(unescape_interp_expr(raw))
  let n = stdr.len(s)
  if n == 0 { <- null }

  let ?i = 0
  let c0 = stdr.slice(s, 0, 1)
  if !_is_ident_start_char(c0) { <- null }

  let ?j = 1
  for (; j < n; j = j + 1)
    if !_is_ident_mid_char(stdr.slice(s, j, j + 1)) { break }
  let head = stdr.slice(s, 0, j)
  let ?out = ""
  if !stdr.is_null(g_global_def_names[head])
    out = mangle_def(g_cur_mod, head)
  else
    out = stdr.str_concat("v_", head)
  i = j

  for (; i < n; )
    let ch = stdr.slice(s, i, i + 1)
    if ch == "."
      i = i + 1
      if i >= n || !_is_ident_start_char(stdr.slice(s, i, i + 1)) { <- null }
      j = i + 1
      for (; j < n; j = j + 1)
        if !_is_ident_mid_char(stdr.slice(s, j, j + 1)) { break }
      let field = stdr.slice(s, i, j)
      -- Try direct struct field access when inside a class method
      let ?cls_info = []: [string => any]
      if stdr.len(g_cur_class) > 0 && head == "this"
        cls_info = g_classes[g_cur_class] ?? []: [string => any]
      let fmap = cls_info["field_map"] ?? []: [string => any]
      let finfo = fmap[field] ?? []: [string => any]
      let fname = finfo["name"] ?? ""
      let ?next = ""
      if stdr.len(fname) > 0
        let cls_mod = cls_info["mod"] ?? g_cur_mod
        next = "({\n    YisVal _mfr = ((YisObj_"
        next = stdr.str_concat(next, cls_mod)
        next = stdr.str_concat(next, "_")
        next = stdr.str_concat(next, g_cur_class)
        next = stdr.str_concat(next, "*)(")
        next = stdr.str_concat(next, out)
        next = stdr.str_concat(next, ").as.p)->f_")
        next = stdr.str_concat(next, field)
        next = stdr.str_concat(next, ";\n    yis_retain_val(_mfr);\n    _mfr;\n})")
      else
        next = "yis_get_field(((YisObj*)("
        next = stdr.str_concat(next, out)
        next = stdr.str_concat(next, ").as.p), stdr_str_lit(")
        next = stdr.str_concat(next, _c_quote(field))
        next = stdr.str_concat(next, "))")
      out = next
      i = j
      continue
    if ch == "["
      let ?k = i + 1
      let ?depth = 1
      for (; k < n; k = k + 1)
        let kc = stdr.slice(s, k, k + 1)
        if kc == "["
          depth = depth + 1
        elif kc == "]"
          depth = depth - 1
          if depth == 0 { break }
      if k >= n || depth != 0 { <- null }
      let inner = stdr.trim(stdr.slice(s, i + 1, k))
      let ?idxc = ""
      let in_n = stdr.len(inner)
      if in_n >= 2
        let a = stdr.slice(inner, 0, 1)
        let b = stdr.slice(inner, in_n - 1, in_n)
        if a == "\"" && b == "\""
          let key = stdr.slice(inner, 1, in_n - 1)
          idxc = stdr.str_concat("YV_STR(stdr_str_lit(", _c_quote(key))
          idxc = stdr.str_concat(idxc, "))")
        elif a == "'" && b == "'"
          let key = stdr.slice(inner, 1, in_n - 1)
          idxc = stdr.str_concat("YV_STR(stdr_str_lit(", _c_quote(key))
          idxc = stdr.str_concat(idxc, "))")
      if stdr.len(idxc) == 0
        if _is_int_text(inner)
          idxc = stdr.str_concat("YV_INT(", inner)
          idxc = stdr.str_concat(idxc, ")")
        else
          if stdr.is_null(interp_path_to_c(inner)) { <- null }
          idxc = interp_path_to_c(inner)
      let ?next = "yis_index("
      next = stdr.str_concat(next, out)
      next = stdr.str_concat(next, ", ")
      next = stdr.str_concat(next, idxc)
      next = stdr.str_concat(next, ")")
      out = next
      i = k + 1
      continue
    <- null

  <- out
;

: interp_expr_to_ast(raw = string) (( any ))
  let src = stdr.trim(unescape_interp_expr(raw))
  if stdr.len(src) == 0 { <- null }

  let toks = lexer.lex(src)
  if stdr.is_null(toks) { <- null }

  let parsed = parser.parse_expr(toks, 0, 0)
  if parser.has_errors() { stdr.exit_process(1) }
  let expr = parsed[1]
  if stdr.is_null(expr) { <- null }

  let ?j = stdr.num(parsed[0] ?? 0)
  for (; true; )
    let t = toks[j] ?? []: [string => any]
    let k = t["kind"] ?? "eof"
    if k == "semi" || k == "newline_semi"
      j = j + 1
      continue
    if k == "eof"
      <- expr
    <- null
  <- null
;

: is_stdlib_module(name = string) (( bool ))
  if name == "stdr" || name == "math" || name == "net" || name == "json" { <- true }
  <- false
;

: is_external_module(name = string) (( bool ))
  if is_stdlib_module(name) { <- false }
  if stdr.len(name) == 0 { <- false }
  -- Check env var: YIS_<NAME>_PATH
  let ?env_name = "YIS_"
  let upper_name = str_to_upper(name)
  env_name = stdr.str_concat(env_name, upper_name)
  env_name = stdr.str_concat(env_name, "_PATH")
  if env_nonempty(env_name) { <- true }
  -- Check if found in stdlib search (installed via {datadir}/yis/stdlib/{name}.yi)
  let p = resolve_stdlib_module_path(name)
  if stdr.len(p) > 0 { <- true }
  -- Check dev-relative paths: ../{name}/src/{name}.yi etc
  let ?dp = stdr.str_concat(stdr.str_concat("../", name), stdr.str_concat("/src/", stdr.str_concat(name, ".yi")))
  if stdr.file_exists(dp) { <- true }
  dp = stdr.str_concat(stdr.str_concat("../../", name), stdr.str_concat("/src/", stdr.str_concat(name, ".yi")))
  if stdr.file_exists(dp) { <- true }
  <- false
;

: str_to_upper(text = string) (( string ))
  let n = stdr.len(text)
  if n == 0 { <- "" }
  let ?parts = []: [any]
  let ?i = 0
  for (; i < n; i = i + 1)
    let code = stdr.char_code(stdr.slice(text, i, i + 1))
    if code >= 97 && code <= 122
      stdr.push(parts, stdr.char_from_code(code - 32))
    else
      stdr.push(parts, stdr.slice(text, i, i + 1))
  <- stdr.join(parts)
;

: is_capture_excluded(name = string) (( bool ))
  if name == "" { <- true }
  if is_stdlib_module(name) { <- true }
  if is_external_module(name) { <- true }
  <- false
;

: arr_contains(xs = any, v = any) (( bool ))
  let n = stdr.len(xs)
  let ?i = 0
  for (; i < n; i = i + 1)
    if xs[i] == v { <- true }
  <- false
;

: arr_add_unique(xs = any, v = any) (( any ))
  if arr_contains(xs, v) { <- xs }
  stdr.push(xs, v)
  <- xs
;

: scope_mark(name = string) (( -- ))
  if stdr.len(name) == 0 { <- }
  if stdr.is_null(g_scope_names[name])
    g_scope_order = stdr.concat(g_scope_order, [name])
  g_scope_names[name] = true
;

: collect_used_expr_lambda(e = any, used = any) (( any ))
  let ?u = used
  if stdr.is_null(e) { <- u }
  let et = e["tag"] ?? ""

  if et == "ident"
    let name = e["name"] ?? ""
    if !is_capture_excluded(name)
      u = arr_add_unique(u, name)
    <- u

  if et == "unary"
    <- collect_used_expr_lambda(e["operand"], u)

  if et == "binop"
    u = collect_used_expr_lambda(e["left"], u)
    u = collect_used_expr_lambda(e["right"], u)
    <- u

  if et == "assign"
    u = collect_used_expr_lambda(e["lhs"], u)
    u = collect_used_expr_lambda(e["rhs"], u)
    <- u

  if et == "call"
    let fn = e["func"]
    let ftag = fn["tag"] ?? ""
    if ftag == "member"
      u = collect_used_expr_lambda(fn["obj"], u)
    elif ftag != "ident"
      u = collect_used_expr_lambda(fn, u)
    let args = e["args"] ?? []: [any]
    let ?i = 0
    let ?n = stdr.len(args)
    for (; i < n; i = i + 1)
      u = collect_used_expr_lambda(args[i], u)
    <- u

  if et == "bang_call"
    u = collect_used_expr_lambda(e["recv"], u)
    let args = e["args"] ?? []: [any]
    let ?i = 0
    let n = stdr.len(args)
    for (; i < n; i = i + 1)
      u = collect_used_expr_lambda(args[i], u)
    <- u

  if et == "member"
    <- collect_used_expr_lambda(e["obj"], u)

  if et == "index"
    u = collect_used_expr_lambda(e["obj"], u)
    u = collect_used_expr_lambda(e["idx"], u)
    <- u

  if et == "array"
    let elems = e["elems"] ?? []: [any]
    let ?i = 0
    let ?n = stdr.len(elems)
    for (; i < n; i = i + 1)
      u = collect_used_expr_lambda(elems[i], u)
    <- u

  if et == "dict"
    let ents = e["entries"] ?? []: [any]
    let ?i = 0
    let ?n = stdr.len(ents)
    for (; i < n; i = i + 1)
      let ent = ents[i]
      u = collect_used_expr_lambda(ent["key"], u)
      u = collect_used_expr_lambda(ent["value"], u)
    <- u

  if et == "if_expr"
    u = collect_used_expr_lambda(e["cond"], u)
    u = collect_used_expr_lambda(e["then"], u)
    u = collect_used_expr_lambda(e["else"], u)
    <- u

  if et == "match"
    u = collect_used_expr_lambda(e["scrut"], u)
    let arms = e["arms"] ?? []: [any]
    let ?i = 0
    let ?n = stdr.len(arms)
    for (; i < n; i = i + 1)
      let arm = arms[i]
      u = collect_used_expr_lambda(arm["expr"], u)
    <- u

  if et == "lambda"
    <- u

  <- u
;

: collect_used_stmt_lambda(s = any, used = any) (( any ))
  let ?u = used
  if stdr.is_null(s) { <- u }
  let st = s["tag"] ?? ""
  if st == "let" || st == "const"
    <- collect_used_expr_lambda(s["init"], u)
  if st == "return" || st == "expr_stmt"
    <- collect_used_expr_lambda(s["value"] ?? s["expr"], u)
  if st == "if"
    u = collect_used_expr_lambda(s["cond"], u)
    let then_s = s["then"] ?? []: [any]
    let else_s = s["else"] ?? []: [any]
    let ?i = 0
    let ?n = stdr.len(then_s)
    for (; i < n; i = i + 1) { u = collect_used_stmt_lambda(then_s[i], u) }
    i = 0
    n = stdr.len(else_s)
    for (; i < n; i = i + 1) { u = collect_used_stmt_lambda(else_s[i], u) }
    <- u
  if st == "for"
    u = collect_used_expr_lambda(s["init"], u)
    u = collect_used_stmt_lambda(s["init_stmt"], u)
    u = collect_used_expr_lambda(s["cond"], u)
    u = collect_used_expr_lambda(s["step"], u)
    let body = s["body"] ?? []: [any]
    let ?i = 0
    let ?n = stdr.len(body)
    for (; i < n; i = i + 1) { u = collect_used_stmt_lambda(body[i], u) }
    <- u
  if st == "foreach"
    u = collect_used_expr_lambda(s["iter"], u)
    let body = s["body"] ?? []: [any]
    let ?i = 0
    let ?n = stdr.len(body)
    for (; i < n; i = i + 1) { u = collect_used_stmt_lambda(body[i], u) }
    <- u
  <- u
;

: collect_declared_stmt_lambda(s = any, decl = any) (( any ))
  let ?d = decl
  if stdr.is_null(s) { <- d }
  let st = s["tag"] ?? ""
  if st == "let" || st == "const"
    let name = s["name"] ?? ""
    if stdr.len(name) > 0 { d[name] = true }
    <- d
  if st == "foreach"
    let it = s["item"] ?? ""
    if stdr.len(it) > 0 { d[it] = true }
    let body = s["body"] ?? []: [any]
    let ?i = 0
    let ?n = stdr.len(body)
    for (; i < n; i = i + 1)
      d = collect_declared_stmt_lambda(body[i], d)
    <- d
  if st == "for"
    d = collect_declared_stmt_lambda(s["init_stmt"], d)
    let body = s["body"] ?? []: [any]
    let ?i = 0
    let ?n = stdr.len(body)
    for (; i < n; i = i + 1)
      d = collect_declared_stmt_lambda(body[i], d)
    <- d
  if st == "if"
    let then_s = s["then"] ?? []: [any]
    let else_s = s["else"] ?? []: [any]
    let ?i = 0
    let ?n = stdr.len(then_s)
    for (; i < n; i = i + 1) { d = collect_declared_stmt_lambda(then_s[i], d) }
    i = 0
    n = stdr.len(else_s)
    for (; i < n; i = i + 1) { d = collect_declared_stmt_lambda(else_s[i], d) }
    <- d
  <- d
;

: lambda_capture_names(e = any) (( any ))
  let params = e["params"] ?? []: [any]
  let ?param_names = []: [string => any]
  let ?i = 0
  let ?n = stdr.len(params)
  for (; i < n; i = i + 1)
    let p = params[i]
    let pn = p["name"] ?? ""
    if stdr.len(pn) > 0 { param_names[pn] = true }

  let ?caps = []: [any]
  i = 0
  n = stdr.len(g_scope_order)
  for (; i < n; i = i + 1)
    let name = g_scope_order[i] ?? ""
    if param_names[name] { continue }
    if is_capture_excluded(name) { continue }
    if g_global_def_names[name] { continue }
    if stdr.is_null(g_scope_names[name]) { continue }
    stdr.push(caps, name)
  <- caps
;

: alloc_lambda_id() (( num ))
  let id = g_next_lambda_id
  g_next_lambda_id = g_next_lambda_id + 1
  <- id
;

: make_ident_expr(name = string) (( any ))
  let ?n = []: [string => any]
  n["tag"] = "ident"
  n["name"] = name
  <- n
;

: ensure_lambda_meta(e = any, cask_name = string) (( any ))
  let id = alloc_lambda_id()
  let key = stdr.str(id)
  let ?meta = []: [string => any]
  meta["id"] = id
  meta["name"] = stdr.str_concat("__lambda_", stdr.str(id))
  meta["params"] = e["params"] ?? []: [any]
  meta["body"] = e["body"] ?? []: [any]
  meta["captures"] = lambda_capture_names(e)
  let caps = meta["captures"] ?? []: [any]
  let ?cap_types = []: [string => any]
  let ?ci = 0
  let cn = stdr.len(caps)
  for (; ci < cn; ci = ci + 1)
    let cname = caps[ci] ?? ""
    let ctype = g_var_types[cname]
    if !stdr.is_null(ctype)
      cap_types[cname] = ctype
  meta["cap_types"] = cap_types
  meta["cask"] = cask_name
  g_lambda_meta[key] = meta
  stdr.push(g_lambda_ids, id)
  <- meta
;

: emit_lambda_expr(e = any, cask_name = string) (( string ))
  let meta = ensure_lambda_meta(e, cask_name)
  let lname = meta["name"] ?? "__lambda_0"
  let params = meta["params"] ?? []: [any]
  let caps = meta["captures"] ?? []: [any]
  let arity = stdr.len(params)
  let capn = stdr.len(caps)

  let ?r = "({ YisVal "
  r = stdr.str_concat(r, lname)
  r = stdr.str_concat(r, "(void*,int,YisVal*); YisVal* __caps = NULL; ")

  if capn > 0
    r = stdr.str_concat(r, "__caps = (YisVal*)calloc(")
    r = stdr.str_concat(r, stdr.str(capn))
    r = stdr.str_concat(r, ", sizeof(YisVal)); ")
    let ?i = 0
    for (; i < capn; i = i + 1)
      let name = caps[i] ?? ""
      r = stdr.str_concat(r, "__caps[")
      r = stdr.str_concat(r, stdr.str(i))
      r = stdr.str_concat(r, "] = ")
      r = stdr.str_concat(r, emit_expr(make_ident_expr(name), cask_name))
      r = stdr.str_concat(r, "; yis_retain_val(__caps[")
      r = stdr.str_concat(r, stdr.str(i))
      r = stdr.str_concat(r, "]); ")

  r = stdr.str_concat(r, "YV_FN(yi_fn_new_with_env(")
  r = stdr.str_concat(r, lname)
  r = stdr.str_concat(r, ", ")
  r = stdr.str_concat(r, stdr.str(arity))
  r = stdr.str_concat(r, ", __caps, ")
  r = stdr.str_concat(r, stdr.str(capn))
  r = stdr.str_concat(r, ")); })")
  <- r
;

-- Build class info tables from a module's declarations.
-- Populates g_classes, g_fun_rets, g_mod_funs, g_all_funs.
: build_class_info(decls = any, mod_name = string) (( -- ))
  let tag = "tag"
  let name_key = "name"
  let ret_key = "ret"
  let n = stdr.len(decls)
  let ?i = 0
  for (; i < n; i = i + 1)
    let d = decls[i]
    let dt = d[tag] ?? ""

    if dt == "class"
      let cls_name = d[name_key] ?? ""
      let methods_key = "methods"
      let methods = d[methods_key] ?? []: [any]
      let ?mdict = []: [string => any]
      let mret_key = "ret"
      let ?j = 0
      let nm = stdr.len(methods)
      for (; j < nm; j = j + 1)
        let m = methods[j]
        let mname = m[name_key] ?? ""
        mdict[mname] = true
        let mret = m[mret_key] ?? ""
        if mret == "void" || mret == "--"
          let ?mkey = mod_name
          mkey = stdr.str_concat(mkey, ".")
          mkey = stdr.str_concat(mkey, cls_name)
          mkey = stdr.str_concat(mkey, ".")
          mkey = stdr.str_concat(mkey, mname)
          g_fun_voids[mkey] = true
        if stdr.len(mret) > 0
          if mret != "any" && mret != "void" && mret != "--" && mret != "num" && mret != "string" && mret != "bool" && mret != "fn"
            let ?mkey = mod_name
            mkey = stdr.str_concat(mkey, ".")
            mkey = stdr.str_concat(mkey, cls_name)
            mkey = stdr.str_concat(mkey, ".")
            mkey = stdr.str_concat(mkey, mname)
            g_fun_rets[mkey] = mret
      let ?info = []: [string => any]
      info["methods"] = mdict
      info["mod"] = mod_name

      -- Collect field metadata from class AST
      let fields_key = "fields"
      let raw_fields = d[fields_key] ?? []: [any]
      let ?flist = []: [any]
      let ?fmap = []: [string => any]
      let ?fi = 0
      let nf = stdr.len(raw_fields)
      for (; fi < nf; fi = fi + 1)
        let fd = raw_fields[fi]
        let fn2 = fd[name_key] ?? ""
        let ft = fd["type"] ?? "any"
        let fp = fd["pub"] ?? false
        let ?finfo = []: [string => any]
        finfo["name"] = fn2
        finfo["type"] = ft
        finfo["pub"] = fp
        finfo["index"] = fi
        stdr.push(flist, finfo)
        fmap[fn2] = finfo
      info["fields"] = flist
      info["field_map"] = fmap

      -- Store base class name
      let base_key = "base"
      info["base"] = d[base_key] ?? ""

      g_classes[cls_name] = info

      -- Check interface conformance if class declares a base
      let cls_base = d[base_key] ?? ""
      if stdr.len(cls_base) > 0
        let iface_info = g_interfaces[cls_base] ?? []: [string => any]
        let iface_check_name = iface_info["name"] ?? ""
        if stdr.len(iface_check_name) > 0
          -- Check primary initiator method (only when interface has params)
          let iface_iname = iface_info["name"] ?? ""
          let pk2 = "params"
          let iface_params = iface_info[pk2] ?? []: [any]
          if stdr.len(iface_params) > 0
            if stdr.is_null(mdict[iface_iname])
              write("error: class '")
              write(cls_name)
              write("' conforms to interface '")
              write(cls_base)
              write("' but is missing initiator method '")
              write(iface_iname)
              write("'\n")
          -- Check :: contract methods
          let iface_methods = iface_info["methods"] ?? []: [any]
          let ?im = 0
          let nim = stdr.len(iface_methods)
          for (; im < nim; im = im + 1)
            let im_node = iface_methods[im]
            let im_name = im_node[name_key] ?? ""
            if stdr.is_null(mdict[im_name])
              write("error: class '")
              write(cls_name)
              write("' conforms to interface '")
              write(cls_base)
              write("' but is missing method '")
              write(im_name)
              write("'\n")

    if dt == "interface"
      let iface_name = d[name_key] ?? ""
      let ?iinfo = []: [string => any]
      iinfo["name"] = iface_name
      let pk = "params"
      iinfo["params"] = d[pk] ?? []: [any]
      iinfo["ret"] = d[ret_key] ?? "any"
      let mk = "methods"
      iinfo["methods"] = d[mk] ?? []: [any]
      g_interfaces[iface_name] = iinfo

    if dt == "fun"
      let fname = d[name_key] ?? ""
      let ret = d[ret_key] ?? ""
      let ?fkey = mod_name
      fkey = stdr.str_concat(fkey, ".")
      fkey = stdr.str_concat(fkey, fname)
      if ret == "void" || ret == "--"
        g_fun_voids[fkey] = true
      -- Track function <- types for constructor resolution
      if stdr.len(ret) > 0
        if ret != "any" && ret != "void" && ret != "--" && ret != "num" && ret != "string" && ret != "bool" && ret != "fn"
          g_fun_rets[fkey] = ret
      -- Track module functions
      let ?mf = g_mod_funs[mod_name] ?? []: [string => any]
      mf[fname] = true
      g_mod_funs[mod_name] = mf
      g_fun_origin[fname] = mod_name
      -- Track all functions with arity
      let pk = "params"
      let params = d[pk] ?? []: [any]
      g_all_funs[fkey] = stdr.len(params)

    if dt == "macro"
      let fname = d[name_key] ?? ""
      let ret = d[ret_key] ?? ""
      if ret == "void" || ret == "--"
        let ?mkey = mod_name
        mkey = stdr.str_concat(mkey, ".")
        mkey = stdr.str_concat(mkey, fname)
        g_fun_voids[mkey] = true
      let ?mf2 = g_mod_funs[mod_name] ?? []: [string => any]
      mf2[fname] = true
      g_mod_funs[mod_name] = mf2
;

-- Infer the class type of an expression. Returns class name or "".
: type_of_expr(e = any, cask_name = string) (( string ))
  if stdr.is_null(e) { <- "" }
  let tag = "tag"
  let et = e[tag] ?? ""

  if et == "ident"
    let nk = "name"
    let name = e[nk] ?? ""
    let t0 = g_var_types[name] ?? ""
    if stdr.len(t0) > 0 { <- t0 }
    <- g_def_types[name] ?? ""

  if et == "call"
    let fk = "func"
    let callee = e[fk]
    if stdr.is_null(callee) { <- "" }
    let ct = callee[tag] ?? ""
    if ct == "member"
      let ok = "obj"
      let fldk = "field"
      let obj = callee[ok]
      let field = callee[fldk] ?? ""
      let obj_tag = obj[tag] ?? ""
      if obj_tag == "ident"
        let nk = "name"
        let obj_name = obj[nk] ?? ""
        -- Variable.method() call: prefer variable type over module-name lookup.
        let ?vtype = g_var_types[obj_name] ?? ""
        if stdr.len(vtype) == 0
          vtype = g_def_types[obj_name] ?? ""
        if stdr.len(vtype) > 0
          let cls_info = g_classes[vtype]
          if !stdr.is_null(cls_info)
            let cls_mod = dict_get_or(cls_info, "mod", "") ?? ""
            if stdr.len(cls_mod) > 0
              let ?mkey = cls_mod
              mkey = stdr.str_concat(mkey, ".")
              mkey = stdr.str_concat(mkey, vtype)
              mkey = stdr.str_concat(mkey, ".")
              mkey = stdr.str_concat(mkey, field)
              let mret = g_fun_rets[mkey] ?? ""
              if stdr.len(mret) > 0 { <- mret }
          if stdr.len(vtype) > 0 { <- vtype }
        -- Module.function() call: look up <- type
        -- Cross-module constructor: mod.ClassName(args) returns class type
        let te_mcls = g_classes[field] ?? []: [string => any]
        let te_mcls_fields = te_mcls["fields"] ?? []: [any]
        if stdr.len(te_mcls_fields) > 0 { <- field }
        let ?key = obj_name
        key = stdr.str_concat(key, ".")
        key = stdr.str_concat(key, field)
        let ret = g_fun_rets[key] ?? ""
        if stdr.len(ret) > 0 { <- ret }
      -- Method call on expression: chain preserves type
      let obj_type = type_of_expr(obj, cask_name)
      if stdr.len(obj_type) > 0 { <- obj_type }
    if ct == "ident"
      -- Direct function call: look up <- type
      let nk = "name"
      let fname = callee[nk] ?? ""
      -- Constructor call: ClassName(args) returns that class type
      let te_cls = g_classes[fname] ?? []: [string => any]
      let te_cls_fields = te_cls["fields"] ?? []: [any]
      if stdr.len(te_cls_fields) > 0 { <- fname }
      let ?key = cask_name
      key = stdr.str_concat(key, ".")
      key = stdr.str_concat(key, fname)
      let ret = g_fun_rets[key] ?? ""
      if stdr.len(ret) > 0 { <- ret }

  <- ""
;

: call_returns_void(e = any, cask_name = string) (( bool ))
  if stdr.is_null(e) { <- false }
  let tag = "tag"
  let et = e[tag] ?? ""
  if et == "bang_call"
    let key = stdr.str_concat(stdr.str_concat(cask_name, "."), e["name"] ?? "")
    <- !stdr.is_null(g_fun_voids[key])
  if et != "call" { <- false }
  let func = e["func"]
  let ft = func[tag] ?? ""
  if ft == "ident"
    let fname = func["name"] ?? ""
    if fname == "write" || fname == "writef" || fname == "push"
      <- true
    if fname == "__write" || fname == "__writef"
      <- true
    let ?key = cask_name
    key = stdr.str_concat(key, ".")
    key = stdr.str_concat(key, fname)
    if !stdr.is_null(g_fun_voids[key]) { <- true }
    let origin = stdr.str(g_fun_origin[fname] ?? "")
    if stdr.len(origin) > 0
      key = stdr.str_concat(origin, ".")
      key = stdr.str_concat(key, fname)
      if !stdr.is_null(g_fun_voids[key]) { <- true }
    <- false
  if ft == "member"
    let obj = func["obj"]
    let field = func["field"] ?? ""
    let ot = obj[tag] ?? ""
    if ot == "ident"
      let obj_name = obj["name"] ?? ""
      if obj_name == "stdr"
        if field == "write" || field == "writef" || field == "push"
          <- true
      let ?key = obj_name
      key = stdr.str_concat(key, ".")
      key = stdr.str_concat(key, field)
      if !stdr.is_null(g_fun_voids[key]) { <- true }
      let vtype = g_var_types[obj_name] ?? ""
      if stdr.len(vtype) > 0
        let cls_info = g_classes[vtype]
        if !stdr.is_null(cls_info)
          let cls_mod = dict_get_or(cls_info, "mod", "") ?? ""
          key = stdr.str_concat(cls_mod, ".")
          key = stdr.str_concat(key, vtype)
          key = stdr.str_concat(key, ".")
          key = stdr.str_concat(key, field)
          if !stdr.is_null(g_fun_voids[key]) { <- true }
  <- false
;

: emit_array_literal(elems = any, cask_name = string) (( string ))
  let n = stdr.len(elems)
  let id = g_tmp_counter
  g_tmp_counter = g_tmp_counter + 1
  let arr_name = stdr.str_concat("__arr", stdr.str(id))
  let val_base = stdr.str_concat("__arrv", stdr.str(id))
  let ?parts = []: [any]
  stdr.push(parts, "({ YisArr *")
  stdr.push(parts, arr_name)
  stdr.push(parts, " = stdr_arr_new(")
  stdr.push(parts, stdr.str(n))
  stdr.push(parts, "); ")
  let ?i = 0
  for (; i < n; i = i + 1)
    let item = elems[i]
    let ?val_name = stdr.str_concat(val_base, "_")
    val_name = stdr.str_concat(val_name, stdr.str(i))
    stdr.push(parts, "YisVal ")
    stdr.push(parts, val_name)
    stdr.push(parts, " = ")
    stdr.push(parts, emit_expr(item, cask_name))
    stdr.push(parts, "; ")
    if !is_fresh_expr(item)
      stdr.push(parts, "yis_retain_val(")
      stdr.push(parts, val_name)
      stdr.push(parts, "); ")
    stdr.push(parts, "yis_arr_add(")
    stdr.push(parts, arr_name)
    stdr.push(parts, ", ")
    stdr.push(parts, val_name)
    stdr.push(parts, "); ")
  stdr.push(parts, "YV_ARR(")
  stdr.push(parts, arr_name)
  stdr.push(parts, "); })")
  <- stdr.join(parts)
;

: emit_dict_literal(entries = any, cask_name = string) (( string ))
  let n = stdr.len(entries)
  let id = g_tmp_counter
  g_tmp_counter = g_tmp_counter + 1
  let dict_name = stdr.str_concat("__dict", stdr.str(id))
  let key_base = stdr.str_concat("__dictk", stdr.str(id))
  let val_base = stdr.str_concat("__dictv", stdr.str(id))
  let ?parts = []: [any]
  stdr.push(parts, "({ YisDict *")
  stdr.push(parts, dict_name)
  stdr.push(parts, " = stdr_dict_new(); ")
  let ?i = 0
  for (; i < n; i = i + 1)
    let ent = entries[i]
    let key_expr = ent["key"]
    let val_expr = ent["value"]
    let ?key_name = stdr.str_concat(key_base, "_")
    key_name = stdr.str_concat(key_name, stdr.str(i))
    let ?val_name = stdr.str_concat(val_base, "_")
    val_name = stdr.str_concat(val_name, stdr.str(i))
    stdr.push(parts, "YisVal ")
    stdr.push(parts, key_name)
    stdr.push(parts, " = ")
    stdr.push(parts, emit_expr(key_expr, cask_name))
    stdr.push(parts, "; YisVal ")
    stdr.push(parts, val_name)
    stdr.push(parts, " = ")
    stdr.push(parts, emit_expr(val_expr, cask_name))
    stdr.push(parts, "; yis_dict_set(")
    stdr.push(parts, dict_name)
    stdr.push(parts, ", ")
    stdr.push(parts, key_name)
    stdr.push(parts, ", ")
    stdr.push(parts, val_name)
    stdr.push(parts, "); ")
    if is_fresh_expr(key_expr)
      stdr.push(parts, "yis_release_val(")
      stdr.push(parts, key_name)
      stdr.push(parts, "); ")
    if is_fresh_expr(val_expr)
      stdr.push(parts, "yis_release_val(")
      stdr.push(parts, val_name)
      stdr.push(parts, "); ")
  stdr.push(parts, "YV_DICT(")
  stdr.push(parts, dict_name)
  stdr.push(parts, "); })")
  <- stdr.join(parts)
;

-- Emit a C expression string from an expr AST node.
-- Returns a C expression string (of type YisVal).
: emit_expr(e = any, cask_name = string) (( string ))
  -- Keep temporaries inside the expression which evaluates them. Hoisting them
  -- to a statement changes short-circuiting and evaluates loop inputs once.
  let prev_names = g_flat_names
  let prev_exprs = g_flat_exprs
  g_flat_names = []: [any]
  g_flat_exprs = []: [any]
  let code = emit_expr_core(e, cask_name)
  let decls = flat_decls("  ")
  let releases = flat_releases("  ")
  g_flat_names = prev_names
  g_flat_exprs = prev_exprs
  if stdr.len(decls) == 0 { <- code }
  let ?out = stdr.str_concat("({\n", decls)
  if call_returns_void(e, cask_name)
    out = stdr.str_concat(out, "  (void)(")
    out = stdr.str_concat(out, code)
    out = stdr.str_concat(out, ");\n")
    out = stdr.str_concat(out, releases)
    out = stdr.str_concat(out, "  YV_NULLV; })")
  else
    out = stdr.str_concat(out, "  YisVal __ev_result = ")
    out = stdr.str_concat(out, code)
    out = stdr.str_concat(out, ";\n")
    out = stdr.str_concat(out, releases)
    out = stdr.str_concat(out, "  __ev_result; })")
  <- out
;

-- Convert a borrowed expression into an owned reference at its evaluation site.
-- Consume a condition's owned reference at each evaluation, including loops.
: emit_condition(e = any, cask_name = string) (( string ))
  let ?r = "({ YisVal __condition = "
  r = stdr.str_concat(r, emit_owned_expr(e, cask_name))
  r = stdr.str_concat(r, "; bool __truth = yis_as_bool(__condition); yis_release_val(__condition); YV_BOOL(__truth); })")
  <- r
;

: emit_owned_expr(e = any, cask_name = string) (( string ))
  let code = emit_expr(e, cask_name)
  if is_fresh_expr(e) { <- code }
  let ?r = "({ YisVal __borrowed = "
  r = stdr.str_concat(r, code)
  r = stdr.str_concat(r, "; yis_retain_val(__borrowed); __borrowed; })")
  <- r
;

: emit_expr_core(e = any, cask_name = string) (( string ))
  if stdr.is_null(e) { <- "YV_NULLV" }
  let tag = "tag"
  let et = e[tag] ?? ""

  if et == "int"
    let vk = "value"
    let v = e[vk] ?? "0"
    if stdr.str(v) == "-9223372036854775808"
      <- "YV_INT((-9223372036854775807LL - 1))"
    let ?r = "YV_INT("
    r = stdr.str_concat(r, stdr.str(v))
    r = stdr.str_concat(r, ")")
    <- r

  if et == "float"
    let vk = "value"
    let v = e[vk] ?? "0.0"
    let ?r = "YV_FLOAT("
    r = stdr.str_concat(r, stdr.str(v))
    r = stdr.str_concat(r, ")")
    <- r

  if et == "bool"
    let vk = "value"
    let v = e[vk]
    if v { <- "YV_BOOL(true)" }
    <- "YV_BOOL(false)"

  if et == "null"
    <- "YV_NULLV"

  if et == "str"
    let vk = "value"
    let v = e[vk] ?? ""
    -- Emit YV_STR(stdr_str_lit("..."))
    let ?r = "YV_STR(stdr_str_from_slice("
    r = stdr.str_concat(r, _c_quote(v))
    r = stdr.str_concat(r, ", ")
    r = stdr.str_concat(r, stdr.str(stdr.len(v)))
    r = stdr.str_concat(r, "))")
    <- r

  if et == "interp"
    -- Interpolated string: build from parts using stdr_str_from_parts
    let partsk = "parts"
    let iparts = e[partsk] ?? []: [any]
    let ?np = stdr.len(iparts)
    if np == 0 { <- "YV_STR(stdr_str_lit(\"\"))" }
    -- Use GCC statement expression to declare temp array
    let ?r = "({ YisVal __ip["
    r = stdr.str_concat(r, stdr.str(np))
    r = stdr.str_concat(r, "]; ")
    let ?pi = 0
    for (; pi < np; pi = pi + 1)
      let part = iparts[pi]
      let pkind = part["kind"] ?? ""
      let pval = part["val"] ?? ""
      let ?interp_expr = null
      if pkind != "text" { interp_expr = interp_expr_to_ast(pval) }
      r = stdr.str_concat(r, "__ip[")
      r = stdr.str_concat(r, stdr.str(pi))
      r = stdr.str_concat(r, "] = ")
      if pkind == "text"
        r = stdr.str_concat(r, "YV_STR(stdr_str_from_slice(")
        r = stdr.str_concat(r, _c_quote(pval))
        r = stdr.str_concat(r, ", ")
        r = stdr.str_concat(r, stdr.str(stdr.len(pval)))
        r = stdr.str_concat(r, "))")
      else
        -- expr part: parse and compile full expression inside $$...$$.
        if !stdr.is_null(interp_expr)
          r = stdr.str_concat(r, "YV_STR(stdr_to_string(")
          r = stdr.str_concat(r, emit_flat_arg(interp_expr, emit_expr(interp_expr, cask_name)))
          r = stdr.str_concat(r, "))")
        elif stdr.is_null(interp_path_to_c(pval))
          -- Backward-compatible fallback for malformed interpolation bodies.
          r = stdr.str_concat(r, "YV_STR(stdr_to_string(v_")
          r = stdr.str_concat(r, unescape_interp_expr(pval))
          r = stdr.str_concat(r, "))")
        else
          r = stdr.str_concat(r, "YV_STR(stdr_to_string(")
          r = stdr.str_concat(r, interp_path_to_c(pval))
          r = stdr.str_concat(r, "))")
      r = stdr.str_concat(r, "; ")
    r = stdr.str_concat(r, "YisVal __ip_result = YV_STR(stdr_str_from_parts(")
    r = stdr.str_concat(r, stdr.str(np))
    r = stdr.str_concat(r, ", __ip)); ")
    let ?ri = 0
    for (; ri < np; ri = ri + 1)
      r = stdr.str_concat(r, "yis_release_val(__ip[")
      r = stdr.str_concat(r, stdr.str(ri))
      r = stdr.str_concat(r, "]); ")
    r = stdr.str_concat(r, "__ip_result; })")
    <- r

  if et == "ident"
    let nk = "name"
    let name = e[nk] ?? ""
    if !stdr.is_null(g_scope_names[name])
      let ?r = "v_"
      r = stdr.str_concat(r, name)
      <- r
    if !stdr.is_null(g_global_def_names[name]) || !stdr.is_null(g_def_types[name])
      <- mangle_def(cask_name, name)
    -- Check if this ident is a known function (used as a value, not called)
    let ?fkey = cask_name
    fkey = stdr.str_concat(fkey, ".")
    fkey = stdr.str_concat(fkey, name)
    let fn_arity = g_all_funs[fkey]
    if !stdr.is_null(fn_arity)
      -- Emit function value wrapper: YV_FN(yi_fn_new(__fnwrap_mod_name, arity))
      let ?r = "YV_FN(yi_fn_new(__fnwrap_"
      r = stdr.str_concat(r, cask_name)
      r = stdr.str_concat(r, "_")
      r = stdr.str_concat(r, name)
      r = stdr.str_concat(r, ", ")
      r = stdr.str_concat(r, stdr.str(fn_arity))
      r = stdr.str_concat(r, "))")
      <- r
    -- Local variable reference; the C name is v_<name>
    let ?r = "v_"
    r = stdr.str_concat(r, name)
    <- r

  if et == "lambda"
    <- emit_lambda_expr(e, cask_name)

  if et == "unary"
    let ok = "op"
    let rk = "operand"
    let op = e[ok] ?? ""
    let operand = emit_flat_arg(e[rk], emit_expr(e[rk], cask_name))
    if op == "bang"
      let ?r = "YV_BOOL(!yis_as_bool("
      r = stdr.str_concat(r, operand)
      r = stdr.str_concat(r, "))")
      <- r
    if op == "minus"
      let ?r = "yis_neg("
      r = stdr.str_concat(r, operand)
      r = stdr.str_concat(r, ")")
      <- r
    if op == "hash"
      let ?r = "YV_INT(stdr_len("
      r = stdr.str_concat(r, operand)
      r = stdr.str_concat(r, "))")
      <- r
    <- operand

  if et == "binop"
    let ok = "op"
    let lk = "left"
    let rk = "right"
    let op = e[ok] ?? ""
    if op == "qq"
      let ?r = "({ YisVal __coalesce = "
      r = stdr.str_concat(r, emit_owned_expr(e[lk], cask_name))
      r = stdr.str_concat(r, "; if (__coalesce.tag == EVT_NULL) { yis_release_val(__coalesce); __coalesce = ")
      r = stdr.str_concat(r, emit_owned_expr(e[rk], cask_name))
      r = stdr.str_concat(r, "; } __coalesce; })")
      <- r
    if op == "ampamp" || op == "barbar"
      let ?r = "({ YisVal __bool_left = "
      r = stdr.str_concat(r, emit_owned_expr(e[lk], cask_name))
      r = stdr.str_concat(r, "; bool __bool_result = yis_as_bool(__bool_left); yis_release_val(__bool_left); if (")
      if op == "barbar" { r = stdr.str_concat(r, "!") }
      r = stdr.str_concat(r, "__bool_result) { YisVal __bool_right = ")
      r = stdr.str_concat(r, emit_owned_expr(e[rk], cask_name))
      r = stdr.str_concat(r, "; __bool_result = yis_as_bool(__bool_right); yis_release_val(__bool_right); } YV_BOOL(__bool_result); })")
      <- r
    let left = emit_flat_arg(e[lk], emit_expr(e[lk], cask_name))
    let right = emit_flat_arg(e[rk], emit_expr(e[rk], cask_name))
    if op == "plus" { <- emit_binop_call("yis_add", left, right) }
    if op == "minus" { <- emit_binop_call("yis_sub", left, right) }
    if op == "star" { <- emit_binop_call("yis_mul", left, right) }
    if op == "slash" { <- emit_binop_call("yis_div", left, right) }
    if op == "percent" { <- emit_binop_call("yis_mod", left, right) }
    if op == "eqeq" { <- emit_binop_call("yis_eq", left, right) }
    if op == "ne" { <- emit_binop_call("yis_ne", left, right) }
    if op == "lt" { <- emit_binop_call("yis_lt", left, right) }
    if op == "le" { <- emit_binop_call("yis_le", left, right) }
    if op == "gt" { <- emit_binop_call("yis_gt", left, right) }
    if op == "ge" { <- emit_binop_call("yis_ge", left, right) }
    <- "YV_NULLV"

  if et == "call"
    let fk = "func"
    let ak = "args"
    let func = e[fk]
    let args = e[ak] ?? []: [any]
    let func_tag = func[tag] ?? ""
    -- Check for member call: obj.method(args) -> e.g. stdr_write(args)
    if func_tag == "member"
      <- emit_member_call(func, args, cask_name)
    -- Direct function call: name(args)
    if func_tag == "ident"
      let nk = "name"
      let fname = func[nk] ?? ""
      if !stdr.is_null(g_scope_names[fname])
        let ?fexpr = "v_"
        fexpr = stdr.str_concat(fexpr, fname)
        <- emit_value_call(emit_flat_arg(func, fexpr), args, cask_name)
      if !stdr.is_null(g_global_def_names[fname]) || !stdr.is_null(g_def_types[fname])
        <- emit_value_call(emit_flat_arg(func, mangle_def(cask_name, fname)), args, cask_name)
      if fname == "write"
        let ?r = "stdr_write("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "writef"
        let nwargs = stdr.len(args)
        if nwargs == 1
          -- Single arg writef: treat as write (interpolation already resolved)
          let ?r = "stdr_write("
          r = emit_args(args, r, cask_name)
          r = stdr.str_concat(r, ")")
          <- r
        let ?r = "stdr_writef_args("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "args"
        <- "stdr_args()"
      if fname == "read_line"
        <- "YV_STR(stdr_read_line())"
      if fname == "len"
        let ?r = "YV_INT(stdr_len("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, "))")
        <- r
      if fname == "str"
        let ?r = "YV_STR(stdr_to_string("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, "))")
        <- r
      if fname == "num"
        let ?r = "YV_INT(stdr_num("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, "))")
        <- r
      if fname == "is_null"
        let ?r = "YV_BOOL(stdr_is_null("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, "))")
        <- r
      if fname == "read_text_file"
        let ?r = "stdr_read_text_file("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "write_text_file"
        let ?r = "stdr_write_text_file("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "run_command"
        let ?r = "stdr_run_command("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__write"
        let ?r = "stdr_write("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__writef"
        let ?r = "stdr_writef_args("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__read_line"
        <- "YV_STR(stdr_read_line())"
      if fname == "__readf_parse"
        let ?r = "stdr_readf_parse("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__len"
        let ?r = "YV_INT(stdr_len("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, "))")
        <- r
      if fname == "__num"
        let ?r = "YV_INT(stdr_num("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, "))")
        <- r
      if fname == "__slice"
        let a0 = emit_flat_arg(args[0], emit_expr(args[0], cask_name))
        let a1 = emit_flat_arg(args[1], emit_expr(args[1], cask_name))
        let a2 = emit_flat_arg(args[2], emit_expr(args[2], cask_name))
        let ?r = "stdr_slice("
        r = stdr.str_concat(r, a0)
        r = stdr.str_concat(r, ", yis_as_int(")
        r = stdr.str_concat(r, a1)
        r = stdr.str_concat(r, "), yis_as_int(")
        r = stdr.str_concat(r, a2)
        r = stdr.str_concat(r, "))")
        <- r
      if fname == "__concat"
        let ?r = "stdr_array_concat("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__str_concat"
        let ?r = "stdr_str_concat("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__char_code"
        let ?r = "YV_INT(stdr_char_code("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, "))")
        <- r
      if fname == "__parse_hex"
        let ?r = "stdr_parse_hex("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__char_from_code"
        let ?r = "stdr_char_from_code("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__floor"
        let ?r = "stdr_floor("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__ceil"
        let ?r = "stdr_ceil("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__keys"
        let ?r = "stdr_keys("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__replace"
        let ?r = "stdr_replace("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__read_text_file"
        let ?r = "stdr_read_text_file("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__getenv" || fname == "__temp_file" || fname == "__hash_text" || fname == "__realpath"
        let ?r = stdr.str_concat("stdr_", stdr.slice(fname, 2, stdr.len(fname)))
        r = stdr.str_concat(r, "(")
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__write_text_file"
        let ?r = "stdr_write_text_file("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__ensure_dir"
        let ?r = "stdr_ensure_dir("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__remove_file"
        let ?r = "stdr_remove_file("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__move_file"
        let ?r = "stdr_move_file("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__find_files"
        let ?r = "stdr_find_files("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__prune_files_older_than"
        let ?r = "stdr_prune_files_older_than("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__open_file_dialog"
        let ?r = "stdr_open_file_dialog("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__open_folder_dialog"
        let ?r = "stdr_open_folder_dialog("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__save_file_dialog"
        let ?r = "stdr_save_file_dialog("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__run_command"
        let ?r = "stdr_run_command("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__exit_process"
        let ?r = "stdr_exit_process("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__file_exists"
        let ?r = "stdr_file_exists("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__file_mtime"
        let ?r = "stdr_file_mtime("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__file_mtime_ns"
        let ?r = "stdr_file_mtime_ns("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__getcwd"
        <- "stdr_getcwd()"
      if fname == "__home_dir"
        <- "stdr_home_dir()"
      if fname == "__unix_time"
        <- "stdr_unix_time()"
      if fname == "__current_year"
        <- "stdr_current_year()"
      if fname == "__current_month"
        <- "stdr_current_month()"
      if fname == "__current_day"
        <- "stdr_current_day()"
      if fname == "__weekday"
        let ?r = "stdr_weekday("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__iso_to_epoch"
        let ?r = "stdr_iso_to_epoch("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if fname == "__args"
        <- "stdr_args()"
      -- Extern stub: __ prefix → call by raw name (no mangling)
      if stdr.len(fname) >= 2
        if stdr.slice(fname, 0, 2) == "__"
          let ?r = fname
          r = stdr.str_concat(r, "(")
          r = emit_args(args, r, cask_name)
          r = stdr.str_concat(r, ")")
          <- r
      -- Class constructor: ClassName(args) → allocate struct, init fields, call init()
      let cls_info2 = g_classes[fname] ?? []: [string => any]
      let cls_fields2 = cls_info2["fields"] ?? []: [any]
      if stdr.len(cls_fields2) > 0
        let cls_mod2 = cls_info2["mod"] ?? cask_name
        let nf2 = stdr.len(cls_fields2)
        let na2 = stdr.len(args)
        -- Generate unique temp name
        g_tmp_counter = g_tmp_counter + 1
        let ?obj_var = "_obj"
        obj_var = stdr.str_concat(obj_var, str(g_tmp_counter))
        let ?r = "({\n"
        -- Allocate
        r = stdr.str_concat(r, "    YisObj_")
        r = stdr.str_concat(r, cls_mod2)
        r = stdr.str_concat(r, "_")
        r = stdr.str_concat(r, fname)
        r = stdr.str_concat(r, "* ")
        r = stdr.str_concat(r, obj_var)
        r = stdr.str_concat(r, " = (YisObj_")
        r = stdr.str_concat(r, cls_mod2)
        r = stdr.str_concat(r, "_")
        r = stdr.str_concat(r, fname)
        r = stdr.str_concat(r, "*)yis_obj_new(sizeof(YisObj_")
        r = stdr.str_concat(r, cls_mod2)
        r = stdr.str_concat(r, "_")
        r = stdr.str_concat(r, fname)
        r = stdr.str_concat(r, "), yis_drop_")
        r = stdr.str_concat(r, cls_mod2)
        r = stdr.str_concat(r, "_")
        r = stdr.str_concat(r, fname)
        r = stdr.str_concat(r, ");\n")
        -- Init all fields to YV_NULLV
        let ?fi2 = 0
        for (; fi2 < nf2; fi2 = fi2 + 1)
          let fd2 = cls_fields2[fi2]
          let fn4 = fd2["name"] ?? ""
          r = stdr.str_concat(r, "    ")
          r = stdr.str_concat(r, obj_var)
          r = stdr.str_concat(r, "->f_")
          r = stdr.str_concat(r, fn4)
          r = stdr.str_concat(r, " = YV_NULLV;\n")
        -- Assign positional args to fields
        let ?ai = 0
        for (; ai < na2 && ai < nf2; ai = ai + 1)
          let fd2 = cls_fields2[ai]
          let fn4 = fd2["name"] ?? ""
          r = stdr.str_concat(r, "    yis_move_into(&")
          r = stdr.str_concat(r, obj_var)
          r = stdr.str_concat(r, "->f_")
          r = stdr.str_concat(r, fn4)
          r = stdr.str_concat(r, ", ")
          r = stdr.str_concat(r, emit_flat_arg(args[ai], emit_expr(args[ai], cask_name)))
          r = stdr.str_concat(r, ");\n")
        -- Wrap in YisVal
        r = stdr.str_concat(r, "    YisVal ")
        r = stdr.str_concat(r, obj_var)
        r = stdr.str_concat(r, "_v = YV_OBJ((YisObj*)")
        r = stdr.str_concat(r, obj_var)
        r = stdr.str_concat(r, ");\n")
        -- Call init() if it exists
        let cls_methods2 = cls_info2["methods"] ?? []: [string => any]
        if !stdr.is_null(cls_methods2["init"])
          r = stdr.str_concat(r, "    ")
          r = stdr.str_concat(r, mangle_method(cls_mod2, fname, "init"))
          r = stdr.str_concat(r, "(")
          r = stdr.str_concat(r, obj_var)
          r = stdr.str_concat(r, "_v")
          -- Pass remaining args to init (after fields consumed)
          let ?ii2 = nf2
          for (; ii2 < na2; ii2 = ii2 + 1)
            r = stdr.str_concat(r, ", ")
            r = stdr.str_concat(r, emit_flat_arg(args[ii2], emit_expr(args[ii2], cask_name)))
          r = stdr.str_concat(r, ");\n")
        r = stdr.str_concat(r, "    ")
        r = stdr.str_concat(r, obj_var)
        r = stdr.str_concat(r, "_v;\n})")
        <- r
      let ?origin_mod = cask_name
      let cur_mod_funs = g_mod_funs[cask_name] ?? []: [string => any]
      if stdr.is_null(cur_mod_funs[fname])
        let gf = stdr.str(g_fun_origin[fname] ?? "")
        if stdr.len(gf) > 0 { origin_mod = gf }
      let ?r = mangle_name(origin_mod, fname)
      r = stdr.str_concat(r, "(")
      r = emit_args(args, r, cask_name)
      r = stdr.str_concat(r, ")")
      <- r
    -- Fallback: any expression used as a function (e.g. dict["key"](args))
    let fallback_fexpr = emit_flat_arg(func, emit_expr(func, cask_name))
    <- emit_value_call(fallback_fexpr, args, cask_name)

  if et == "bang_call"
    -- Bang-method call: recv !method args -> yis_cask_method(recv, args...)
    let rk = "recv"
    let mnk = "name"
    let ak = "args"
    let recv_c = emit_flat_arg(e[rk], emit_expr(e[rk], cask_name))
    let mname = e[mnk] ?? ""
    let bargs = e[ak] ?? []: [any]
    let ?r = mangle_name(cask_name, mname)
    r = stdr.str_concat(r, "(")
    r = stdr.str_concat(r, recv_c)
    let ?nba = stdr.len(bargs)
    let ?bi = 0
    for (; bi < nba; bi = bi + 1)
      r = stdr.str_concat(r, ", ")
      r = stdr.str_concat(r, emit_flat_arg(bargs[bi], emit_expr(bargs[bi], cask_name)))
    r = stdr.str_concat(r, ")")
    <- r

  if et == "member"
    -- Member access without call: obj.field -> treat as dict get or struct field
    let ok = "obj"
    let fk = "field"
    let obj_raw = e[ok]
    let field = e[fk] ?? ""
    -- Check if this is a brought-module constant access (e.g., gst.EVENT_EOS)
    let mem_obj_tag = dict_get_or(obj_raw, "tag", "") ?? ""
    if mem_obj_tag == "ident"
      let mem_obj_name = dict_get_or(obj_raw, "name", "") ?? ""
      if !stdr.is_null(g_bring_names[mem_obj_name]) && mem_obj_name != cask_name
        let ?r = "({ YisVal __constant = "
        r = stdr.str_concat(r, mangle_def(mem_obj_name, field))
        r = stdr.str_concat(r, "; yis_retain_val(__constant); __constant; })")
        <- r
    -- Check if receiver is a class with struct fields
    let mem_recv_type = type_of_expr(obj_raw, cask_name)
    let mem_cls_info = g_classes[mem_recv_type] ?? []: [string => any]
    let mem_field_map = mem_cls_info["field_map"] ?? []: [string => any]
    let mem_finfo = mem_field_map[field] ?? []: [string => any]
    let mem_fname = mem_finfo["name"] ?? ""
    if stdr.len(mem_fname) > 0
      -- Struct field access: ((YisObj_mod_Cls*)obj.as.p)->f_field
      let mem_cls_mod = mem_cls_info["mod"] ?? cask_name
      let obj_c = emit_flat_arg(e[ok], emit_expr(e[ok], cask_name))
      let ?r = "({\n    YisVal _mfr = ((YisObj_"
      r = stdr.str_concat(r, mem_cls_mod)
      r = stdr.str_concat(r, "_")
      r = stdr.str_concat(r, mem_recv_type)
      r = stdr.str_concat(r, "*)(")
      r = stdr.str_concat(r, obj_c)
      r = stdr.str_concat(r, ").as.p)->f_")
      r = stdr.str_concat(r, field)
      r = stdr.str_concat(r, ";\n    yis_retain_val(_mfr);\n    _mfr;\n})")
      <- r
    let obj_c = emit_flat_arg(e[ok], emit_expr(e[ok], cask_name))
    let ?key_ast = []: [string => any]
    key_ast["tag"] = "str"
    key_ast["value"] = field
    let key_c = emit_flat_arg(key_ast, emit_expr(key_ast, cask_name))
    let ?r = "yis_dict_member_get("
    r = stdr.str_concat(r, obj_c)
    r = stdr.str_concat(r, ", ")
    r = stdr.str_concat(r, key_c)
    r = stdr.str_concat(r, ")")
    <- r

  if et == "index"
    let ok = "obj"
    let ik = "idx"
    let obj_c = emit_flat_arg(e[ok], emit_expr(e[ok], cask_name))
    let idx_c = emit_flat_arg(e[ik], emit_expr(e[ik], cask_name))
    -- Runtime dispatch: if index is int -> array, if string -> dict
    let ?r = "yis_index("
    r = stdr.str_concat(r, obj_c)
    r = stdr.str_concat(r, ", ")
    r = stdr.str_concat(r, idx_c)
    r = stdr.str_concat(r, ")")
    <- r

  if et == "assign"
    let lhs = e["lhs"]
    let rhs = e["rhs"]
    let lhs_tag = lhs["tag"] ?? ""
    let ?slot = ""
    let ?operation = ""
    if lhs_tag == "ident"
      let name = lhs["name"] ?? ""
      if !stdr.is_null(g_global_def_names[name]) && stdr.is_null(g_scope_names[name])
        slot = mangle_def(cask_name, name)
      else
        slot = stdr.str_concat("v_", name)
    elif lhs_tag == "index"
      let obj_c = emit_flat_arg(lhs["obj"], emit_expr(lhs["obj"], cask_name))
      let idx_c = emit_flat_arg(lhs["idx"], emit_expr(lhs["idx"], cask_name))
      operation = stdr.str_concat("yis_index_set(", obj_c)
      operation = stdr.str_concat(operation, ", ")
      operation = stdr.str_concat(operation, idx_c)
    elif lhs_tag == "member"
      let obj = lhs["obj"]
      let field = lhs["field"] ?? ""
      let obj_c = emit_flat_arg(obj, emit_expr(obj, cask_name))
      let recv_type = type_of_expr(obj, cask_name)
      let cls = g_classes[recv_type] ?? []: [string => any]
      let fields = cls["field_map"] ?? []: [string => any]
      let finfo = fields[field] ?? []: [string => any]
      if stdr.len(finfo["name"] ?? "") > 0
        slot = stdr.str_concat("((YisObj_", cls["mod"] ?? cask_name)
        slot = stdr.str_concat(slot, "_")
        slot = stdr.str_concat(slot, recv_type)
        slot = stdr.str_concat(slot, "*)")
        slot = stdr.str_concat(slot, obj_c)
        slot = stdr.str_concat(slot, ".as.p)->f_")
        slot = stdr.str_concat(slot, field)
      else
        let ?key_ast = []: [string => any]
        key_ast["tag"] = "str"
        key_ast["value"] = field
        let key_c = emit_flat_arg(key_ast, emit_expr(key_ast, cask_name))
        operation = stdr.str_concat("yis_dict_member_set(", obj_c)
        operation = stdr.str_concat(operation, ", ")
        operation = stdr.str_concat(operation, key_c)
    let rhs_c = emit_flat_arg(rhs, emit_expr(rhs, cask_name))
    let ?r = "({ "
    if stdr.len(slot) > 0
      r = stdr.str_concat(r, "yis_move_into(&")
      r = stdr.str_concat(r, slot)
    elif stdr.len(operation) > 0
      r = stdr.str_concat(r, operation)
    else
      r = stdr.str_concat(r, "(void)(")
    if stdr.len(slot) > 0 || stdr.len(operation) > 0
      r = stdr.str_concat(r, ", ")
    r = stdr.str_concat(r, rhs_c)
    r = stdr.str_concat(r, "); yis_retain_val(")
    r = stdr.str_concat(r, rhs_c)
    r = stdr.str_concat(r, "); ")
    r = stdr.str_concat(r, rhs_c)
    r = stdr.str_concat(r, "; })")
    <- r

  if et == "array"
    let ek = "elems"
    let elems = e[ek] ?? []: [any]
    <- emit_array_literal(elems, cask_name)

  if et == "dict"
    let ek = "entries"
    let entries = e[ek] ?? []: [any]
    <- emit_dict_literal(entries, cask_name)

  if et == "if_expr"
    let ck = "cond"
    let tk = "then"
    let ek = "else"
    let cond_c = emit_flat_arg(e[ck], emit_expr(e[ck], cask_name))
    let then_c = emit_owned_expr(e[tk], cask_name)
    let else_c = emit_owned_expr(e[ek], cask_name)
    let ?r = "(yis_as_bool("
    r = stdr.str_concat(r, cond_c)
    r = stdr.str_concat(r, ") ? (")
    r = stdr.str_concat(r, then_c)
    r = stdr.str_concat(r, ") : (")
    r = stdr.str_concat(r, else_c)
    r = stdr.str_concat(r, "))")
    <- r

  if et == "match"
    let sk = "scrut"
    let ak = "arms"
    let scrut_c = emit_owned_expr(e[sk], cask_name)
    let arms = e[ak] ?? []: [any]
    let narms = stdr.len(arms)
    -- Use GCC statement expression: ({ ... })
    let ?r = "({ YisVal __scrut = "
    r = stdr.str_concat(r, scrut_c)
    r = stdr.str_concat(r, "; YisVal __mres = YV_NULLV; int __matched = 0;\n")
    let ?ai = 0
    for (; ai < narms; ai = ai + 1)
      let arm = arms[ai]
      let pat = arm["pat"]
      let arm_expr = arm["expr"]
      let ptag = pat[tag] ?? ""
      if ptag == "pat_wild"
        r = stdr.str_concat(r, "  if (!__matched) { __matched = 1; __mres = ")
        r = stdr.str_concat(r, emit_owned_expr(arm_expr, cask_name))
        r = stdr.str_concat(r, "; }\n")
      elif ptag == "pat_ident"
        let pname = pat["name"] ?? ""
        r = stdr.str_concat(r, "  if (!__matched) { __matched = 1; YisVal v_")
        r = stdr.str_concat(r, pname)
        r = stdr.str_concat(r, " = __scrut; yis_retain_val(v_")
        r = stdr.str_concat(r, pname)
        r = stdr.str_concat(r, "); __mres = ")
        r = stdr.str_concat(r, emit_owned_expr(arm_expr, cask_name))
        r = stdr.str_concat(r, "; yis_release_val(v_")
        r = stdr.str_concat(r, pname)
        r = stdr.str_concat(r, "); }\n")
      elif ptag == "pat_int"
        let pval = pat["value"] ?? "0"
        r = stdr.str_concat(r, "  if (!__matched && yis_as_bool(yis_eq(__scrut, YV_INT(")
        if pval == "-9223372036854775808"
          r = stdr.str_concat(r, "(-9223372036854775807LL - 1)")
        else
          r = stdr.str_concat(r, pval)
        r = stdr.str_concat(r, ")))) { __matched = 1; __mres = ")
        r = stdr.str_concat(r, emit_owned_expr(arm_expr, cask_name))
        r = stdr.str_concat(r, "; }\n")
      elif ptag == "pat_str"
        let pval = pat["value"] ?? ""
        r = stdr.str_concat(r, "  if (!__matched && ({ YisVal __pat = YV_STR(stdr_str_from_slice(")
        r = stdr.str_concat(r, _c_quote(pval))
        r = stdr.str_concat(r, ", ")
        r = stdr.str_concat(r, stdr.str(stdr.len(pval)))
        r = stdr.str_concat(r, ")); bool __equal = yis_as_bool(yis_eq(__scrut, __pat)); yis_release_val(__pat); __equal; })) { __matched = 1; __mres = ")
        r = stdr.str_concat(r, emit_owned_expr(arm_expr, cask_name))
        r = stdr.str_concat(r, "; }\n")
      elif ptag == "pat_bool"
        let pval = pat["value"]
        let ?bstr = "false"
        if pval { bstr = "true" }
        r = stdr.str_concat(r, "  if (!__matched && yis_as_bool(yis_eq(__scrut, YV_BOOL(")
        r = stdr.str_concat(r, bstr)
        r = stdr.str_concat(r, ")))) { __matched = 1; __mres = ")
        r = stdr.str_concat(r, emit_owned_expr(arm_expr, cask_name))
        r = stdr.str_concat(r, "; }\n")
      elif ptag == "pat_null"
        r = stdr.str_concat(r, "  if (!__matched && __scrut.tag == EVT_NULL) { __matched = 1; __mres = ")
        r = stdr.str_concat(r, emit_owned_expr(arm_expr, cask_name))
        r = stdr.str_concat(r, "; }\n")
    r = stdr.str_concat(r, "  yis_release_val(__scrut); __mres; })")
    <- r

  <- "YV_NULLV"
;

-- Helper: emit member call with fallback for unary-wrapped receiver.
: emit_member_call(member_func = any, args = any, cask_name = string) (( string ))
  let obj = dict_get_or(member_func, "obj", null)
  let field = dict_get_or(member_func, "field", "") ?? ""

  let obj_tag = dict_get_or(obj, "tag", "") ?? ""

  if obj_tag == "ident"
    let obj_name = dict_get_or(obj, "name", "") ?? ""

    if obj_name == "stdr"
      if field == "str"
        let ?r = "YV_STR(stdr_to_string("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, "))")
        <- r
      if field == "num"
        let ?r = "YV_INT(stdr_num("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, "))")
        <- r
      if field == "len"
        let ?r = "YV_INT(stdr_len("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, "))")
        <- r
      if field == "char_code"
        let ?r = "YV_INT(stdr_char_code("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, "))")
        <- r
      if field == "is_null"
        let ?r = "YV_BOOL(stdr_is_null("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, "))")
        <- r
      if field == "read_line"
        let ?r = "YV_STR(stdr_read_line("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, "))")
        <- r
      if field == "writef"
        let ?r = "stdr_writef_args("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if field == "readf_parse"
        let ?r = "stdr_readf_parse("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if field == "concat"
        let ?r = "stdr_array_concat("
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      if field == "push"
        let a0 = emit_flat_arg(args[0], emit_expr(args[0], cask_name))
        let a1 = emit_flat_arg(args[1], emit_expr(args[1], cask_name))
        let ?r = "stdr_push("
        r = stdr.str_concat(r, a0)
        r = stdr.str_concat(r, ", ")
        r = stdr.str_concat(r, a1)
        r = stdr.str_concat(r, ")")
        <- r
      if field == "slice"
        let a0 = emit_flat_arg(args[0], emit_expr(args[0], cask_name))
        let a1 = emit_flat_arg(args[1], emit_expr(args[1], cask_name))
        let a2 = emit_flat_arg(args[2], emit_expr(args[2], cask_name))
        let ?r = "stdr_slice("
        r = stdr.str_concat(r, a0)
        r = stdr.str_concat(r, ", yis_as_int(")
        r = stdr.str_concat(r, a1)
        r = stdr.str_concat(r, "), yis_as_int(")
        r = stdr.str_concat(r, a2)
        r = stdr.str_concat(r, "))")
        <- r
      if field == "str_at"
        let a0 = emit_flat_arg(args[0], emit_expr(args[0], cask_name))
        let a1 = emit_flat_arg(args[1], emit_expr(args[1], cask_name))
        let ?r = "stdr_str_at("
        r = stdr.str_concat(r, a0)
        r = stdr.str_concat(r, ", yis_as_int(")
        r = stdr.str_concat(r, a1)
        r = stdr.str_concat(r, "))")
        <- r
      let stdr_funs = dict_get_or(g_mod_funs, "stdr", null)
      if !stdr.is_null(dict_get_or(stdr_funs, field, null))
        let ?r = mangle_name("stdr", field)
        r = stdr.str_concat(r, "(")
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r
      let ?r = "stdr_"
      r = stdr.str_concat(r, field)
      r = stdr.str_concat(r, "(")
      r = emit_args(args, r, cask_name)
      r = stdr.str_concat(r, ")")
      <- r

    if is_external_module(obj_name)
      let ?r = mangle_name(obj_name, field)
      r = stdr.str_concat(r, "(")
      r = emit_args(args, r, cask_name)
      r = stdr.str_concat(r, ")")
      <- r

    -- Check if obj_name is a locally-brought module
    if !stdr.is_null(g_bring_names[obj_name]) && obj_name != cask_name
      -- Check for cross-module constructor: mod.ClassName(args) where ClassName has fields
      let xm_cls_info = g_classes[field] ?? []: [string => any]
      let xm_cls_fields = xm_cls_info["fields"] ?? []: [any]
      if stdr.len(xm_cls_fields) > 0
        let xm_cls_mod = xm_cls_info["mod"] ?? obj_name
        let xm_nf = stdr.len(xm_cls_fields)
        let xm_na = stdr.len(args)
        g_tmp_counter = g_tmp_counter + 1
        let ?xm_var = "_obj"
        xm_var = stdr.str_concat(xm_var, str(g_tmp_counter))
        let ?r = "({\n"
        r = stdr.str_concat(r, "    YisObj_")
        r = stdr.str_concat(r, xm_cls_mod)
        r = stdr.str_concat(r, "_")
        r = stdr.str_concat(r, field)
        r = stdr.str_concat(r, "* ")
        r = stdr.str_concat(r, xm_var)
        r = stdr.str_concat(r, " = (YisObj_")
        r = stdr.str_concat(r, xm_cls_mod)
        r = stdr.str_concat(r, "_")
        r = stdr.str_concat(r, field)
        r = stdr.str_concat(r, "*)yis_obj_new(sizeof(YisObj_")
        r = stdr.str_concat(r, xm_cls_mod)
        r = stdr.str_concat(r, "_")
        r = stdr.str_concat(r, field)
        r = stdr.str_concat(r, "), yis_drop_")
        r = stdr.str_concat(r, xm_cls_mod)
        r = stdr.str_concat(r, "_")
        r = stdr.str_concat(r, field)
        r = stdr.str_concat(r, ");\n")
        let ?xm_fi = 0
        for (; xm_fi < xm_nf; xm_fi = xm_fi + 1)
          let xm_fd = xm_cls_fields[xm_fi]
          let xm_fn = xm_fd["name"] ?? ""
          r = stdr.str_concat(r, "    ")
          r = stdr.str_concat(r, xm_var)
          r = stdr.str_concat(r, "->f_")
          r = stdr.str_concat(r, xm_fn)
          if xm_fi < xm_na
            r = stdr.str_concat(r, " = YV_NULLV;\n    yis_move_into(&")
            r = stdr.str_concat(r, xm_var)
            r = stdr.str_concat(r, "->f_")
            r = stdr.str_concat(r, xm_fn)
            r = stdr.str_concat(r, ", ")
            r = stdr.str_concat(r, emit_flat_arg(args[xm_fi], emit_expr(args[xm_fi], cask_name)))
            r = stdr.str_concat(r, ");\n")
          else
            r = stdr.str_concat(r, " = YV_NULLV;\n")
        r = stdr.str_concat(r, "    YisVal ")
        r = stdr.str_concat(r, xm_var)
        r = stdr.str_concat(r, "_v = YV_OBJ((YisObj*)")
        r = stdr.str_concat(r, xm_var)
        r = stdr.str_concat(r, ");\n")
        let xm_methods = xm_cls_info["methods"] ?? []: [string => any]
        if !stdr.is_null(xm_methods["init"])
          r = stdr.str_concat(r, "    ")
          r = stdr.str_concat(r, mangle_method(xm_cls_mod, field, "init"))
          r = stdr.str_concat(r, "(")
          r = stdr.str_concat(r, xm_var)
          r = stdr.str_concat(r, "_v")
          let ?xm_ii = xm_nf
          for (; xm_ii < xm_na; xm_ii = xm_ii + 1)
            r = stdr.str_concat(r, ", ")
            r = stdr.str_concat(r, emit_flat_arg(args[xm_ii], emit_expr(args[xm_ii], cask_name)))
          r = stdr.str_concat(r, ");\n")
        r = stdr.str_concat(r, "    ")
        r = stdr.str_concat(r, xm_var)
        r = stdr.str_concat(r, "_v;\n})")
        <- r
      let mod_funs = dict_get_or(g_mod_funs, obj_name, null)
      if !stdr.is_null(mod_funs)
        let ?r = mangle_name(obj_name, field)
        r = stdr.str_concat(r, "(")
        r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r

    let vtype_any = dict_get_or(g_var_types, obj_name, "")
    let ?vtype = stdr.str(vtype_any ?? "")
    if stdr.is_null(vtype) { vtype = "" }
    if stdr.len(vtype) == 0
      let dvt_any = dict_get_or(g_def_types, obj_name, "")
      vtype = stdr.str(dvt_any ?? "")
      if stdr.is_null(vtype) { vtype = "" }
    if stdr.len(vtype) > 0
      let cls_any = dict_get_or(g_classes, vtype, null)
      if !stdr.is_null(cls_any) && stdr.str(cls_any) == "[dict]"
        let cls_mod_any = dict_get_or(cls_any, "mod", "")
        let ?cls_mod = stdr.str(cls_mod_any ?? "")
        if stdr.is_null(cls_mod) { cls_mod = "" }

        let cls_methods = dict_get_or(cls_any, "methods", null)
        if !stdr.is_null(dict_get_or(cls_methods, field, null))
          let obj_c = emit_flat_arg(obj, emit_expr(obj, cask_name))
          let ?r = mangle_method(cls_mod, vtype, field)
          r = stdr.str_concat(r, "(")
          r = stdr.str_concat(r, obj_c)
          if stdr.len(args) > 0
            r = stdr.str_concat(r, ", ")
            r = emit_args(args, r, cask_name)
          r = stdr.str_concat(r, ")")
          <- r

        if stdr.len(cls_mod) > 0
          let mod_funs = dict_get_or(g_mod_funs, cls_mod, null)
          if !stdr.is_null(dict_get_or(mod_funs, field, null))
            let obj_c = emit_flat_arg(obj, emit_expr(obj, cask_name))
            let ?r = mangle_name(cls_mod, field)
            r = stdr.str_concat(r, "(")
            r = stdr.str_concat(r, obj_c)
            if stdr.len(args) > 0
              r = stdr.str_concat(r, ", ")
              r = emit_args(args, r, cask_name)
            r = stdr.str_concat(r, ")")
            <- r

    let local_funs = dict_get_or(g_mod_funs, cask_name, null)
    if !stdr.is_null(dict_get_or(local_funs, field, null))
      let obj_c = emit_flat_arg(obj, emit_expr(obj, cask_name))
      let ?r = mangle_name(cask_name, field)
      r = stdr.str_concat(r, "(")
      r = stdr.str_concat(r, obj_c)
      if stdr.len(args) > 0
        r = stdr.str_concat(r, ", ")
        r = emit_args(args, r, cask_name)
      r = stdr.str_concat(r, ")")
      <- r

    let ?r = "yis_"
    r = stdr.str_concat(r, obj_name)
    r = stdr.str_concat(r, "_")
    r = stdr.str_concat(r, field)
    r = stdr.str_concat(r, "(")
    r = emit_args(args, r, cask_name)
    r = stdr.str_concat(r, ")")
    <- r

  let expr_type = type_of_expr(obj, cask_name)
  if stdr.len(expr_type) > 0
    let cls_info = dict_get_or(g_classes, expr_type, null)
    if !stdr.is_null(cls_info)
      let cls_mod = dict_get_or(cls_info, "mod", "") ?? ""

      let cls_methods = dict_get_or(cls_info, "methods", null)
      if !stdr.is_null(dict_get_or(cls_methods, field, null))
        let obj_c = emit_flat_arg(obj, emit_expr(obj, cask_name))
        let ?r = mangle_method(cls_mod, expr_type, field)
        r = stdr.str_concat(r, "(")
        r = stdr.str_concat(r, obj_c)
        if stdr.len(args) > 0
          r = stdr.str_concat(r, ", ")
          r = emit_args(args, r, cask_name)
        r = stdr.str_concat(r, ")")
        <- r

      if stdr.len(cls_mod) > 0
        let mod_funs = dict_get_or(g_mod_funs, cls_mod, null)
        if !stdr.is_null(dict_get_or(mod_funs, field, null))
          let obj_c = emit_flat_arg(obj, emit_expr(obj, cask_name))
          let ?r = mangle_name(cls_mod, field)
          r = stdr.str_concat(r, "(")
          r = stdr.str_concat(r, obj_c)
          if stdr.len(args) > 0
            r = stdr.str_concat(r, ", ")
            r = emit_args(args, r, cask_name)
          r = stdr.str_concat(r, ")")
          <- r

  let obj_c = emit_flat_arg(obj, emit_expr(obj, cask_name))
  let ?r = mangle_name(cask_name, field)
  r = stdr.str_concat(r, "(")
  r = stdr.str_concat(r, obj_c)
  if stdr.len(args) > 0
    r = stdr.str_concat(r, ", ")
    r = emit_args(args, r, cask_name)
  r = stdr.str_concat(r, ")")
  <- r
;

-- Helper: emit a binary operation call "func(left, right)"
: emit_binop_call(func = string, left = string, right = string) (( string ))
  let ?r = func
  r = stdr.str_concat(r, "(")
  r = stdr.str_concat(r, left)
  r = stdr.str_concat(r, ", ")
  r = stdr.str_concat(r, right)
  r = stdr.str_concat(r, ")")
  <- r
;

-- Helper: emit comma-separated args into string r.
: emit_args(args = any, r = string, cask_name = string) (( string ))
  let ?n = 0
  n = stdr.len(args)
  let ?parts = []: [any]
  stdr.push(parts, r)
  let ?k = 0
  for (; k < n; k = k + 1)
    if k > 0 { stdr.push(parts, ", ") }
    let ac = emit_expr(args[k], cask_name)
    stdr.push(parts, emit_flat_arg(args[k], ac))
  <- stdr.join(parts)
;

-- Helper: call a function value expression via runtime yis_call.
: emit_value_call(func_expr = string, args = any, cask_name = string) (( string ))
  let ?n = 0
  n = stdr.len(args)
  if n == 0
    let ?parts0 = []: [any]
    stdr.push(parts0, "yis_call(")
    stdr.push(parts0, func_expr)
    stdr.push(parts0, ", 0, NULL)")
    <- stdr.join(parts0)
  let ?parts = []: [any]
  stdr.push(parts, "({ YisVal __argv[")
  stdr.push(parts, stdr.str(n))
  stdr.push(parts, "]; ")
  let ?k = 0
  for (; k < n; k = k + 1)
    stdr.push(parts, "__argv[")
    stdr.push(parts, stdr.str(k))
    stdr.push(parts, "] = ")
    let ac = emit_expr(args[k], cask_name)
    stdr.push(parts, emit_flat_arg(args[k], ac))
    stdr.push(parts, "; ")
  stdr.push(parts, "yis_call(")
  stdr.push(parts, func_expr)
  stdr.push(parts, ", ")
  stdr.push(parts, stdr.str(n))
  stdr.push(parts, ", __argv); })")
  <- stdr.join(parts)
;

-- Emit C statements from a list of stmt AST nodes.
-- Returns a string of C code (indented).
: emit_stmts(stmts = any, indent = string, cask_name = string) (( string ))
  let ?n = 0
  n = stdr.len(stmts)
  let ?parts = []: [any]
  let ?k = 0
  for (; k < n; k = k + 1)
    let s = stmts[k]
    if !stdr.is_null(s)
      let sline = stdr.num(s["line"] ?? 0)
      if sline > 0 && stdr.len(g_emit_file_path) > 0 && sline != g_last_line_num
        g_last_line_num = sline
        let ?ld = "#line "
        ld = stdr.str_concat(ld, stdr.str(sline))
        ld = stdr.str_concat(ld, " ")
        ld = stdr.str_concat(ld, _c_quote(g_emit_file_path))
        ld = stdr.str_concat(ld, "\n")
        stdr.push(parts, ld)
    stdr.push(parts, emit_stmt(s, indent, cask_name))
  <- stdr.join(parts)
;

-- Check whether an expression produces a fresh +1 value (caller owns).
-- Fresh expressions: function calls, literals, array/dict/lambda constructors.
-- For these, the let binding does NOT need yis_retain_val (already ref=1).
: is_fresh_expr(e = any) (( bool ))
    if stdr.is_null(e) { <- false }
    let tk = "tag"
    let et = e[tk] ?? ""
    if et == "call" { <- true }
    if et == "bang_call" { <- true }
    if et == "str" { <- true }
    if et == "interp" { <- true }
    if et == "array" { <- true }
    if et == "dict" { <- true }
    if et == "lambda" { <- true }
    if et == "index" { <- true }
    if et == "member" { <- true }
    if et == "if_expr" { <- true }
    if et == "match" { <- true }
    if et == "binop" { <- true }
    if et == "assign" { <- true }
    if et == "ident"
      let name = e["name"] ?? ""
      if !stdr.is_null(g_scope_names[name]) { <- false }
      let key = stdr.str_concat(stdr.str_concat(g_cur_mod, "."), name)
      if !stdr.is_null(g_all_funs[key]) { <- true }
    <- false
;

-- Register a fresh call-arg into the flat-temp accumulator.
-- Returns a temp name (__ft0, __ft1, ...) for fresh args; otherwise returns arg_c as-is.
: emit_flat_arg(arg_ast = any, arg_c = string) (( string ))
    let n = g_flat_counter
    g_flat_counter = g_flat_counter + 1
    let ?tname = "__ft"
    tname = stdr.str_concat(tname, stdr.str(n))
    stdr.push(g_flat_names, tname)
    let ?owned_c = arg_c
    if !is_fresh_expr(arg_ast)
      owned_c = stdr.str_concat("({ YisVal __borrowed = ", arg_c)
      owned_c = stdr.str_concat(owned_c, "; yis_retain_val(__borrowed); __borrowed; })")
    stdr.push(g_flat_exprs, owned_c)
    <- tname
;

-- Emit YisVal declarations for all accumulated flat temps.
: flat_decls(indent = string) (( string ))
    let ?r = ""
    let n = stdr.len(g_flat_names)
    let ?i = 0
    for (; i < n; i = i + 1)
      r = stdr.str_concat(r, indent)
      r = stdr.str_concat(r, "YisVal ")
      r = stdr.str_concat(r, g_flat_names[i] ?? "")
      r = stdr.str_concat(r, " = ")
      r = stdr.str_concat(r, g_flat_exprs[i] ?? "")
      r = stdr.str_concat(r, ";\n")
    <- r
;

-- Emit yis_release_val for all accumulated flat temps (reverse order).
: flat_releases(indent = string) (( string ))
    let ?r = ""
    let n = stdr.len(g_flat_names)
    let ?i = n - 1
    for (; i >= 0; i = i - 1)
      r = stdr.str_concat(r, indent)
      r = stdr.str_concat(r, "yis_release_val(")
      r = stdr.str_concat(r, g_flat_names[i] ?? "")
      r = stdr.str_concat(r, ");\n")
    <- r
;

-- Emit one C statement from a stmt AST node.
: emit_stmt(s = any, indent = string, cask_name = string) (( string ))
  if stdr.is_null(s) { <- "" }
  let prev_fn_w = g_flat_names
  let prev_fe_w = g_flat_exprs
  g_flat_names = []: [any]
  g_flat_exprs = []: [any]
  let r_w = emit_stmt_core(s, indent, cask_name)
  let decls_w = flat_decls(indent)
  let frels_w = flat_releases(indent)
  g_flat_names = prev_fn_w
  g_flat_exprs = prev_fe_w
  let ?out_w = decls_w
  out_w = stdr.str_concat(out_w, r_w)
  out_w = stdr.str_concat(out_w, frels_w)
  <- out_w
;

: emit_stmt_core(s = any, indent = string, cask_name = string) (( string ))
  if stdr.is_null(s) { <- "" }
  let tag = "tag"
  let st = s[tag] ?? ""

  if st == "let"
    let nk = "name"
    let ik = "init"
    let name = s[nk] ?? ""
    let init = s[ik]
    -- Track type of this variable from its initializer
    if !stdr.is_null(init)
      let init_type = type_of_expr(init, cask_name)
      if stdr.len(init_type) > 0
        g_var_types[name] = init_type
    let id = g_tmp_counter
    g_tmp_counter = g_tmp_counter + 1
    let temp_name = stdr.str_concat("__local_init", stdr.str(id))
    let ?r = stdr.str_concat(indent, "YisVal ")
    r = stdr.str_concat(r, temp_name)
    r = stdr.str_concat(r, " = ")
    r = stdr.str_concat(r, emit_owned_expr(init, cask_name))
    r = stdr.str_concat(r, ";\n")
    r = stdr.str_concat(r, indent)
    r = stdr.str_concat(r, "YisVal v_")
    r = stdr.str_concat(r, name)
    r = stdr.str_concat(r, " __attribute__((cleanup(yis_release_slot))) = ")
    r = stdr.str_concat(r, temp_name)
    r = stdr.str_concat(r, ";\n")
    scope_mark(name)
    g_owned_names[name] = true
    <- r

  if st == "const"
    let nk = "name"
    let ik = "init"
    let name = s[nk] ?? ""
    let init = s[ik]
    let id = g_tmp_counter
    g_tmp_counter = g_tmp_counter + 1
    let temp_name = stdr.str_concat("__local_init", stdr.str(id))
    let ?r = stdr.str_concat(indent, "YisVal ")
    r = stdr.str_concat(r, temp_name)
    r = stdr.str_concat(r, " = ")
    r = stdr.str_concat(r, emit_owned_expr(init, cask_name))
    r = stdr.str_concat(r, ";\n")
    r = stdr.str_concat(r, indent)
    r = stdr.str_concat(r, "YisVal v_")
    r = stdr.str_concat(r, name)
    r = stdr.str_concat(r, " __attribute__((cleanup(yis_release_slot))) = ")
    r = stdr.str_concat(r, temp_name)
    r = stdr.str_concat(r, ";\n")
    scope_mark(name)
    g_owned_names[name] = true
    <- r

  if st == "return"
    let vk = "value"
    let val = s[vk]
    let rel = ""
    if stdr.is_null(val)
      let ?r = indent
      r = stdr.str_concat(r, rel)
      r = stdr.str_concat(r, indent)
      r = stdr.str_concat(r, "return;\n")
      <- r
    let prev_fn_r = g_flat_names
    let prev_fe_r = g_flat_exprs
    g_flat_names = []: [any]
    g_flat_exprs = []: [any]
    let val_c = emit_expr(val, cask_name)
    let decls_r = flat_decls(indent)
    let frels_r = flat_releases(indent)
    g_flat_names = prev_fn_r
    g_flat_exprs = prev_fe_r
    let ?r = decls_r
    r = stdr.str_concat(r, indent)
    r = stdr.str_concat(r, "{ YisVal __ret = ")
    r = stdr.str_concat(r, val_c)
    r = stdr.str_concat(r, ";\n")
    if !is_fresh_expr(val)
      r = stdr.str_concat(r, indent)
      r = stdr.str_concat(r, "yis_retain_val(__ret);\n")
    r = stdr.str_concat(r, frels_r)
    r = stdr.str_concat(r, rel)
    r = stdr.str_concat(r, indent)
    r = stdr.str_concat(r, "return __ret; }\n")
    <- r

  if st == "break"
    let ?r = indent
    r = stdr.str_concat(r, "break;\n")
    <- r

  if st == "continue"
    let ?r = indent
    r = stdr.str_concat(r, "continue;\n")
    <- r

  if st == "expr_stmt"
    let ek = "expr"
    let expr_ast = s[ek]
    let expr_c = emit_expr(expr_ast, cask_name)
    let ?r = indent
    if call_returns_void(expr_ast, cask_name)
      r = stdr.str_concat(r, "(void)(")
      r = stdr.str_concat(r, expr_c)
      r = stdr.str_concat(r, ");\n")
    elif is_fresh_expr(expr_ast)
      r = stdr.str_concat(r, "{ YisVal __expr_tmp = ")
      r = stdr.str_concat(r, expr_c)
      r = stdr.str_concat(r, "; yis_release_val(__expr_tmp); }\n")
    else
      r = stdr.str_concat(r, "(void)(")
      r = stdr.str_concat(r, expr_c)
      r = stdr.str_concat(r, ");\n")
    <- r

  if st == "if"
    let prev_scope_names_if = g_scope_names
    let prev_scope_order_if = g_scope_order
    let prev_owned_if = g_owned_names
    let ck = "cond"
    let tk = "then"
    let ek = "else"
    let cond_c = emit_condition(s[ck], cask_name)
    let then_stmts = s[tk] ?? []: [any]
    let else_stmts = s[ek]
    let inner = stdr.str_concat(indent, "  ")
    let ?r = indent
    r = stdr.str_concat(r, "if (yis_as_bool(")
    r = stdr.str_concat(r, cond_c)
    r = stdr.str_concat(r, ")) {\n")
    r = stdr.str_concat(r, emit_stmts(then_stmts, inner, cask_name))
    g_scope_names = prev_scope_names_if
    g_scope_order = prev_scope_order_if
    g_owned_names = prev_owned_if
    r = stdr.str_concat(r, indent)
    r = stdr.str_concat(r, "}")
    if !stdr.is_null(else_stmts)
      let ?else_len = 0
      else_len = stdr.len(else_stmts)
      if else_len > 0
        -- Check if the else block is a single if-stmt (elif chain)
        let first = else_stmts[0]
        let first_tag = "tag"
        if else_len == 1
          if !stdr.is_null(first)
            if first[first_tag] == "if"
              r = stdr.str_concat(r, " else ")
              -- Emit the nested if without extra indent wrapper
              r = stdr.str_concat(r, emit_if_inline(first, indent, cask_name))
            else
              r = stdr.str_concat(r, " else {\n")
              r = stdr.str_concat(r, emit_stmts(else_stmts, inner, cask_name))
              r = stdr.str_concat(r, indent)
              r = stdr.str_concat(r, "}")
        else
          r = stdr.str_concat(r, " else {\n")
          r = stdr.str_concat(r, emit_stmts(else_stmts, inner, cask_name))
          r = stdr.str_concat(r, indent)
          r = stdr.str_concat(r, "}")
    r = stdr.str_concat(r, "\n")
    g_scope_names = prev_scope_names_if
    g_scope_order = prev_scope_order_if
    g_owned_names = prev_owned_if
    <- r

  if st == "for"
    let prev_scope_names_for = g_scope_names
    let prev_scope_order_for = g_scope_order
    let prev_owned_for = g_owned_names
    let ck = "cond"
    let bk = "body"
    let sk = "step"
    let initk = "init"
    let isk = "init_stmt"
    let cond = s[ck]
    let body = s[bk] ?? []: [any]
    let step = s[sk]
    let init_stmt = s[isk]
    let inner = stdr.str_concat(indent, "  ")
    let ?r = indent
    -- Wrap in block if there's an init_stmt (for scoping)
    if !stdr.is_null(init_stmt)
      r = stdr.str_concat(r, "{ ")
      r = stdr.str_concat(r, emit_stmt(init_stmt, "", cask_name))
      r = stdr.str_concat(r, indent)
    r = stdr.str_concat(r, "for (;")
    -- condition
    if !stdr.is_null(cond)
      r = stdr.str_concat(r, " yis_as_bool(")
      r = stdr.str_concat(r, emit_condition(cond, cask_name))
      r = stdr.str_concat(r, ")")
    r = stdr.str_concat(r, ";")
    -- step (in for-clause so continue reaches it)
    if !stdr.is_null(step)
      r = stdr.str_concat(r, " (void)(")
      let ?step_c = emit_expr(step, cask_name)
      if is_fresh_expr(step)
        step_c = stdr.str_concat("({ YisVal __step = ", step_c)
        step_c = stdr.str_concat(step_c, "; yis_release_val(__step); })")
      r = stdr.str_concat(r, step_c)
      r = stdr.str_concat(r, ")")
    r = stdr.str_concat(r, ") {\n")
    -- body
    r = stdr.str_concat(r, emit_stmts(body, inner, cask_name))
    r = stdr.str_concat(r, indent)
    r = stdr.str_concat(r, "}")
    if !stdr.is_null(init_stmt)
      r = stdr.str_concat(r, " }")
    r = stdr.str_concat(r, "\n")
    g_scope_names = prev_scope_names_for
    g_scope_order = prev_scope_order_for
    g_owned_names = prev_owned_for
    <- r

  if st == "foreach"
    let prev_scope_names_foreach = g_scope_names
    let prev_scope_order_foreach = g_scope_order
    let prev_owned_foreach = g_owned_names
    let ik = "item"
    let itk = "iter"
    let bk = "body"
    let item = s[ik] ?? "it"
    let iter_c = emit_owned_expr(s[itk], cask_name)
    let body = s[bk] ?? []: [any]
    let inner = stdr.str_concat(indent, "  ")
    let ?r = indent
    r = stdr.str_concat(r, "{ YisVal __iter __attribute__((cleanup(yis_release_slot))) = ")
    r = stdr.str_concat(r, iter_c)
    r = stdr.str_concat(r, "; int64_t __len = stdr_len(__iter); for (int64_t __i = 0; __i ")
    r = stdr.str_concat(r, "\<")
    r = stdr.str_concat(r, " __len; __i++) {\n")
    r = stdr.str_concat(r, inner)
    r = stdr.str_concat(r, "YisVal v_")
    r = stdr.str_concat(r, item)
    r = stdr.str_concat(r, " __attribute__((cleanup(yis_release_slot))) = yis_index(__iter, YV_INT(__i));\n")
    scope_mark(item)
    r = stdr.str_concat(r, emit_stmts(body, inner, cask_name))
    r = stdr.str_concat(r, indent)
    r = stdr.str_concat(r, "} }\n")
    g_scope_names = prev_scope_names_foreach
    g_scope_order = prev_scope_order_foreach
    g_owned_names = prev_owned_foreach
    <- r

  -- Unknown statement type; emit as comment
  let ?r = indent
  r = stdr.str_concat(r, "/* unknown stmt: ")
  r = stdr.str_concat(r, st)
  r = stdr.str_concat(r, " */\n")
  <- r
;

-- Emit an if-statement inline (for elif chains), without leading indent.
: emit_if_inline(s = any, indent = string, cask_name = string) (( string ))
  let tag = "tag"
  let ck = "cond"
  let tk = "then"
  let ek = "else"
  let cond_c = emit_condition(s[ck], cask_name)
  let then_stmts = s[tk] ?? []: [any]
  let else_stmts = s[ek]
  let inner = stdr.str_concat(indent, "  ")
  let ?r = "if (yis_as_bool("
  r = stdr.str_concat(r, cond_c)
  r = stdr.str_concat(r, ")) {\n")
  let prev_scope_names_eif = g_scope_names
  let prev_scope_order_eif = g_scope_order
  let prev_owned_eif = g_owned_names
  r = stdr.str_concat(r, emit_stmts(then_stmts, inner, cask_name))
  g_scope_names = prev_scope_names_eif
  g_scope_order = prev_scope_order_eif
  g_owned_names = prev_owned_eif
  r = stdr.str_concat(r, indent)
  r = stdr.str_concat(r, "}")
  if !stdr.is_null(else_stmts)
    let ?else_len2 = 0
    else_len2 = stdr.len(else_stmts)
    if else_len2 > 0
      let first = else_stmts[0]
      if else_len2 == 1
        if !stdr.is_null(first)
          if first[tag] == "if"
            r = stdr.str_concat(r, " else ")
            r = stdr.str_concat(r, emit_if_inline(first, indent, cask_name))
          else
            r = stdr.str_concat(r, " else {\n")
            r = stdr.str_concat(r, emit_stmts(else_stmts, inner, cask_name))
            r = stdr.str_concat(r, indent)
            r = stdr.str_concat(r, "}")
      else
        r = stdr.str_concat(r, " else {\n")
        r = stdr.str_concat(r, emit_stmts(else_stmts, inner, cask_name))
        r = stdr.str_concat(r, indent)
        r = stdr.str_concat(r, "}")
  r = stdr.str_concat(r, "\n")
  <- r
;

-- Parameter copies are owned locals so rebinding cannot release caller values.
: emit_param_local(name = string, input = string) (( string ))
  let ?r = "  YisVal v_"
  r = stdr.str_concat(r, name)
  r = stdr.str_concat(r, " __attribute__((cleanup(yis_release_slot))) = ")
  r = stdr.str_concat(r, input)
  r = stdr.str_concat(r, "; yis_retain_val(v_")
  r = stdr.str_concat(r, name)
  r = stdr.str_concat(r, ");\n")
  <- r
;

: emit_lambda_wrapper(meta = any) (( string ))
  let lname = meta["name"] ?? "__lambda_0"
  let params = meta["params"] ?? []: [any]
  let body = meta["body"] ?? []: [any]
  let caps = meta["captures"] ?? []: [any]
  let cap_types = meta["cap_types"] ?? []: [string => any]
  let cask_name = meta["cask"] ?? "init"
  let prev_mod_owned = g_cur_mod
  g_cur_mod = cask_name
  let capn = stdr.len(caps)

  let prev_scope = g_scope_names
  let prev_scope_order = g_scope_order
  let prev_owned = g_owned_names
  let prev_var_types = g_var_types
  g_scope_names = []: [string => any]
  g_scope_order = []: [any]
  g_owned_names = []: [string => any]
  g_var_types = []: [string => any]

  let ?out = "YisVal "
  out = stdr.str_concat(out, lname)
  out = stdr.str_concat(out, "(void* env, int argc, YisVal* argv) {\n")

  out = stdr.str_concat(out, "  YisVal* __caps = (YisVal*)env;\n")
  let ?i = 0
  for (; i < capn; i = i + 1)
    let cname = caps[i] ?? ""
    out = stdr.str_concat(out, "  YisVal v_")
    out = stdr.str_concat(out, cname)
    out = stdr.str_concat(out, " __attribute__((cleanup(yis_release_slot))) = ")
    if capn > 0
      out = stdr.str_concat(out, "__caps[")
      out = stdr.str_concat(out, stdr.str(i))
      out = stdr.str_concat(out, "]")
    else
      out = stdr.str_concat(out, "YV_NULLV")
    out = stdr.str_concat(out, "; yis_retain_val(v_")
    out = stdr.str_concat(out, cname)
    out = stdr.str_concat(out, ");\n")
    scope_mark(cname)
    let cap_t = cap_types[cname]
    if !stdr.is_null(cap_t)
      g_var_types[cname] = cap_t

  let ?pi = 0
  let pn = stdr.len(params)
  for (; pi < pn; pi = pi + 1)
    let p = params[pi]
    let pname = p["name"] ?? ""
    out = stdr.str_concat(out, "  YisVal v_")
    out = stdr.str_concat(out, pname)
    out = stdr.str_concat(out, " __attribute__((cleanup(yis_release_slot))) = argc > ")
    out = stdr.str_concat(out, stdr.str(pi))
    out = stdr.str_concat(out, " ? argv[")
    out = stdr.str_concat(out, stdr.str(pi))
    out = stdr.str_concat(out, "] : YV_NULLV; yis_retain_val(v_")
    out = stdr.str_concat(out, pname)
    out = stdr.str_concat(out, ");\n")
    scope_mark(pname)
    let ptype = p["type"] ?? ""
    if stdr.len(ptype) > 0
      if !stdr.is_null(g_classes[ptype])
        g_var_types[pname] = ptype

  out = stdr.str_concat(out, emit_stmts(body, "  ", cask_name))
  out = stdr.str_concat(out, "  return YV_NULLV;\n")
  out = stdr.str_concat(out, "}\n\n")

  g_scope_names = prev_scope
  g_scope_order = prev_scope_order
  g_owned_names = prev_owned
  g_var_types = prev_var_types
  g_cur_mod = prev_mod_owned
  <- out
;

-- Emit a function declaration.
: emit_fun(d = any, cask_name = string) (( string ))
  let tag = "tag"
  let name_key = "name"
  let pk = "params"
  let rk = "ret"
  let bk = "body"
  let name = d[name_key] ?? ""
  let params = d[pk] ?? []: [any]
  let ret = d[rk] ?? "any"
  let body = d[bk] ?? []: [any]
  let is_void = ret == "void" || ret == "--" || name == "entry"

  -- Set up type tracking for this function
  let prev_var_types = g_var_types
  let prev_scope_names = g_scope_names
  let prev_scope_order = g_scope_order
  let prev_owned_fun = g_owned_names
  let prev_mod_fun = g_cur_mod
  g_cur_mod = cask_name
  g_var_types = []: [string => any]
  g_scope_names = []: [string => any]
  g_scope_order = []: [any]
  g_owned_names = []: [string => any]
  let ?np = 0
  np = stdr.len(params)
  let ?pi = 0
  for (; pi < np; pi = pi + 1)
    let pp = params[pi]
    let ppname = pp[name_key] ?? ""
    let ptype_key = "type"
    let pptype = pp[ptype_key] ?? ""
    if stdr.len(pptype) > 0
      if !stdr.is_null(g_classes[pptype])
        g_var_types[ppname] = pptype
    if stdr.len(ppname) > 0
      scope_mark(ppname)

  -- Function signature
  let ?out = ""
  if is_void
    out = stdr.str_concat(out, "static void ")
  else
    out = stdr.str_concat(out, "static YisVal ")
  -- Mangled name
  if name == "entry"
    out = stdr.str_concat(out, "yis_entry")
  else
    out = stdr.str_concat(out, mangle_name(cask_name, name))
  out = stdr.str_concat(out, "(")
  -- Parameters
  let ?k = 0
  for (; k < np; k = k + 1)
    if k > 0 { out = stdr.str_concat(out, ", ") }
    let p = params[k]
    let nk = "name"
    out = stdr.str_concat(out, "YisVal __arg_")
    out = stdr.str_concat(out, p[nk] ?? "")
  if np == 0 { out = stdr.str_concat(out, "void") }
  out = stdr.str_concat(out, ") {\n")
  let ?local_i = 0
  for (; local_i < np; local_i = local_i + 1)
    let local_name = params[local_i]["name"] ?? ""
    out = stdr.str_concat(out, emit_param_local(local_name, stdr.str_concat("__arg_", local_name)))

  if cask_name == "stdr" && name == "str" && stdr.len(body) == 0
    out = stdr.str_concat(out, "  return YV_STR(stdr_to_string(v_x));\n")
  out = stdr.str_concat(out, emit_stmts(body, "  ", cask_name))
  if !is_void
    out = stdr.str_concat(out, "  return YV_NULLV;\n")
  out = stdr.str_concat(out, "}\n\n")

  g_var_types = prev_var_types
  g_scope_names = prev_scope_names
  g_scope_order = prev_scope_order
  g_owned_names = prev_owned_fun
  g_cur_mod = prev_mod_fun
  <- out
;

-- Emit a macro as a C function with v_this as the first parameter.
-- The macro body's last expression-statement becomes a <-.
: emit_macro(d = any, cask_name = string) (( string ))
  let tag = "tag"
  let name_key = "name"
  let pk = "params"
  let rk = "ret"
  let bk = "body"
  let mname = d[name_key] ?? ""
  let params = d[pk] ?? []: [any]
  let ret = d[rk] ?? "any"
  let body = d[bk] ?? []: [any]
  let is_void = ret == "void" || ret == "--"
  let prev_mod_owned = g_cur_mod
  g_cur_mod = cask_name

  -- Set up type tracking for macros: this = <- type class if known
  let prev_scope_names_m = g_scope_names
  let prev_scope_order_m = g_scope_order
  let prev_owned_m = g_owned_names
  g_scope_names = []: [string => any]
  g_scope_order = []: [any]
  g_owned_names = []: [string => any]
  scope_mark("this")
  let prev_var_types_m = g_var_types
  g_var_types = []: [string => any]
  if stdr.len(ret) > 0
    if !stdr.is_null(g_classes[ret])
      g_var_types["this"] = ret

  let ?out = ""
  if is_void
    out = stdr.str_concat(out, "static void ")
  else
    out = stdr.str_concat(out, "static YisVal ")
  out = stdr.str_concat(out, mangle_name(cask_name, mname))
  out = stdr.str_concat(out, "(YisVal __arg_this")
  let ?np = 0
  np = stdr.len(params)
  let ?k = 0
  for (; k < np; k = k + 1)
    out = stdr.str_concat(out, ", YisVal __arg_")
    let p = params[k]
    let nk = "name"
    out = stdr.str_concat(out, p[nk] ?? "")
  out = stdr.str_concat(out, ") {\n")
  out = stdr.str_concat(out, emit_param_local("this", "__arg_this"))
  let ?local_i = 0
  for (; local_i < np; local_i = local_i + 1)
    let local_name = params[local_i]["name"] ?? ""
    scope_mark(local_name)
    out = stdr.str_concat(out, emit_param_local(local_name, stdr.str_concat("__arg_", local_name)))


  -- For macro bodies, the last statement is typically an expression.
  -- Wrap it in a <-.
  let nb = stdr.len(body)
  if nb > 0 && !is_void
    -- Emit all but last
    let ?bi = 0
    for (; bi < nb - 1; bi = bi + 1)
      out = stdr.str_concat(out, emit_stmt(body[bi], "  ", cask_name))
    -- Last statement: if it's an expr_stmt, make it a <-
    let last = body[nb - 1]
    let ltag = last[tag] ?? ""
    if ltag == "expr_stmt"
      let ek = "expr"
      let ?return_stmt = []: [string => any]
      return_stmt["tag"] = "return"
      return_stmt["value"] = last[ek]
      out = stdr.str_concat(out, emit_stmt(return_stmt, "  ", cask_name))
    else
      out = stdr.str_concat(out, emit_stmt(last, "  ", cask_name))
  else
    out = stdr.str_concat(out, emit_stmts(body, "  ", cask_name))

  if !is_void
    out = stdr.str_concat(out, "  return YV_NULLV;\n")
  out = stdr.str_concat(out, "}\n\n")
  g_var_types = prev_var_types_m
  g_scope_names = prev_scope_names_m
  g_scope_order = prev_scope_order_m
  g_owned_names = prev_owned_m
  g_cur_mod = prev_mod_owned
  <- out
;

-- Emit a class method as a C function.
-- Mangling: yis_m_<mod>_<class>_<method>(YisVal self, ...)
: emit_class_method(d = any, cask_name = string, class_name = string) (( string ))
  let tag = "tag"
  let name_key = "name"
  let pk = "params"
  let rk = "ret"
  let bk = "body"
  let name = d[name_key] ?? ""
  let params = d[pk] ?? []: [any]
  let ret = d[rk] ?? "any"
  let body = d[bk] ?? []: [any]
  let is_void = ret == "void" || ret == "--"

  -- Set up type context for this method
  let prev_class = g_cur_class
  let prev_mod = g_cur_mod
  g_cur_class = class_name
  g_cur_mod = cask_name

  -- Track param types (this = current class)
  let prev_var_types = g_var_types
  let prev_scope_names = g_scope_names
  let prev_scope_order = g_scope_order
  let prev_owned_method = g_owned_names
  g_var_types = []: [string => any]
  g_scope_names = []: [string => any]
  g_scope_order = []: [any]
  g_owned_names = []: [string => any]
  g_var_types["this"] = class_name
  scope_mark("this")
  let ?pi = 0
  let nparams = stdr.len(params)
  for (; pi < nparams; pi = pi + 1)
    let p = params[pi]
    let pname = p[name_key] ?? ""
    let ptype_key = "type"
    let ptype = p[ptype_key] ?? ""
    if stdr.len(ptype) > 0
      if !stdr.is_null(g_classes[ptype])
        g_var_types[pname] = ptype
    if stdr.len(pname) > 0 { scope_mark(pname) }

  let ?out = ""
  if is_void
    out = stdr.str_concat(out, "static void ")
  else
    out = stdr.str_concat(out, "static YisVal ")
  out = stdr.str_concat(out, mangle_method(cask_name, class_name, name))
  out = stdr.str_concat(out, "(")
  -- All params use v_ prefix
  let ?k = 0
  for (; k < nparams; k = k + 1)
    if k > 0 { out = stdr.str_concat(out, ", ") }
    let p = params[k]
    let nk2 = "name"
    out = stdr.str_concat(out, "YisVal __arg_")
    out = stdr.str_concat(out, p[nk2] ?? "")
  if nparams == 0 { out = stdr.str_concat(out, "void") }
  out = stdr.str_concat(out, ") {\n")
  let ?local_i = 0
  for (; local_i < nparams; local_i = local_i + 1)
    let local_name = params[local_i]["name"] ?? ""
    out = stdr.str_concat(out, emit_param_local(local_name, stdr.str_concat("__arg_", local_name)))

  out = stdr.str_concat(out, emit_stmts(body, "  ", cask_name))
  if !is_void
    out = stdr.str_concat(out, "  return YV_NULLV;\n")
  out = stdr.str_concat(out, "}\n\n")

  -- Restore context
  g_cur_class = prev_class
  g_cur_mod = prev_mod
  g_var_types = prev_var_types
  g_scope_names = prev_scope_names
  g_scope_order = prev_scope_order
  g_owned_names = prev_owned_method
  <- out
;

-- Emit a function value wrapper for a given function.
: emit_fnwrap(d = any, cask_name = string) (( string ))
  let name_key = "name"
  let pk = "params"
  let rk = "ret"
  let fname = d[name_key] ?? ""
  let params = d[pk] ?? []: [any]
  let ret = d[rk] ?? "any"
  let is_void = ret == "void" || ret == "--"
  let np = stdr.len(params)

  -- Skip extern stubs
  if stdr.len(fname) >= 2
    if stdr.slice(fname, 0, 2) == "__" { <- "" }

  let ?out = "static YisVal __fnwrap_"
  out = stdr.str_concat(out, cask_name)
  out = stdr.str_concat(out, "_")
  out = stdr.str_concat(out, fname)
  out = stdr.str_concat(out, "(void* env, int argc, YisVal* argv) {\n")
  out = stdr.str_concat(out, "  (void)env; (void)argc;\n")

  -- Extract args from argv
  let ?k = 0
  for (; k < np; k = k + 1)
    out = stdr.str_concat(out, "  YisVal __a")
    out = stdr.str_concat(out, stdr.str(k))
    out = stdr.str_concat(out, " = argc > ")
    out = stdr.str_concat(out, stdr.str(k))
    out = stdr.str_concat(out, " ? argv[")
    out = stdr.str_concat(out, stdr.str(k))
    out = stdr.str_concat(out, "] : YV_NULLV;\n")

  -- Call actual function
  if is_void
    out = stdr.str_concat(out, "  ")
    if fname == "entry"
      out = stdr.str_concat(out, "yis_entry")
    else
      out = stdr.str_concat(out, mangle_name(cask_name, fname))
    out = stdr.str_concat(out, "(")
    k = 0
    for (; k < np; k = k + 1)
      if k > 0 { out = stdr.str_concat(out, ", ") }
      out = stdr.str_concat(out, "__a")
      out = stdr.str_concat(out, stdr.str(k))
    out = stdr.str_concat(out, ");\n")
    out = stdr.str_concat(out, "  return YV_NULLV;\n")
  else
    out = stdr.str_concat(out, "  return ")
    if fname == "entry"
      out = stdr.str_concat(out, "yis_entry")
    else
      out = stdr.str_concat(out, mangle_name(cask_name, fname))
    out = stdr.str_concat(out, "(")
    k = 0
    for (; k < np; k = k + 1)
      if k > 0 { out = stdr.str_concat(out, ", ") }
      out = stdr.str_concat(out, "__a")
      out = stdr.str_concat(out, stdr.str(k))
    out = stdr.str_concat(out, ");\n")
  out = stdr.str_concat(out, "}\n\n")
  <- out
;

-- Emit a single translation unit body for one AST (no runtime includes, no main).
: emit_unit(ast = any) (( string ))
  let tag = "tag"
  let name_key = "name"
  let decls_key = "decls"
  let decls = ast[decls_key]
  if stdr.is_null(decls) { <- "" }

  let ?cask_name = "init"
  let ?n = 0
  n = stdr.len(decls)
  let ?i = 0
  for (; i < n; i = i + 1)
    let d = decls[i]
    if d[tag] == "cask" { cask_name = d[name_key] ?? "init" }

  -- Use array-based string builder for O(n) total performance
  let ?p = []: [any]
  let ret_key = "ret"
  let params_key = "params"

  g_lambda_meta = []: [string => any]
  g_lambda_ids = []: [any]

  -- Track top-level function names (for macro/function collision filtering)
  let ?fun_names = []: [string => any]
  i = 0
  for (; i < n; i = i + 1)
    let d = decls[i]
    if d[tag] == "fun"
      let fname0 = d[name_key] ?? ""
      fun_names[fname0] = true

  -- Forward declarations: functions (skip extern stubs: __prefix + empty body)
  let body_key = "body"

  -- Emit class struct typedefs and drop forward declarations
  let fields_key = "fields"
  i = 0
  for (; i < n; i = i + 1)
    let d = decls[i]
    let dt = d[tag] ?? ""
    if dt == "cask" { cask_name = d[name_key] ?? "init" }
    if dt == "class"
      let cls_name = d[name_key] ?? ""
      let cls_info = g_classes[cls_name] ?? []: [string => any]
      let cls_fields = cls_info[fields_key] ?? []: [any]
      -- Only emit struct if class has fields
      if stdr.len(cls_fields) > 0
        stdr.push(p, "typedef struct YisObj_")
        stdr.push(p, cask_name)
        stdr.push(p, "_")
        stdr.push(p, cls_name)
        stdr.push(p, " {\n    YisObj base;\n")
        let ?fi = 0
        let nf = stdr.len(cls_fields)
        for (; fi < nf; fi = fi + 1)
          let fd = cls_fields[fi]
          let fn3 = fd["name"] ?? ""
          stdr.push(p, "    YisVal f_")
          stdr.push(p, fn3)
          stdr.push(p, ";\n")
        stdr.push(p, "} YisObj_")
        stdr.push(p, cask_name)
        stdr.push(p, "_")
        stdr.push(p, cls_name)
        stdr.push(p, ";\n")
        -- Forward declare drop function
        stdr.push(p, "static void yis_drop_")
        stdr.push(p, cask_name)
        stdr.push(p, "_")
        stdr.push(p, cls_name)
        stdr.push(p, "(YisObj* o);\n")

  -- Emit class drop function bodies
  i = 0
  for (; i < n; i = i + 1)
    let d = decls[i]
    let dt = d[tag] ?? ""
    if dt == "cask" { cask_name = d[name_key] ?? "init" }
    if dt == "class"
      let cls_name = d[name_key] ?? ""
      let cls_info = g_classes[cls_name] ?? []: [string => any]
      let cls_fields = cls_info[fields_key] ?? []: [any]
      if stdr.len(cls_fields) > 0
        stdr.push(p, "static void yis_drop_")
        stdr.push(p, cask_name)
        stdr.push(p, "_")
        stdr.push(p, cls_name)
        stdr.push(p, "(YisObj* o) {\n    YisObj_")
        stdr.push(p, cask_name)
        stdr.push(p, "_")
        stdr.push(p, cls_name)
        stdr.push(p, "* self = (YisObj_")
        stdr.push(p, cask_name)
        stdr.push(p, "_")
        stdr.push(p, cls_name)
        stdr.push(p, "*)o;\n")
        let ?fi = 0
        let nf = stdr.len(cls_fields)
        for (; fi < nf; fi = fi + 1)
          let fd = cls_fields[fi]
          let fn3 = fd["name"] ?? ""
          stdr.push(p, "    yis_release_val(self->f_")
          stdr.push(p, fn3)
          stdr.push(p, ");\n")
        stdr.push(p, "}\n")

  let ?seen_fun_decls = []: [string => any]
  i = 0
  for (; i < n; i = i + 1)
    let d = decls[i]
    let dt = d[tag] ?? ""
    if dt == "cask" { cask_name = d[name_key] ?? "init" }
    if dt == "fun"
      let fname = d[name_key] ?? ""
      if !stdr.is_null(seen_fun_decls[fname]) { continue }
      seen_fun_decls[fname] = true
      let fbody = d[body_key] ?? []: [any]
      if stdr.len(fname) >= 2
        if stdr.slice(fname, 0, 2) == "__"
          if stdr.len(fbody) == 0 { continue }
      let ret = d[ret_key] ?? "any"
      let is_void = ret == "void" || ret == "--" || fname == "entry"
      let params = d[params_key] ?? []: [any]
      if is_void { stdr.push(p, "static void ") } else { stdr.push(p, "static YisVal ") }
      if fname == "entry" { stdr.push(p, "yis_entry") } else { stdr.push(p, mangle_name(cask_name, fname)) }
      stdr.push(p, "(")
      let ?np = stdr.len(params)
      let ?k = 0
      for (; k < np; k = k + 1)
        if k > 0 { stdr.push(p, ", ") }
        stdr.push(p, "YisVal")
      if np == 0 { stdr.push(p, "void") }
      stdr.push(p, ");\n")
    if dt == "exit"
      stdr.push(p, "static void yis_exit_fn(void);\n")

  -- Forward declarations: macros
  i = 0
  for (; i < n; i = i + 1)
    let d = decls[i]
    let dt = d[tag] ?? ""
    if dt == "cask" { cask_name = d[name_key] ?? "init" }
    if dt == "macro"
      let mname = d[name_key] ?? ""
      if !stdr.is_null(fun_names[mname]) { continue }
      let ret = d[ret_key] ?? "any"
      let is_void = ret == "void" || ret == "--"
      let params = d[params_key] ?? []: [any]
      if is_void { stdr.push(p, "static void ") } else { stdr.push(p, "static YisVal ") }
      stdr.push(p, mangle_name(cask_name, mname))
      stdr.push(p, "(YisVal v_this")
      let ?np = stdr.len(params)
      let ?k = 0
      for (; k < np; k = k + 1) { stdr.push(p, ", YisVal") }
      stdr.push(p, ");\n")

  -- Forward declarations: class methods
  let methods_key = "methods"
  i = 0
  for (; i < n; i = i + 1)
    let d = decls[i]
    let dt = d[tag] ?? ""
    if dt == "cask" { cask_name = d[name_key] ?? "init" }
    if dt == "class"
      let cls_name = d[name_key] ?? ""
      let methods = d[methods_key] ?? []: [any]
      let ?mi = 0
      let nm = stdr.len(methods)
      for (; mi < nm; mi = mi + 1)
        let m = methods[mi]
        let mname = m[name_key] ?? ""
        let mret = m[ret_key] ?? "any"
        let mis_void = mret == "void" || mret == "--"
        let mparams = m[params_key] ?? []: [any]
        if mis_void { stdr.push(p, "static void ") } else { stdr.push(p, "static YisVal ") }
        stdr.push(p, mangle_method(cask_name, cls_name, mname))
        stdr.push(p, "(")
        let ?mnp = stdr.len(mparams)
        let ?mk = 0
        for (; mk < mnp; mk = mk + 1)
          if mk > 0 { stdr.push(p, ", ") }
          stdr.push(p, "YisVal")
        if mnp == 0 { stdr.push(p, "void") }
        stdr.push(p, ");\n")

  -- Forward declarations: function value wrappers
  let ?seen_fnwrap_decls = []: [string => any]
  i = 0
  for (; i < n; i = i + 1)
    let d = decls[i]
    let dt = d[tag] ?? ""
    if dt == "cask" { cask_name = d[name_key] ?? "init" }
    if dt == "fun"
      let fname = d[name_key] ?? ""
      if !stdr.is_null(seen_fnwrap_decls[fname]) { continue }
      seen_fnwrap_decls[fname] = true
      let fbody = d[body_key] ?? []: [any]
      if stdr.len(fname) >= 2
        if stdr.slice(fname, 0, 2) == "__"
          if stdr.len(fbody) == 0 { continue }
      if fname == "entry" { continue }
      stdr.push(p, "static YisVal __fnwrap_")
      stdr.push(p, cask_name)
      stdr.push(p, "_")
      stdr.push(p, fname)
      stdr.push(p, "(void*,int,YisVal*);\n")

  -- Forward declarations: def globals
  let init_key = "init"
  g_global_def_names = []: [string => any]
  g_def_types = []: [string => any]
  i = 0
  for (; i < n; i = i + 1)
    let d = decls[i]
    let dt = d[tag] ?? ""
    if dt == "cask" { cask_name = d[name_key] ?? "init" }
    if dt == "def"
      let dname = d[name_key] ?? ""
      g_global_def_names[dname] = true
      let dinit = d[init_key]
      if !stdr.is_null(dinit)
        let dtype = type_of_expr(dinit, cask_name)
        if stdr.len(dtype) > 0
          g_def_types[dname] = dtype
      stdr.push(p, "static YisVal ")
      stdr.push(p, mangle_def(cask_name, dname))
      stdr.push(p, " = YV_NULLV;\n")
  stdr.push(p, "\n")

  -- Emit function bodies and comments
  let ?seen_fun_bodies = []: [string => any]
  i = 0
  for (; i < n; i = i + 1)
    let d = decls[i]
    let dt = d[tag] ?? ""
    if dt == "cask"
      cask_name = d[name_key] ?? "init"
      stdr.push(p, "// cask ")
      stdr.push(p, d[name_key] ?? "")
      stdr.push(p, "\n")
    if dt == "bring"
      stdr.push(p, "// bring ")
      stdr.push(p, d[name_key] ?? "")
      stdr.push(p, "\n")
    if dt == "fun"
      let fname = d[name_key] ?? ""
      if !stdr.is_null(seen_fun_bodies[fname]) { continue }
      seen_fun_bodies[fname] = true
      let fbody = d[body_key] ?? []: [any]
      if stdr.len(fname) >= 2
        if stdr.slice(fname, 0, 2) == "__"
          if stdr.len(fbody) == 0 { continue }
      stdr.push(p, emit_fun(d, cask_name))
    if dt == "exit"
      let exit_body = d[body_key] ?? []: [any]
      stdr.push(p, "static void yis_exit_fn(void) {\n")
      stdr.push(p, emit_stmts(exit_body, "  ", cask_name))
      stdr.push(p, "}\n\n")
    if dt == "macro"
      let mname = d[name_key] ?? ""
      if !stdr.is_null(fun_names[mname]) { continue }
      stdr.push(p, emit_macro(d, cask_name))
    if dt == "class"
      let cls_name = d[name_key] ?? ""
      let cls_methods = d[methods_key] ?? []: [any]
      let ?ci = 0
      let ncm = stdr.len(cls_methods)
      for (; ci < ncm; ci = ci + 1)
        let cm = cls_methods[ci]
        stdr.push(p, emit_class_method(cm, cask_name, cls_name))

  -- Emit function value wrappers
  let ?seen_fnwrap_bodies = []: [string => any]
  i = 0
  for (; i < n; i = i + 1)
    let d = decls[i]
    let dt = d[tag] ?? ""
    if dt == "cask" { cask_name = d[name_key] ?? "init" }
    if dt == "fun"
      let fname = d[name_key] ?? ""
      if !stdr.is_null(seen_fnwrap_bodies[fname]) { continue }
      seen_fnwrap_bodies[fname] = true
      if fname == "entry" { continue }
      stdr.push(p, emit_fnwrap(d, cask_name))

  -- Emit lambda wrappers collected while emitting function bodies
  let ?li = 0
  for (; li < stdr.len(g_lambda_ids); li = li + 1)
    let lid = g_lambda_ids[li]
    let lmeta = g_lambda_meta[stdr.str(lid)]
    if !stdr.is_null(lmeta)
      stdr.push(p, emit_lambda_wrapper(lmeta))

  -- Emit def init function if there are any defs
  let ?has_defs = false
  i = 0
  for (; i < n; i = i + 1)
    let d = decls[i]
    if d[tag] == "def" { has_defs = true }
  if has_defs
    stdr.push(g_def_init_modules, cask_name)
    let prev_mod_defs = g_cur_mod
    g_cur_mod = cask_name
    stdr.push(p, "static void __yis_")
    stdr.push(p, cask_name)
    stdr.push(p, "_init(void) {\n")
    i = 0
    for (; i < n; i = i + 1)
      let d = decls[i]
      let dt = d[tag] ?? ""
      if dt == "cask" { cask_name = d[name_key] ?? "init" }
      if dt == "def"
        let dname = d[name_key] ?? ""
        let dinit = d[init_key]
        if !stdr.is_null(dinit)
          stdr.push(p, "  { YisVal __global_init = ")
          stdr.push(p, emit_owned_expr(dinit, cask_name))
          stdr.push(p, "; yis_move_into(&")
          stdr.push(p, mangle_def(cask_name, dname))
          stdr.push(p, ", __global_init); yis_release_val(__global_init); }\n")
    stdr.push(p, "}\n\n")
    stdr.push(p, "static void __yis_")
    stdr.push(p, cask_name)
    stdr.push(p, "_cleanup(void) {\n")
    i = n - 1
    for (; i >= 0; i = i - 1)
      let d = decls[i]
      if d[tag] == "def"
        stdr.push(p, "  yis_release_val(yis_move(&")
        stdr.push(p, mangle_def(cask_name, d[name_key] ?? ""))
        stdr.push(p, "));\n")
    stdr.push(p, "}\n\n")
    g_cur_mod = prev_mod_defs

  -- Emit any additional lambda wrappers created during def init emission
  let ?li2 = li
  for (; li2 < stdr.len(g_lambda_ids); li2 = li2 + 1)
    let lid2 = g_lambda_ids[li2]
    let lmeta2 = g_lambda_meta[stdr.str(lid2)]
    if !stdr.is_null(lmeta2)
      stdr.push(p, emit_lambda_wrapper(lmeta2))

  <- stdr.join(p)
;

-- Extract directory from a file path (everything before the last /)
: dir_of(path = string) (( string ))
  let n = stdr.len(path)
  let ?i = n - 1
  for (; i >= 0; i = i - 1)
    let c = stdr.slice(path, i, i + 1)
    if c == "/" { <- stdr.slice(path, 0, i + 1) }
  <- ""
;

: base_name(path = string) (( string ))
  let n = stdr.len(path)
  let ?i = n - 1
  for (; i >= 0; i = i - 1)
    let c = stdr.slice(path, i, i + 1)
    if c == "/" { <- stdr.slice(path, i + 1, n) }
  <- path
;

: stem_name(path = string) (( string ))
  let b = base_name(path)
  let n = stdr.len(b)
  let ?i = n - 1
  for (; i >= 0; i = i - 1)
    let c = stdr.slice(b, i, i + 1)
    if c == "." { <- stdr.slice(b, 0, i) }
  <- b
;

: is_ascii_alnum(code = num) (( bool ))
  if code >= 48 && code <= 57 { <- true }
  if code >= 65 && code <= 90 { <- true }
  if code >= 97 && code <= 122 { <- true }
  <- false
;

: sanitize_filename_component(src = string) (( string ))
  let ?out = ""
  let n = stdr.len(src)
  let ?i = 0
  for (; i < n; i = i + 1)
    let c = stdr.slice(src, i, i + 1)
    let code = stdr.char_code(c)
    if is_ascii_alnum(code) || c == "." || c == "_" || c == "-"
      out = stdr.str_concat(out, c)
    elif c == " " || c == "\t"
      out = stdr.str_concat(out, "-")
    else
      out = stdr.str_concat(out, "_")

  let ?m = stdr.len(out)
  for (; m > 0; )
    let last = stdr.slice(out, m - 1, m)
    if last == "." || last == " "
      m = m - 1
    else
      break
  out = stdr.slice(out, 0, m)
  <- out
;

: strip_line_comments(src = string) (( string ))
  let n = stdr.len(src)
  let ?parts = []: [any]
  let ?chunk_start = 0
  let ?i = 0
  let ?in_str = false
  let ?block_depth = 0
  for (; i < n; i = i + 1)
    let c = stdr.slice(src, i, i + 1)
    let next = stdr.slice(src, i + 1, i + 2)
    if block_depth > 0
      if c == "-" && next == "|"
        block_depth += 1
        i += 1
      elif c == "|" && next == "-"
        block_depth -= 1
        i += 1
      continue
    if in_str
      if c == "\\"
        i = i + 1
      elif c == "\""
        in_str = false
      continue

    if c == "-" && next == "|"
      block_depth = 1
      i += 1
      continue

    if c == "\""
      in_str = true
      continue

    if c == "-" && i + 1 < n && stdr.slice(src, i + 1, i + 2) == "-"
      let ?lp1 = -1
      let ?lp2 = -1
      let ?p = i - 1
      for (; p >= 0; p = p - 1)
        let pc = stdr.slice(src, p, p + 1)
        if pc == " " || pc == "\t" || pc == "\n" || pc == "\r" { continue }
        lp1 = p
        break
      p = lp1 - 1
      for (; p >= 0; p = p - 1)
        let pc = stdr.slice(src, p, p + 1)
        if pc == " " || pc == "\t" || pc == "\n" || pc == "\r" { continue }
        lp2 = p
        break

      let ?rp1 = -1
      let ?rp2 = -1
      let ?q = i + 2
      for (; q < n; q = q + 1)
        let qc = stdr.slice(src, q, q + 1)
        if qc == " " || qc == "\t" || qc == "\n" || qc == "\r" { continue }
        rp1 = q
        break
      q = rp1 + 1
      for (; q < n; q = q + 1)
        let qc = stdr.slice(src, q, q + 1)
        if qc == " " || qc == "\t" || qc == "\n" || qc == "\r" { continue }
        rp2 = q
        break

      if lp2 >= 0 && lp1 >= 0 && rp1 >= 0 && rp2 >= 0
        if stdr.slice(src, lp2, lp2 + 1) == "(" && stdr.slice(src, lp1, lp1 + 1) == "(" && stdr.slice(src, rp1, rp1 + 1) == ")" && stdr.slice(src, rp2, rp2 + 1) == ")"
          i = i + 1
          continue

      if chunk_start < i { stdr.push(parts, stdr.slice(src, chunk_start, i)) }
      i = i + 2
      for (; i < n; i = i + 1)
        let d = stdr.slice(src, i, i + 1)
        if d == "\n"
          stdr.push(parts, "\n")
          break
      chunk_start = i + 1
      continue
  if chunk_start < n { stdr.push(parts, stdr.slice(src, chunk_start, n)) }
  <- stdr.join(parts)
;

: shell_quote_arg(arg = string) (( string ))
  let ?parts = []: [any]
  stdr.push(parts, "'")
  let n = stdr.len(arg)
  let ?chunk_start = 0
  let ?i = 0
  for (; i < n; i = i + 1)
    let c = stdr.slice(arg, i, i + 1)
    if c == "'"
      if chunk_start < i { stdr.push(parts, stdr.slice(arg, chunk_start, i)) }
      stdr.push(parts, "'\"'\"'")
      chunk_start = i + 1
  if chunk_start < n { stdr.push(parts, stdr.slice(arg, chunk_start, n)) }
  stdr.push(parts, "'")
  <- stdr.join(parts)
;

: rm_file_quiet(path = string) (( -- ))
  if stdr.len(path) == 0 { <- }
  stdr.remove_file(path)
;

: env_nonempty(name = string) (( bool ))
  if stdr.len(name) == 0 { <- false }
  <- stdr.len(_env_value(name)) > 0
;

-- Extract set_appid("...") from source text without parsing
: extract_appid_from_source(source = string) (( string ))
  let marker = "set_appid(\""
  let pos = stdr.index_of(source, marker)
  if pos < 0 { <- "" }
  let start = pos + stdr.len(marker)
  let rest = stdr.slice(source, start, start + 200)
  let close = stdr.index_of(rest, "\"")
  if close <= 0 { <- "" }
  <- sanitize_filename_component(stdr.slice(rest, 0, close))
;

-- Extract set_app_name("...") from source text without parsing
: extract_app_display_name(source = string) (( string ))
  let marker = "set_app_name(\""
  let pos = stdr.index_of(source, marker)
  if pos < 0 { <- "" }
  let start = pos + stdr.len(marker)
  let rest = stdr.slice(source, start, start + 200)
  let close = stdr.index_of(rest, "\"")
  if close <= 0 { <- "" }
  <- stdr.slice(rest, 0, close)
;

-- Parse environment compiler arguments without evaluating shell expansions.
-- Quoting and escaping group literal arguments; '$', backticks and ';' stay literal.
: driver_words(text = string, setting = string) (( any ))
  let ?words = []: [any]
  let ?word = ""
  let ?started = false
  let ?quote = ""
  let ?i = 0
  let n = stdr.len(text)
  for (; i < n; i += 1)
    let c = stdr.slice(text, i, i + 1)
    if quote == "'"
      if c == "'" { quote = "" }
      else { word = stdr.str_concat(word, c) }
      continue
    if c == "\\"
      if i + 1 >= n
        stdr.write(stdr.str_concat("ERR: Trailing escape in ", stdr.str_concat(setting, "\n")))
        stdr.exit_process(1)
      let next = stdr.slice(text, i + 1, i + 2)
      if quote == "\"" && next != "\"" && next != "\\" && next != "$" && next != "`"
        word = stdr.str_concat(word, c)
        continue
      word = stdr.str_concat(word, next)
      started = true
      i += 1
      continue
    if quote == "\""
      if c == "\"" { quote = "" }
      else { word = stdr.str_concat(word, c) }
      continue
    if c == "'" || c == "\""
      quote = c
      started = true
      continue
    if c == " " || c == "\t" || c == "\n" || c == "\r"
      if started
        stdr.push(words, word)
        word = ""
        started = false
      continue
    word = stdr.str_concat(word, c)
    started = true
  if stdr.len(quote) > 0
    stdr.write(stdr.str_concat("ERR: Unclosed quote in ", stdr.str_concat(setting, "\n")))
    stdr.exit_process(1)
  if started { stdr.push(words, word) }
  <- words
;

: driver_quote_words(words = any) (( string ))
  let ?parts = []: [any]
  let ?i = 0
  for (; i < stdr.len(words); i += 1)
    if i > 0 { stdr.push(parts, " ") }
    stdr.push(parts, shell_quote_arg(words[i] ?? ""))
  <- stdr.join(parts)
;

-- Flags that introduce native files need their own dependency discovery. Until
-- that is available, compile them each time rather than reuse a stale binary.
: driver_has_native_inputs(words = any) (( bool ))
  let prefixes = ["-I", "-L", "-l", "-include", "-imacros", "-isystem", "-iquote", "-idirafter", "-isysroot", "--sysroot", "-B", "-specs", "-fplugin", "-Wl,", "-Wp,", "-X"]
  let ?i = 0
  for (; i < stdr.len(words); i += 1)
    let word = words[i] ?? ""
    if !stdr.starts_with(word, "-") { <- true }
    let ?j = 0
    for (; j < stdr.len(prefixes); j += 1)
      if stdr.starts_with(word, prefixes[j] ?? "") { <- true }
  <- false
;

: driver_absolute_path(path = string) (( string ))
  let canonical = stdr.realpath(path)
  if !stdr.is_null(canonical) { <- canonical }
  let ?absolute = path
  if !stdr.starts_with(path, "/")
    absolute = stdr.str_concat(stdr.str_concat(stdr.getcwd(), "/"), path)
  -- Normalize lexical '.' and '..' components without changing symlink semantics.
  -- Keep '..': resolving it lexically could change a path passing through a symlink.
  let ?parts = []: [any]
  let ?start = 0
  let ?i = 0
  let n = stdr.len(absolute)
  for (; i <= n; i += 1)
    if i == n || stdr.slice(absolute, i, i + 1) == "/"
      let segment = stdr.slice(absolute, start, i)
      if stdr.len(segment) > 0 && segment != "."
        stdr.push(parts, "/")
        stdr.push(parts, segment)
      start = i + 1
  if stdr.len(parts) == 0 { <- "/" }
  <- stdr.join(parts)
;

: driver_resolve_executable(name = string) (( string ))
  if stdr.len(dir_of(name)) > 0 { <- driver_absolute_path(name) }
  let res = stdr.run_command(stdr.str_concat("command -v ", shell_quote_arg(name)))
  let result_code = res[0] ?? 1
  if result_code == 0
    let found = _chomp_newline(res[1] ?? "")
    if stdr.len(found) > 0 { <- driver_absolute_path(found) }
  <- name
;

: driver_cache_field(parts = any, key = string, value = string) (( -- ))
  stdr.push(parts, key)
  stdr.push(parts, "=")
  stdr.push(parts, stdr.str(stdr.len(value)))
  stdr.push(parts, ":")
  stdr.push(parts, value)
  stdr.push(parts, "\n")
;

-- Track resolved dependency paths as well as contents: an older replacement import
-- and an edit that preserves its timestamp must both invalidate the run cache.
: driver_dependency_stamp(path = string, seen = any, parts = any) (( -- ))
  let ?seen_map = seen
  let canonical = driver_absolute_path(path)
  if seen[canonical] { <- }
  seen_map[canonical] = true
  let ast = load_module(path)
  driver_cache_field(parts, "source", canonical)
  driver_cache_field(parts, "content", g_source_hashes[path] ?? "")
  let decls = ast["decls"] ?? []: [any]
  let ?i = 0
  for (; i < stdr.len(decls); i += 1)
    let d = decls[i]
    let dtag = d["tag"] ?? ""
    if dtag != "bring" { continue }
    let dependency = resolve_bring(d["name"] ?? "", dir_of(path))
    driver_dependency_stamp(dependency, seen, parts)
;

: driver_cache_directory() (( string ))
  let configured = _env_value("YIS_CACHE_DIR")
  if stdr.len(configured) > 0
    let explicit = driver_absolute_path(configured)
    if stdr.ensure_dir(explicit) { <- explicit }
    stdr.write("ERR: Cannot create YIS_CACHE_DIR\n")
    stdr.exit_process(1)
  let ?base = _env_value("XDG_CACHE_HOME")
  if stdr.len(base) == 0
    let home = stdr.home_dir()
    if stdr.len(home) > 0 { base = stdr.str_concat(home, "/.cache") }
  if stdr.len(base) > 0
    let candidate = driver_absolute_path(stdr.str_concat(base, "/yis"))
    if stdr.ensure_dir(candidate) { <- candidate }
  let local = driver_absolute_path(".yi-cache")
  if stdr.ensure_dir(local) { <- local }
  stdr.write("ERR: Cannot create binary cache directory\n")
  stdr.exit_process(1)
  <- ""
;

: driver_write_manifest(path = string, content = string) (( -- ))
  let temp = stdr.temp_file(dir_of(path), ".yis-manifest-")
  if stdr.is_null(temp) { <- }
  if !stdr.write_text_file(temp, content)
    rm_file_quiet(temp)
    <-
  if !stdr.move_file(temp, path) { rm_file_quiet(temp) }
;

: should_decode_escapes(path = string) (( bool ))
  <- true
;

: expr_string_literal_as_filename(e = any) (( string ))
  if stdr.is_null(e) { <- "" }
  let et = e["tag"] ?? ""
  if et != "str" { <- "" }
  let raw = e["value"] ?? ""
  <- sanitize_filename_component(raw)
;

: find_appid_expr(e = any) (( string ))
  if stdr.is_null(e) { <- "" }
  let et = e["tag"] ?? ""

  if et == "call"
    let fn = e["func"]
    let args = e["args"] ?? []: [any]
    let ?out = ""
    let ftag = fn["tag"] ?? ""

    if ftag == "member"
      let field = fn["field"] ?? ""
      if field == "set_appid" && stdr.len(args) > 0
        let cand = expr_string_literal_as_filename(args[0])
        if stdr.len(cand) > 0 { out = cand }
    elif ftag == "ident"
      let fname = fn["name"] ?? ""
      if stdr.len(fname) > 14 && stdr.slice(fname, stdr.len(fname) - 14, stdr.len(fname)) == "_app_set_appid" && stdr.len(args) > 1
        let cand = expr_string_literal_as_filename(args[1])
        if stdr.len(cand) > 0 { out = cand }

    let fscan = find_appid_expr(fn)
    if stdr.len(fscan) > 0 { out = fscan }

    let ?i = 0
    let n = stdr.len(args)
    for (; i < n; i = i + 1)
      let ascan = find_appid_expr(args[i])
      if stdr.len(ascan) > 0 { out = ascan }
    <- out

  if et == "unary"
    <- find_appid_expr(e["operand"])
  if et == "binop"
    let ?out = find_appid_expr(e["left"])
    let r = find_appid_expr(e["right"])
    if stdr.len(r) > 0 { out = r }
    <- out
  if et == "assign"
    let ?out = find_appid_expr(e["lhs"])
    let r = find_appid_expr(e["rhs"])
    if stdr.len(r) > 0 { out = r }
    <- out
  if et == "index"
    let ?out = find_appid_expr(e["obj"])
    let r = find_appid_expr(e["idx"])
    if stdr.len(r) > 0 { out = r }
    <- out
  if et == "member"
    <- find_appid_expr(e["obj"])
  if et == "array"
    let elems = e["elems"] ?? []: [any]
    let ?out = ""
    let ?i = 0
    let n = stdr.len(elems)
    for (; i < n; i = i + 1)
      let r = find_appid_expr(elems[i])
      if stdr.len(r) > 0 { out = r }
    <- out
  if et == "dict"
    let entries = e["entries"] ?? []: [any]
    let ?out = ""
    let ?i = 0
    let n = stdr.len(entries)
    for (; i < n; i = i + 1)
      let ent = entries[i]
      let rk = find_appid_expr(ent["key"])
      if stdr.len(rk) > 0 { out = rk }
      let rv = find_appid_expr(ent["value"])
      if stdr.len(rv) > 0 { out = rv }
    <- out
  if et == "if_expr"
    let ?out = find_appid_expr(e["cond"])
    let t = find_appid_expr(e["then"])
    if stdr.len(t) > 0 { out = t }
    let el = find_appid_expr(e["else"])
    if stdr.len(el) > 0 { out = el }
    <- out

  <- ""
;

: find_appid_stmt(s = any) (( string ))
  if stdr.is_null(s) { <- "" }
  let st = s["tag"] ?? ""
  if st == "let" || st == "const"
    <- find_appid_expr(s["init"])
  if st == "return"
    <- find_appid_expr(s["value"])
  if st == "expr_stmt"
    <- find_appid_expr(s["expr"])
  if st == "if"
    let ?out = find_appid_expr(s["cond"])
    let then_stmts = s["then"] ?? []: [any]
    let ?i = 0
    let tn = stdr.len(then_stmts)
    for (; i < tn; i = i + 1)
      let r = find_appid_stmt(then_stmts[i])
      if stdr.len(r) > 0 { out = r }
    let else_stmts = s["else"] ?? []: [any]
    i = 0
    let en = stdr.len(else_stmts)
    for (; i < en; i = i + 1)
      let r = find_appid_stmt(else_stmts[i])
      if stdr.len(r) > 0 { out = r }
    <- out
  if st == "for"
    let ?out = ""
    let init_stmt = s["init_stmt"]
    if !stdr.is_null(init_stmt)
      let r = find_appid_stmt(init_stmt)
      if stdr.len(r) > 0 { out = r }
    let c = find_appid_expr(s["cond"])
    if stdr.len(c) > 0 { out = c }
    let step = find_appid_expr(s["step"])
    if stdr.len(step) > 0 { out = step }
    let body = s["body"] ?? []: [any]
    let ?i = 0
    let n = stdr.len(body)
    for (; i < n; i = i + 1)
      let r2 = find_appid_stmt(body[i])
      if stdr.len(r2) > 0 { out = r2 }
    <- out
  if st == "foreach"
    let ?out = find_appid_expr(s["iter"])
    let body = s["body"] ?? []: [any]
    let ?i = 0
    let n = stdr.len(body)
    for (; i < n; i = i + 1)
      let r = find_appid_stmt(body[i])
      if stdr.len(r) > 0 { out = r }
    <- out
  <- ""
;

: find_appid_name(ast = any) (( string ))
  if stdr.is_null(ast) { <- "" }
  let decls = ast["decls"] ?? []: [any]
  let ?out = ""
  let ?i = 0
  let n = stdr.len(decls)
  for (; i < n; i = i + 1)
    let d = decls[i]
    let dt = d["tag"] ?? ""
    if dt == "entry" || dt == "exit" || dt == "fun" || dt == "macro"
      let body = d["body"] ?? []: [any]
      let ?j = 0
      let bn = stdr.len(body)
      for (; j < bn; j = j + 1)
        let r = find_appid_stmt(body[j])
        if stdr.len(r) > 0 { out = r }
    elif dt == "const" || dt == "def"
      let ?expr = d["init"]
      if stdr.is_null(expr) { expr = d["value"] }
      let r = find_appid_expr(expr)
      if stdr.len(r) > 0 { out = r }
    elif dt == "class"
      let methods = d["methods"] ?? []: [any]
      let ?k = 0
      let mn = stdr.len(methods)
      for (; k < mn; k = k + 1)
        let m = methods[k]
        let body = m["body"] ?? []: [any]
        let ?j = 0
        let bn = stdr.len(body)
        for (; j < bn; j = j + 1)
          let r = find_appid_stmt(body[j])
          if stdr.len(r) > 0 { out = r }
  <- out
;

: find_ext_module_packager(mod_name = string, module_yi_path = string) (( string ))
  let ?native_mod = ext_module_native_owner(mod_name)
  if stdr.len(native_mod) == 0 { <- "" }
  let upper = str_to_upper(native_mod)
  let env_name = stdr.str_concat(stdr.str_concat("YIS_", upper), "_PACKAGER")
  let env_val = _env_value(env_name)
  if stdr.len(env_val) > 0 && file_exists(env_val) == 0 { <- env_val }

  let script = stdr.str_concat(native_mod, "_packager.sh")
  let ?p = ""
  if stdr.len(module_yi_path) > 0
    let mod_dir = dir_of(module_yi_path)
    p = stdr.str_concat(mod_dir, stdr.str_concat("yis/", script))
    if file_exists(p) == 0 { <- p }
    p = stdr.str_concat(mod_dir, script)
    if file_exists(p) == 0 { <- p }

  p = stdr.str_concat(stdr.str_concat("/opt/homebrew/share/yis/", native_mod), stdr.str_concat("/", script))
  if file_exists(p) == 0 { <- p }
  p = stdr.str_concat(stdr.str_concat("/usr/local/share/yis/", native_mod), stdr.str_concat("/", script))
  if file_exists(p) == 0 { <- p }
  p = stdr.str_concat(stdr.str_concat("/usr/share/yis/", native_mod), stdr.str_concat("/", script))
  if file_exists(p) == 0 { <- p }

  p = stdr.str_concat("src/yis/", script)
  if file_exists(p) == 0 { <- p }
  p = stdr.str_concat("../src/yis/", script)
  if file_exists(p) == 0 { <- p }
  p = stdr.str_concat("../../src/yis/", script)
  if file_exists(p) == 0 { <- p }
  p = stdr.str_concat(stdr.str_concat("../", native_mod), stdr.str_concat("/src/yis/", script))
  if file_exists(p) == 0 { <- p }
  p = stdr.str_concat(stdr.str_concat("../../", native_mod), stdr.str_concat("/src/yis/", script))
  if file_exists(p) == 0 { <- p }

  let cap_name = stdr.str_concat(str_to_upper(stdr.slice(native_mod, 0, 1)), stdr.slice(native_mod, 1, stdr.len(native_mod)))
  p = stdr.str_concat(stdr.str_concat("../", cap_name), stdr.str_concat("/src/yis/", script))
  if file_exists(p) == 0 { <- p }
  p = stdr.str_concat(stdr.str_concat("../../", cap_name), stdr.str_concat("/src/yis/", script))
  if file_exists(p) == 0 { <- p }
  p = stdr.str_concat(stdr.str_concat("../", cap_name), stdr.str_concat("/yis/", script))
  if file_exists(p) == 0 { <- p }
  p = stdr.str_concat(stdr.str_concat("../../", cap_name), stdr.str_concat("/yis/", script))
  if file_exists(p) == 0 { <- p }
  <- ""
;

: run_ext_module_packager(packager_path = string, entry_path = string, out_path = string, app_name = string) (( bool ))
  if stdr.len(packager_path) == 0 { <- true }
  let ?cmd = "sh "
  cmd = stdr.str_concat(cmd, shell_quote_arg(packager_path))
  cmd = stdr.str_concat(cmd, " ")
  cmd = stdr.str_concat(cmd, shell_quote_arg(entry_path))
  cmd = stdr.str_concat(cmd, " ")
  cmd = stdr.str_concat(cmd, shell_quote_arg(out_path))
  cmd = stdr.str_concat(cmd, " ")
  cmd = stdr.str_concat(cmd, shell_quote_arg(app_name))
  cmd = stdr.str_concat(cmd, " 2>&1")
  let res = stdr.run_command(cmd)
  let code = res[0] ?? 1
  let out = res[1] ?? ""
  if stdr.len(out) > 0 { stdr.write(out) }
  <- code == 0
;

: prepare_macos_app_bundle(exe_path = string, bundle_id = string, bundle_name = string, display_name = string) (( bool ))
  if stdr.len(exe_path) == 0 { <- false }
  if stdr.len(bundle_id) == 0 { <- false }
  if stdr.len(bundle_name) == 0 { <- false }
  let ?dn = display_name
  if stdr.len(dn) == 0 { dn = bundle_name }

  let marker = "/Contents/MacOS/"
  let m = stdr.index_of(exe_path, marker)
  if m < 0 { <- false }
  let marker_n = stdr.len(marker)
  let exe_n = stdr.len(exe_path)
  let exec_name = stdr.slice(exe_path, m + marker_n, exe_n)
  if stdr.len(exec_name) == 0 { <- false }
  if stdr.contains(exec_name, "/") { <- false }

  let bundle_root = stdr.slice(exe_path, 0, m)
  if stdr.len(bundle_root) == 0 { <- false }
  let contents_dir = stdr.str_concat(bundle_root, "/Contents")
  let macos_dir = stdr.str_concat(contents_dir, "/MacOS")
  let resources_dir = stdr.str_concat(contents_dir, "/Resources")
  let plist_path = stdr.str_concat(contents_dir, "/Info.plist")

  if !stdr.ensure_dir(macos_dir) { <- false }
  if !stdr.ensure_dir(resources_dir) { <- false }

  let lt = "\<"
  let gt = "\>"
  let ?plist = ""
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "?xml version=\"1.0\" encoding=\"UTF-8\"?")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, "\n")

  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\"")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, "\n")

  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "plist version=\"1.0\"")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, "\n")

  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "dict")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, "\n")

  plist = stdr.str_concat(plist, "  ")
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "key")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, "CFBundleDevelopmentRegion")
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "/key")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "string")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, "en")
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "/string")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, "\n")

  plist = stdr.str_concat(plist, "  ")
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "key")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, "CFBundleExecutable")
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "/key")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "string")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, exec_name)
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "/string")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, "\n")

  plist = stdr.str_concat(plist, "  ")
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "key")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, "CFBundleIdentifier")
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "/key")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "string")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, bundle_id)
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "/string")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, "\n")

  plist = stdr.str_concat(plist, "  ")
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "key")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, "CFBundleInfoDictionaryVersion")
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "/key")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "string")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, "6.0")
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "/string")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, "\n")

  plist = stdr.str_concat(plist, "  ")
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "key")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, "CFBundleName")
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "/key")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "string")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, dn)
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "/string")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, "\n")

  plist = stdr.str_concat(plist, "  ")
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "key")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, "CFBundleDisplayName")
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "/key")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, lt)
  plist = stdr.str_concat(plist, "string")
  plist = stdr.str_concat(plist, gt)
  plist = stdr.str_concat(plist, dn)
