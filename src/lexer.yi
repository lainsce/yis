cask lexer

bring stdr

: tok(kind = string, line = num, col = num, text = string, int_val = num, str_val = string) (( any ))
  let ?t = []: [string => any]
  let k_kind = "kind"
  let k_line = "line"
  let k_col = "col"
  let k_text = "text"
  let k_int_val = "int_val"
  let k_str_val = "str_val"
  t[k_kind] = kind
  t[k_line] = line
  t[k_col] = col
  if stdr.len(text) > 0 { t[k_text] = text }
  if int_val != 0 || kind == "int" || kind == "float" { t[k_int_val] = int_val }
  if stdr.len(str_val) > 0 || kind == "str" { t[k_str_val] = str_val }
  <- t
;

: lex_error(message = string, i = num, line = num, col = num) (( any ))
  <- [tok("error", line, col, message, 0, ""), i, line, col]
;

: is_space(c = string) (( bool ))
  if stdr.is_null(c) || stdr.len(c) == 0 { <- false }
  let code = stdr.char_code(c)
  <- code == 32 || code == 9 || code == 10 || code == 13
;

: is_digit(c = string) (( bool ))
  if stdr.is_null(c) || stdr.len(c) == 0 { <- false }
  let code = stdr.char_code(c)
  <- code >= 48 && code <= 57
;

: is_hex_alpha(c = string) (( bool ))
  if stdr.is_null(c) || stdr.len(c) == 0 { <- false }
  let code = stdr.char_code(c)
  <- (code >= 97 && code <= 102) || (code >= 65 && code <= 70)
;

: is_hex_alpha_upper(c = string) (( bool ))
  if stdr.is_null(c) || stdr.len(c) == 0 { <- false }
  let code = stdr.char_code(c)
  <- code >= 65 && code <= 70
;

: bare_hex_literal_len(source = string, i = num) (( num ))
  let n = stdr.len(source)
  for (let ?want = 4; want >= 2; want -= 2)
    if i + want > n { continue }
    let ?ok = true
    let ?has_digit = false
    let ?has_alpha = false
    for (let ?off = 0; off < want; off += 1)
      let ch = stdr.slice(source, i + off, i + off + 1)
      if hex_value(ch) < 0
        ok = false
        break
      if is_digit(ch)
        has_digit = true
      elif is_hex_alpha(ch)
        has_alpha = true
    if !ok { continue }
    if !has_digit { continue }
    let first = stdr.slice(source, i, i + 1)
    if !is_digit(first)
      if !is_hex_alpha_upper(first) { continue }
      let ?upper_alpha = true
      for (let ?off = 0; off < want; off += 1)
        let ch = stdr.slice(source, i + off, i + off + 1)
        if is_hex_alpha(ch) && !is_hex_alpha_upper(ch)
          upper_alpha = false
          break
      if !upper_alpha { continue }
    elif first != "0" && !has_alpha { continue }
    if i + want < n
      let next = stdr.slice(source, i + want, i + want + 1)
      if is_ident_mid(next) { continue }
    <- want
  <- 0
;

: is_ident_start(c = string) (( bool ))
  if stdr.is_null(c) || stdr.len(c) == 0 { <- false }
  let code = stdr.char_code(c)
  <- (code >= 97 && code <= 122) || (code >= 65 && code <= 90) || code == 95
;

: is_ident_mid(c = string) (( bool ))
  <- is_ident_start(c) || is_digit(c)
;

: skip_line_comment(source = string, i = num, line = num, col = num) (( any ))
  let n = stdr.len(source)
  let ?j = i
  for (; j < n; j = j + 1)
    let ch = stdr.slice(source, j, j + 1)
    if stdr.char_code(ch) == 10 { <- [j + 1, line + 1, 1] }
  <- [n, line, col]
;

: skip_block_comment(source = string, i = num, line = num, col = num) (( any ))
  let n = stdr.len(source)
  let ?j = i
  let ?cur_line = line
  let ?cur_col = col
  let ?depth = 1
  for (; j < n && depth > 0; )
    let c0 = stdr.slice(source, j, j + 1)
    let ?c1 = ""
    if j + 1 < n { c1 = stdr.slice(source, j + 1, j + 2) }
    if c0 == "-" && c1 == "|"
      depth += 1
      j += 2
      cur_col += 2
      continue
    if c0 == "|" && c1 == "-"
      depth -= 1
      j += 2
      cur_col += 2
      continue
    if stdr.char_code(c0) == 10
      j += 1
      cur_line += 1
      cur_col = 1
    else
      j += 1
      cur_col += 1
  if depth > 0 { <- null }
  <- [j, cur_line, cur_col]
;

: skip_ws_and_comments(source = string, i = num, line = num, col = num, in_ret = bool) (( any ))
  let n = stdr.len(source)
  let ?cur_i = i
  let ?cur_line = line
  let ?cur_col = col
  for (; true; )
    if cur_i >= n { <- [cur_i, cur_line, cur_col] }
    let c = stdr.slice(source, cur_i, cur_i + 1)
    if c == "-" && cur_i + 1 < n
      let c2 = stdr.slice(source, cur_i + 1, cur_i + 2)
      if c2 == "|"
        let r = skip_block_comment(source, cur_i + 2, cur_line, cur_col + 2)
        if stdr.is_null(r)
          let ?err = []: [any]
          err[0] = cur_i
          err[1] = cur_line
          err[2] = cur_col
          err[3] = "unterminated block comment"
          <- err
        cur_i = r[0] ?? 0
        cur_line = r[1] ?? 1
        cur_col = r[2] ?? 1
        continue
      if c2 == "-" && !in_ret
        let r = skip_line_comment(source, cur_i + 2, cur_line, cur_col)
        cur_i = r[0] ?? 0
        cur_line = r[1] ?? 1
        cur_col = r[2] ?? 1
        continue
    if is_space(c)
      if stdr.char_code(c) == 10
        cur_i = cur_i + 1
        cur_line = cur_line + 1
        cur_col = 1
      else
        cur_i = cur_i + 1
        cur_col = cur_col + 1
      continue
    <- [cur_i, cur_line, cur_col]
  <- [cur_i, cur_line, cur_col]
;

: hex_value(c = string) (( num ))
  if stdr.is_null(c) || stdr.len(c) == 0 { <- -1 }
  let code = stdr.char_code(c)
  if code >= 48 && code <= 57 { <- code - 48 }
  if code >= 97 && code <= 102 { <- 10 + (code - 97) }
  if code >= 65 && code <= 70 { <- 10 + (code - 65) }
  <- -1
;

-- Validate magnitudes before numeric conversion. 2^63 is reserved for the
-- parser's unary-minus case, since its positive value does not fit int64.
: lex_integer(raw = string, digits = string, base = num, end_i = num, line = num, col = num) (( any ))
  let n = stdr.len(digits)
  let ?start = 0
  for (; start + 1 < n; start += 1)
    if stdr.slice(digits, start, start + 1) != "0" { break }
  let canonical = stdr.slice(digits, start, n)
  let limit = if base == 16 { "8000000000000000" } else { "9223372036854775808" }
  let size = stdr.len(canonical)
  let limit_size = stdr.len(limit)
  let ?comparison = 0
  if size > limit_size { comparison = 1 }
  elif size < limit_size { comparison = 0 - 1 }
  else
    for (let ?i = 0; i < size; i += 1)
      let digit = hex_value(stdr.slice(canonical, i, i + 1))
      let bound = hex_value(stdr.slice(limit, i, i + 1))
      if digit > bound { comparison = 1; break }
      if digit < bound { comparison = 0 - 1; break }
  if comparison > 0
    <- lex_error("integer literal is outside the signed 64-bit range", end_i, line, col)

  let ?t = tok("int", line, col, raw, 0, "")
  if comparison == 0
    t["int_text"] = "9223372036854775808"
    t["min_magnitude"] = true
  elif base == 16
    -- The range check proves each multiplication and addition fits int64.
    let ?value = 0
    for (let ?i = 0; i < size; i += 1)
      value = value * 16 + hex_value(stdr.slice(canonical, i, i + 1))
    t["int_text"] = stdr.str(value)
  else
    t["int_text"] = canonical
  <- [t, end_i, line, col + stdr.len(raw)]
;

: ascii_from_code(code = num) (( string ))
  if code == 7 { <- "\a" }
  if code == 8 { <- "\b" }
  if code == 9 { <- "\t" }
  if code == 10 { <- "\n" }
  if code == 11 { <- "\v" }
  if code == 12 { <- "\f" }
  if code == 13 { <- "\r" }
  if code == 27 { <- "\e" }
  if code >= 32 && code <= 126
    let printable = " !\"#$%&'()*+,-./0123456789:\<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    <- stdr.slice(printable, code - 32, code - 31)
  if code >= 0 && code <= 127 { <- stdr.char_from_code(code) }
  <- ""
;

: escape_pair(text = string, next_i = num) (( any ))
  let ?r = []: [string => any]
  r["text"] = text
  r["next"] = next_i
  <- r
;

: decode_escape(source = string, i = num, n = num) (( any ))
  if i + 1 >= n { <- escape_pair("", n) }
  let e = stdr.slice(source, i + 1, i + 2)
  if e == "n" { <- escape_pair("\n", i + 2) }
  if e == "a" { <- escape_pair("\a", i + 2) }
  if e == "b" { <- escape_pair("\b", i + 2) }
  if e == "e" { <- escape_pair("\e", i + 2) }
  if e == "f" { <- escape_pair("\f", i + 2) }
  if e == "t" { <- escape_pair("\t", i + 2) }
  if e == "r" { <- escape_pair("\r", i + 2) }
  if e == "v" { <- escape_pair("\v", i + 2) }
  if e == "\\" { <- escape_pair("\\", i + 2) }
  if e == "\"" { <- escape_pair("\"", i + 2) }
  if e == "'" { <- escape_pair("'", i + 2) }
  if e == "\<" { <- escape_pair("\<", i + 2) }
  if e == "\>" { <- escape_pair("\>", i + 2) }
  if e == "$" { <- escape_pair("$", i + 2) }
  if e == "?" { <- escape_pair("?", i + 2) }

  if e == "x"
    if i + 3 < n
      let h1 = stdr.slice(source, i + 2, i + 3)
      let h2 = stdr.slice(source, i + 3, i + 4)
      let v1 = hex_value(h1)
      let v2 = hex_value(h2)
      if v1 >= 0 && v2 >= 0
        let value = v1 * 16 + v2
        let ?ch = ""
        if value <= 127
          ch = ascii_from_code(value)
        else
          ch = stdr.char_from_code(value)
        if stdr.len(ch) > 0
          <- escape_pair(ch, i + 4)
    <- escape_pair("x", i + 2)

  let ec = stdr.char_code(e)
  if ec >= 48 && ec <= 55
    let ?j = i + 1
    let ?value = 0
    let ?digits = 0
    for (; j < n && digits < 3; )
      let d = stdr.slice(source, j, j + 1)
      let dc = stdr.char_code(d)
      if dc < 48 || dc > 55 { break }
      value = value * 8 + (dc - 48)
      digits = digits + 1
      j = j + 1
    if digits > 0 && value >= 0
      let ?ch = ""
      if value <= 127
        ch = ascii_from_code(value)
      else
        ch = stdr.char_from_code(value)
      if stdr.len(ch) > 0
        <- escape_pair(ch, j)
    <- escape_pair(e, i + 2)

  if e == "u" && i + 2 < n && stdr.slice(source, i + 2, i + 3) == "{"
    let ?j = i + 3
    let ?value = 0
    let ?digits = 0
    let ?ok = true
    for (; j < n; )
      let ch = stdr.slice(source, j, j + 1)
      if ch == "}" { break }
      let hv = hex_value(ch)
      if hv < 0 { ok = false; break }
      value = value * 16 + hv
      digits = digits + 1
      j = j + 1
    if ok && digits > 0 && j < n && stdr.slice(source, j, j + 1) == "}"
      let ?out = ""
      if value <= 127
        out = ascii_from_code(value)
      else
        out = stdr.char_from_code(value)
      if stdr.len(out) > 0
        <- escape_pair(out, j + 1)
    <- escape_pair("u", i + 2)

  <- escape_pair(e, i + 2)
;

: lex_one(source = string, i = num, line = num, col = num, decode_escapes = bool) (( any ))
  let n = stdr.len(source)
  if i >= n
    <- [tok("eof", line, col, "", 0, ""), n, line, col]
  let c = stdr.slice(source, i, i + 1)
  let hex_len = bare_hex_literal_len(source, i)
  if hex_len > 0
    let raw = stdr.slice(source, i, i + hex_len)
    <- lex_integer(raw, raw, 16, i + hex_len, line, col)
  if c == ";" { <- [tok("semi", line, col, "", 0, ""), i + 1, line, col + 1] }
  if c == "(" { <- [tok("lpar", line, col, "", 0, ""), i + 1, line, col + 1] }
  if c == ")" { <- [tok("rpar", line, col, "", 0, ""), i + 1, line, col + 1] }
  if c == "[" { <- [tok("lbrack", line, col, "", 0, ""), i + 1, line, col + 1] }
  if c == "]" { <- [tok("rbrack", line, col, "", 0, ""), i + 1, line, col + 1] }
  if c == "{" { <- [tok("lbrace", line, col, "", 0, ""), i + 1, line, col + 1] }
  if c == "}" { <- [tok("rbrace", line, col, "", 0, ""), i + 1, line, col + 1] }
  if c == ","
    if i + 1 < n
      let c2 = stdr.slice(source, i + 1, i + 2)
      if c2 == ":" { <- [tok("commacolon", line, col, "", 0, ""), i + 2, line, col + 2] }
    <- [tok("comma", line, col, "", 0, ""), i + 1, line, col + 1]
  if c == "."
    if i + 1 < n
      let c2 = stdr.slice(source, i + 1, i + 2)
      if c2 == ":" { <- [tok("dotcolon", line, col, "", 0, ""), i + 2, line, col + 2] }
    <- [tok("dot", line, col, "", 0, ""), i + 1, line, col + 1]
  if c == ":"
    if i + 1 < n
      let c2 = stdr.slice(source, i + 1, i + 2)
      if c2 == ":" { <- [tok("coloncolon", line, col, "", 0, ""), i + 2, line, col + 2] }
    <- [tok("colon", line, col, "", 0, ""), i + 1, line, col + 1]
  if c == "+"
    if i + 1 < n
      let c2 = stdr.slice(source, i + 1, i + 2)
      if c2 == "=" { <- [tok("plus_eq", line, col, "", 0, ""), i + 2, line, col + 2] }
    <- [tok("plus", line, col, "", 0, ""), i + 1, line, col + 1]
  if c == "*"
    if i + 1 < n
      let c2 = stdr.slice(source, i + 1, i + 2)
      if c2 == "=" { <- [tok("star_eq", line, col, "", 0, ""), i + 2, line, col + 2] }
    <- [tok("star", line, col, "", 0, ""), i + 1, line, col + 1]
  if c == "/"
    if i + 1 < n
      let c2 = stdr.slice(source, i + 1, i + 2)
      if c2 == "=" { <- [tok("slash_eq", line, col, "", 0, ""), i + 2, line, col + 2] }
    <- [tok("slash", line, col, "", 0, ""), i + 1, line, col + 1]
  if c == "%"
    if i + 1 < n
      let c2 = stdr.slice(source, i + 1, i + 2)
      if c2 == "=" { <- [tok("percent_eq", line, col, "", 0, ""), i + 2, line, col + 2] }
    <- [tok("percent", line, col, "", 0, ""), i + 1, line, col + 1]
  if c == "!"
    if i + 1 < n
      let c2 = stdr.slice(source, i + 1, i + 2)
      if c2 == "=" { <- [tok("ne", line, col, "", 0, ""), i + 2, line, col + 2] }
      if c2 == ":" { <- [tok("bangcolon", line, col, "", 0, ""), i + 2, line, col + 2] }
    <- [tok("bang", line, col, "", 0, ""), i + 1, line, col + 1]
  if c == "="
    if i + 1 < n
      let c2 = stdr.slice(source, i + 1, i + 2)
      if c2 == "=" { <- [tok("eqeq", line, col, "", 0, ""), i + 2, line, col + 2] }
      if c2 == "\>" { <- [tok("arrow", line, col, "", 0, ""), i + 2, line, col + 2] }
      if c2 == ":" { <- [tok("eqcolon", line, col, "", 0, ""), i + 2, line, col + 2] }
    <- [tok("eq", line, col, "", 0, ""), i + 1, line, col + 1]
  if c == "\<"
    if i + 1 < n
      let c2 = stdr.slice(source, i + 1, i + 2)
      if c2 == "=" { <- [tok("le", line, col, "", 0, ""), i + 2, line, col + 2] }
      if c2 == "-" { <- [tok("arrow_left", line, col, "", 0, ""), i + 2, line, col + 2] }
    <- [tok("lt", line, col, "", 0, ""), i + 1, line, col + 1]
  if c == "\>"
    if i + 1 < n
      let c2 = stdr.slice(source, i + 1, i + 2)
      if c2 == "=" { <- [tok("ge", line, col, "", 0, ""), i + 2, line, col + 2] }
    <- [tok("gt", line, col, "", 0, ""), i + 1, line, col + 1]
  if c == "?"
    if i + 1 < n
      let c2 = stdr.slice(source, i + 1, i + 2)
      if c2 == "?" { <- [tok("qq", line, col, "", 0, ""), i + 2, line, col + 2] }
    <- [tok("qmark", line, col, "", 0, ""), i + 1, line, col + 1]
  if c == "&"
    if i + 1 < n
      let c2 = stdr.slice(source, i + 1, i + 2)
      if c2 == "&" { <- [tok("ampamp", line, col, "", 0, ""), i + 2, line, col + 2] }
    <- [tok("amp", line, col, "", 0, ""), i + 1, line, col + 1]
  if c == "|"
    if i + 1 < n
      let c2 = stdr.slice(source, i + 1, i + 2)
      if c2 == "|" { <- [tok("barbar", line, col, "", 0, ""), i + 2, line, col + 2] }
      if c2 == ":" { <- [tok("barcolon", line, col, "", 0, ""), i + 2, line, col + 2] }
    <- [tok("bar", line, col, "", 0, ""), i + 1, line, col + 1]
  if c == "#" { <- [tok("hash", line, col, "", 0, ""), i + 1, line, col + 1] }
  if c == "-"
    if i + 1 < n
      let c2 = stdr.slice(source, i + 1, i + 2)
      if c2 == "=" { <- [tok("minus_eq", line, col, "", 0, ""), i + 2, line, col + 2] }
      if c2 == "\>" { <- [tok("arrow_right", line, col, "", 0, ""), i + 2, line, col + 2] }
    <- [tok("minus", line, col, "", 0, ""), i + 1, line, col + 1]
  if is_digit(c)
    if c == "0" && i + 1 < n
      let nx = stdr.slice(source, i + 1, i + 2)
      if nx == "x" || nx == "X"
        let first_hex = stdr.slice(source, i + 2, i + 3)
        if hex_value(first_hex) < 0
          <- lex_error("hexadecimal literal requires a digit", i, line, col)
        let ?j = i + 2
        for (; j < n; )
          let ch = stdr.slice(source, j, j + 1)
          if hex_value(ch) < 0 { break }
          j = j + 1
        if j < n && is_ident_mid(stdr.slice(source, j, j + 1))
          <- lex_error("invalid digit in hexadecimal literal", i, line, col)
        let raw = stdr.slice(source, i, j)
        let hex_digits = stdr.slice(source, i + 2, j)
        <- lex_integer(raw, hex_digits, 16, j, line, col)
    let ?j = i
    for (; j < n; )
      let ch = stdr.slice(source, j, j + 1)
      if !is_digit(ch) { break }
      j = j + 1
    let ?is_float = false
    if j < n
      let d = stdr.slice(source, j, j + 1)
      if d == "." && j + 1 < n && is_digit(stdr.slice(source, j + 1, j + 2))
        is_float = true
        j = j + 1
        for (; j < n; )
          let fh = stdr.slice(source, j, j + 1)
          if !is_digit(fh) { break }
          j = j + 1
    let raw = stdr.slice(source, i, j)
    if is_float
      <- [tok("float", line, col, raw, 0, ""), j, line, col + (j - i)]
    <- lex_integer(raw, raw, 10, j, line, col)
  if is_ident_start(c)
    let ?j = i
    for (; j < n; )
      let ch = stdr.slice(source, j, j + 1)
      if !is_ident_mid(ch) { break }
      j = j + 1
    let text = stdr.slice(source, i, j)
    let ?kind = "ident"
    if text == "let" { kind = "kw_let" }
    elif text == "if" { kind = "kw_if" }
    elif text == "else" { kind = "kw_else" }

    elif text == "bring" { kind = "kw_bring" }
    elif text == "cask" { kind = "kw_cask" }
    elif text == "pub" { kind = "kw_pub" }
    elif text == "true" { kind = "kw_true" }
    elif text == "false" { kind = "kw_false" }
    elif text == "null" { kind = "kw_null" }
    elif text == "match" { kind = "kw_match" }
    elif text == "for" { kind = "kw_for" }
    elif text == "in" { kind = "kw_in" }
    elif text == "new" { kind = "kw_new" }
    elif text == "class" { kind = "kw_class" }

    elif text == "def" { kind = "kw_def" }
    elif text == "const" { kind = "kw_const" }
    elif text == "elif" { kind = "kw_elif" }
    elif text == "break" { kind = "kw_break" }
    elif text == "continue" { kind = "kw_continue" }

    <- [tok(kind, line, col, text, 0, ""), j, line, col + (j - i)]
  if c == "\""
    let start_col = col
    let ?j = i + 1
    -- First pass: check if there are any unescaped interpolation markers
    let ?has_interp = false
    let ?scan = i + 1
    for (; scan < n; )
      let sc = stdr.slice(source, scan, scan + 1)
      if sc == "\"" { break }
      if sc == "\\" && scan + 1 < n { scan = scan + 2; continue }
      if sc == "$" && scan + 1 < n && stdr.slice(source, scan + 1, scan + 2) == "$" { has_interp = true; break }
      scan = scan + 1
    if !has_interp
      -- Simple string, no interpolation
      if !decode_escapes
        for (; j < n; )
          let ch = stdr.slice(source, j, j + 1)
          if ch == "\""
            let str_val = stdr.slice(source, i + 1, j)
            <- [tok("str", line, col, "", 0, str_val), j + 1, line, start_col + (j - i + 1)]
          if ch == "\\" && j + 1 < n { j = j + 2; continue }
          if stdr.char_code(ch) == 10 { break }
          j = j + 1
        <- lex_error("unterminated string", j, line, col)

      let ?str_parts = []: [any]
      let ?chunk_start = j
      for (; j < n; )
        let ch = stdr.slice(source, j, j + 1)
        if ch == "\""
          if chunk_start < j { stdr.push(str_parts, stdr.slice(source, chunk_start, j)) }
          <- [tok("str", line, col, "", 0, stdr.join(str_parts)), j + 1, line, start_col + (j - i + 1)]
        if ch == "\\" && j + 1 < n
          if chunk_start < j { stdr.push(str_parts, stdr.slice(source, chunk_start, j)) }
          let r = decode_escape(source, j, n)
          stdr.push(str_parts, stdr.str(r["text"] ?? ""))
          j = r["next"] ?? (j + 2)
          chunk_start = j
          continue
        if stdr.char_code(ch) == 10 { break }
        j = j + 1
      <- lex_error("unterminated string", j, line, col)
    -- Interpolated string: split into parts
    if !decode_escapes
      let ?parts = []: [any]
      let ?seg_start = i + 1
      for (; j < n; )
        let ch = stdr.slice(source, j, j + 1)
        if ch == "\"" { break }
        if ch == "\\" && j + 1 < n { j = j + 2; continue }
        if ch == "$" && j + 1 < n && stdr.slice(source, j + 1, j + 2) == "$"
          if j > seg_start
            let ?tp = []: [string => any]
            let tkk = "kind"
            let tvk = "val"
            tp[tkk] = "text"
            tp[tvk] = stdr.slice(source, seg_start, j)
            stdr.push(parts, tp)
          let ?vstart = j + 2
          let ?vend = vstart
          for (; vend < n; )
            let vc = stdr.slice(source, vend, vend + 1)
            if vc == "$" && vend + 1 < n && stdr.slice(source, vend + 1, vend + 2) == "$" { break }
            if stdr.char_code(vc) == 10 { break }
            vend = vend + 1
          let ?ep = []: [string => any]
          let ekk = "kind"
          let evk = "val"
          ep[ekk] = "expr"
          ep[evk] = stdr.slice(source, vstart, vend)
          stdr.push(parts, ep)
          if vend + 1 < n && stdr.slice(source, vend, vend + 1) == "$" && stdr.slice(source, vend + 1, vend + 2) == "$"
            j = vend + 2
          else
            <- lex_error("unterminated interpolation placeholder", vend, line, col)
          seg_start = j
          continue
        if stdr.char_code(ch) == 10 { break }
        j = j + 1
      if j >= n || stdr.slice(source, j, j + 1) != "\"" { <- lex_error("unterminated string", j, line, col) }
      if j > seg_start
        let ?tp = []: [string => any]
        let tkk = "kind"
        let tvk = "val"
        tp[tkk] = "text"
        tp[tvk] = stdr.slice(source, seg_start, j)
        stdr.push(parts, tp)
      let ?t_interp = tok("str_interp", line, col, "", 0, "")
      let partsk = "parts"
      t_interp[partsk] = parts
      let end_j = if j < n { j + 1 } else { j }
      <- [t_interp, end_j, line, start_col + (end_j - i)]

    let ?parts = []: [any]
    let ?seg_parts = []: [any]
    let ?seg_chunk_start = j
    for (; j < n; )
      let ch = stdr.slice(source, j, j + 1)
      if ch == "\"" { break }
      if ch == "\\" && j + 1 < n
        if seg_chunk_start < j { stdr.push(seg_parts, stdr.slice(source, seg_chunk_start, j)) }
        let r = decode_escape(source, j, n)
        stdr.push(seg_parts, stdr.str(r["text"] ?? ""))
        j = r["next"] ?? (j + 2)
        seg_chunk_start = j
        continue
      if ch == "$" && j + 1 < n && stdr.slice(source, j + 1, j + 2) == "$"
        if seg_chunk_start < j { stdr.push(seg_parts, stdr.slice(source, seg_chunk_start, j)) }
        let seg = stdr.join(seg_parts)
        seg_parts = []: [any]
        if stdr.len(seg) > 0
          let ?tp = []: [string => any]
          let tkk = "kind"
          let tvk = "val"
          tp[tkk] = "text"
          tp[tvk] = seg
          stdr.push(parts, tp)
        let ?vstart = j + 2
        let ?vend = vstart
        for (; vend < n; )
          let vc = stdr.slice(source, vend, vend + 1)
          if vc == "$" && vend + 1 < n && stdr.slice(source, vend + 1, vend + 2) == "$" { break }
          if stdr.char_code(vc) == 10 { break }
          vend = vend + 1
        let ?ep = []: [string => any]
        let ekk = "kind"
        let evk = "val"
        ep[ekk] = "expr"
        ep[evk] = stdr.slice(source, vstart, vend)
        stdr.push(parts, ep)
        if vend + 1 < n && stdr.slice(source, vend, vend + 1) == "$" && stdr.slice(source, vend + 1, vend + 2) == "$"
          j = vend + 2
        else
          <- lex_error("unterminated interpolation placeholder", vend, line, col)
        seg_chunk_start = j
        continue
      if stdr.char_code(ch) == 10 { break }
      j = j + 1
    if j >= n || stdr.slice(source, j, j + 1) != "\"" { <- lex_error("unterminated string", j, line, col) }
    if seg_chunk_start < j { stdr.push(seg_parts, stdr.slice(source, seg_chunk_start, j)) }
    let seg_final = stdr.join(seg_parts)
    if stdr.len(seg_final) > 0
      let ?tp = []: [string => any]
      let tkk = "kind"
      let tvk = "val"
      tp[tkk] = "text"
      tp[tvk] = seg_final
      stdr.push(parts, tp)
    let ?t_interp = tok("str_interp", line, col, "", 0, "")
    let partsk = "parts"
    t_interp[partsk] = parts
    let end_j = if j < n { j + 1 } else { j }
    <- [t_interp, end_j, line, start_col + (end_j - i)]
  <- lex_error(stdr.str_concat("unexpected character: ", c), i + 1, line, col)
;

: is_stmt_end(kind = string) (( bool ))
  <- kind == "rbrace" || kind == "semi" || kind == "rpar" || kind == "rbrack" || kind == "int" || kind == "float" || kind == "ident" || kind == "str" || kind == "str_interp" || kind == "kw_true" || kind == "kw_false" || kind == "kw_null" || kind == "kw_break" || kind == "kw_continue" || kind == "arrow_left"
;

: insert_auto_semis(toks = any) (( any ))
  let n = stdr.len(toks)
  if n == 0 { <- toks }
  let kind = "kind"
  let ?result = []: [any]
  let ?nest = 0
  let ?last_sig = ""
  let ?last_line = 0
  let ?i = 0
  for (; i < n; i = i + 1)
    let t = toks[i]
    let tk = t[kind] ?? ""
    let tline = stdr.num(t["line"] ?? 0)
    -- Insert newline_semi when moving to a new line at nest==0 after a stmt-end
    if tline > last_line && last_line > 0 && nest == 0 && is_stmt_end(last_sig)
      stdr.push(result, tok("newline_semi", last_line, 0, ";", 0, ""))
    -- Track nesting depth
    if tk == "lpar" || tk == "lbrack" || tk == "lbrace" { nest = nest + 1 }
    if tk == "rpar" || tk == "rbrack" || tk == "rbrace"
      if nest > 0 { nest = nest - 1 }
    -- Push token
    stdr.push(result, t)
    -- Track last significant token (skip semi/newline_semi)
    if tk != "semi" && tk != "newline_semi" { last_sig = tk }
    last_line = tline
  -- Emit trailing newline_semi if needed
  if nest == 0 && is_stmt_end(last_sig)
    stdr.push(result, tok("newline_semi", last_line, 0, ";", 0, ""))
  -- Post-processing fixups
  let rn = stdr.len(result)
  if rn <= 1 { <- result }
  let ?out = []: [any]
  let ?w = 0
  i = 0
  for (; i < rn; i = i + 1)
    let ri = result[i] ?? []: [string => any]
    let rk = ri[kind] ?? ""
    let oi = if w > 0 { out[w - 1] ?? []: [string => any] } else { []: [string => any] }
    let pk = oi[kind] ?? ""
    -- Remove newline_semi before dot (method chain) or arrow (lambda continuation)
    let is_chain = rk == "dot" || rk == "arrow"
    if is_chain && pk == "newline_semi"
      out[w - 1] = result[i]
      continue
    -- Dedup consecutive semis: keep explicit over auto
    let rk_semi = rk == "semi" || rk == "newline_semi"
    let pk_semi = pk == "semi" || pk == "newline_semi"
    if rk_semi && pk_semi
      if rk == "semi" && pk == "semi"
        stdr.push(out, result[i])
        w = w + 1
        continue
      if rk == "semi" && pk == "newline_semi"
        out[w - 1] = result[i]
      continue
    stdr.push(out, result[i])
    w = w + 1
  <- out
;

: lex_rest(source = string, i = num, line = num, col = num, acc = any, decode_escapes = bool) (( any ))
  let n = stdr.len(source)
  let ?cur_i = i
  let ?cur_line = line
  let ?cur_col = col
  let ?cur_acc = acc
  let kind = "kind"
  let ?ret_depth = 0
  let ?last_kind = ""
  let ?second_last_kind = ""
  for (; true; )
    let r = skip_ws_and_comments(source, cur_i, cur_line, cur_col, ret_depth > 0)
    let i2 = r[0] ?? 0
    let line2 = r[1] ?? 1
    let col2 = r[2] ?? 1
    let ws_error = r[3] ?? ""
    if stdr.len(ws_error) > 0
      stdr.push(cur_acc, tok("error", line2, col2, ws_error, 0, ""))
      <- cur_acc
    let lr = lex_one(source, i2, line2, col2, decode_escapes)
    let t = lr[0]
    let ?next_i = 0
    next_i = stdr.num(lr[1] ?? 0)
    let ?next_line = 1
    next_line = stdr.num(lr[2] ?? 1)
    let ?next_col = 1
    next_col = stdr.num(lr[3] ?? 1)
    let tk = t[kind] ?? ""
    if tk == "lpar" && last_kind == "lpar" && second_last_kind == "rpar"
      ret_depth = ret_depth + 1
    if tk == "rpar" && last_kind == "rpar" && ret_depth > 0
      ret_depth = ret_depth - 1
    stdr.push(cur_acc, t)
    if tk == "error" { <- cur_acc }
    if next_i >= n { <- cur_acc }
    if tk == "eof" { <- cur_acc }
    second_last_kind = last_kind
    last_kind = tk
    cur_i = next_i
    cur_line = next_line
    cur_col = next_col
  <- cur_acc
;

:: lex_with_escapes(source = string, decode_escapes = bool) (( any ))
  let raw = lex_rest(source, 0, 1, 1, []: [any], decode_escapes)
  <- insert_auto_semis(raw)
;

:: lex(source = string) (( any ))
  <- lex_with_escapes(source, false)
;
