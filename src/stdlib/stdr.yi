cask stdr

-- Yis Standard Library: stdr.yi

!: is_none() (( bool ))
  this == null
;

-- Internal output primitive (compiler intrinsic)
: __write(x = any) (( -- )) ;

-- Internal formatted output primitive (compiler intrinsic)
: __writef(fmt = string, args = any) (( -- )) ;

-- Internal line input primitive (compiler intrinsic)
: __read_line() (( string )) ;

-- Internal readf parser (compiler intrinsic)
: __readf_parse(fmt = string, line = string, args = any) (( any )) ;
: __read_text_file(path = string) (( any )) ;
: __write_text_file(path = string, text = string) (( bool )) ;
: __open_file_dialog(prompt = string, extension = string) (( any )) ;
: __open_folder_dialog(prompt = string) (( any )) ;
: __save_file_dialog(prompt = string, default_name = string, extension = string) (( any )) ;

-- Print formatted output
:: writef(fmt = string, args = any) (( -- ))
  __writef(fmt, args)
;

-- Read formatted input (returns line and parsed values)
:: readf(fmt = string, args = any) (( string, any ))
  __writef(fmt, args)
  let line = __read_line()
  let parsed = __readf_parse(fmt, line, args)
  <- (line, parsed)
;

-- Print a value
:: write(x = any) (( -- ))
  __write(x)
;

-- Check if a value is null
:: is_null(x = any) (( bool ))
  <- x.is_none()
;

-- Convert a value to a string (compiler intrinsic)
:: str(x = any) (( string )) ;

-- Internal length primitive (compiler intrinsic)
: __len(x = any) (( num )) ;

-- Coerce any to num (int/bool/float/parseable string → int; null/other → 0)
: __num(x = any) (( num )) ;

-- Get the length of an array or string
:: len(x = any) (( num ))
  <- __len(x)
;

-- Coerce value to num for comparisons and arithmetic (e.g. array index from any)
:: num(x = any) (( num ))
  <- __num(x)
;

-- Substring: slice(s, start, end) is s[start..end), 0-based; indices clamped
: __slice(s = string, start = num, end = num) (( string )) ;
:: slice(s = string, start = num, end = num) (( string ))
  <- __slice(s, start, end)
;

-- Concatenate two arrays; both must be arrays
: __concat(a = any, b = any) (( any )) ;
:: concat(a = any, b = any) (( any ))
  <- __concat(a, b)
;

-- Join an array of values into a string
:: join(arr = any) (( string ))
  let ?len = __len(arr)
  if len == 0 { <- "" }
  if len == 1 { <- str(arr[0]) }
  let ?a = []: [any]
  let ?i = 0
  for (; i < len; i = i + 1) { push(a, str(arr[i])) }
  for (; len > 1; )
    let ?j = 0
    let ?k = 0
    for (; j + 1 < len; j = j + 2)
      a[k] = str_concat(a[j], a[j + 1])
      k = k + 1
    if j < len { a[k] = a[j]; k = k + 1 }
    len = k
  <- a[0]
;

-- Push a value onto the end of an array in-place
:: push(arr = any, val = any) (( -- ))
  let ?a_ref = arr
  let idx = len(a_ref)
  a_ref[idx] = val
;

-- Concatenate two values as strings (returns string)
: __str_concat(a = any, b = any) (( string )) ;
:: str_concat(a = any, b = any) (( string ))
  <- __str_concat(a, b)
;

-- ASCII code of first character of string (0 if empty)
: __char_code(c = string) (( num )) ;
:: char_code(c = string) (( num ))
  <- __char_code(c)
;

-- Create a single-character string from an ASCII code
: __char_from_code(code = num) (( string )) ;
:: char_from_code(code = num) (( string ))
  <- __char_from_code(code)
;

-- Character at index (returns single-character string, or "" if out of range)
:: char_at(s = string, idx = num) (( string ))
  <- slice(s, idx, idx + 1)
;

-- Substring from start index to end of string
:: substring(s = string, start = num) (( string ))
  <- slice(s, start, len(s))
;

-- Substring from start index with given length
:: substring_len(s = string, start = num, n = num) (( string ))
  <- slice(s, start, start + n)
;

-- Replace all occurrences of 'from' with 'to' in text
: __replace(text = string, from = string, to = string) (( string )) ;
:: replace(text = string, from = string, to = string) (( string ))
  <- __replace(text, from, to)
;

-- Parse a hexadecimal string to a number (e.g. "ff" → 255, "0x1a" → 26)
: __parse_hex(s = string) (( num )) ;
:: parse_hex(s = string) (( num ))
  <- __parse_hex(s)
;

-- Floor: round down to nearest integer
: __floor(x = num) (( num )) ;
:: floor(x = num) (( num ))
  <- __floor(x)
;

-- Ceil: round up to nearest integer
: __ceil(x = num) (( num )) ;
:: ceil(x = num) (( num ))
  <- __ceil(x)
;

-- Get all keys of a dict as an array of strings
: __keys(d = any) (( [string] )) ;
:: keys(d = any) (( [string] ))
  <- __keys(d)
;

-- Read text file contents; returns null when file cannot be read
:: read_text_file(path = string) (( any ))
  <- __read_text_file(path)
;

-- Write text to a file; returns true on success
:: write_text_file(path = string, text = string) (( bool ))
  <- __write_text_file(path, text)
;

-- Ensure a directory exists, creating parent directories as needed
: __ensure_dir(path = string) (( bool )) ;

:: ensure_dir(path = string) (( bool ))
  <- __ensure_dir(path)
;

-- Remove a file; returns true if removed or already missing
: __remove_file(path = string) (( bool )) ;

:: remove_file(path = string) (( bool ))
  <- __remove_file(path)
;

-- Move/rename a file; returns true on success
: __move_file(src = string, dst = string) (( bool )) ;

:: move_file(src = string, dst = string) (( bool ))
  <- __move_file(src, dst)
;

-- Recursively list files under root matching any extension in exts
: __find_files(root = string, exts = any) (( [string] )) ;

:: find_files(root = string, exts = any) (( [string] ))
  <- __find_files(root, exts)
;

-- Recursively delete files older than N days; returns removed count
: __prune_files_older_than(dir = string, days = num) (( num )) ;

:: prune_files_older_than(dir = string, days = num) (( num ))
  <- __prune_files_older_than(dir, days)
;

-- Exit the process with a status code, flushing buffered output
: __exit_process(code = num) (( -- )) ;

:: exit_process(code = num) (( -- ))
  __exit_process(code)
;

-- Run a shell command; returns (exit_code, stdout) as (num, string)
: __run_command(cmd = string) (( num, string )) ;

:: run_command(cmd = string) (( num, string ))
  <- __run_command(cmd)
;

-- Check if a file exists (native stat-based, no subprocess)
: __file_exists(path = string) (( bool )) ;

:: file_exists(path = string) (( bool ))
  <- __file_exists(path)
;

-- Get file modification time as unix timestamp (-1 if not found)
: __file_mtime(path = string) (( num )) ;

:: file_mtime(path = string) (( num ))
  <- __file_mtime(path)
;

-- File modification time in nanoseconds since epoch (-1 if not found).
-- Precision follows the platform filesystem; Windows stat has second resolution.
: __file_mtime_ns(path = string) (( num )) ;

:: file_mtime_ns(path = string) (( num ))
  <- __file_mtime_ns(path)
;

-- Get current working directory (native, no subprocess)
: __getcwd() (( string )) ;

-- Get user home directory from environment
: __home_dir() (( string )) ;

-- Current unix timestamp (seconds)
: __unix_time() (( num )) ;

-- Current local date parts
: __current_year() (( num )) ;
: __current_month() (( num )) ;
: __current_day() (( num )) ;

-- Weekday for a date (0=Sun..6=Sat)
: __weekday(year = num, month = num, day = num) (( num )) ;

-- Parse ISO local datetime (YYYY-MM-DDTHH:MM) to epoch, optionally in timezone
: __iso_to_epoch(iso = string, tz = string) (( num )) ;

:: getcwd() (( string ))
  <- __getcwd()
;

:: home_dir() (( string ))
  <- __home_dir()
;

:: unix_time() (( num ))
  <- __unix_time()
;

:: current_year() (( num ))
  <- __current_year()
;

:: current_month() (( num ))
  <- __current_month()
;

:: current_day() (( num ))
  <- __current_day()
;

:: weekday(year = num, month = num, day = num) (( num ))
  <- __weekday(year, month, day)
;

:: iso_to_epoch(iso = string, tz = string) (( num ))
  <- __iso_to_epoch(iso, tz)
;

: is_ws(ch = string) (( bool ))
  let c = char_code(ch)
  <- c == 32 || c == 9 || c == 10 || c == 13
;

:: trim(text = string) (( string ))
  let n = len(text)
  let ?start = 0
  for (; start < n; start = start + 1)
    if !is_ws(slice(text, start, start + 1))
      break

  let ?end = n
  for (; end > start; end = end - 1)
    if !is_ws(slice(text, end - 1, end))
      break

  <- slice(text, start, end)
;

:: starts_with(text = string, prefix = string) (( bool ))
  let tn = len(text)
  let pn = len(prefix)
  if pn == 0
    <- true
  if pn > tn
    <- false
  <- slice(text, 0, pn) == prefix
;

:: ends_with(text = string, suffix = string) (( bool ))
  let tn = len(text)
  let sn = len(suffix)
  if sn == 0
    <- true
  if sn > tn
    <- false
  <- slice(text, tn - sn, tn) == suffix
;

:: index_of(text = string, needle = string) (( num ))
  let tn = len(text)
  let nn = len(needle)
  if nn == 0
    <- 0
  if nn > tn
    <- -1

  let ?i = 0
  let end = tn - nn
  for (; i <= end; i = i + 1)
    if slice(text, i, i + nn) == needle
      <- i
  <- -1
;

:: contains(text = string, needle = string) (( bool ))
  <- index_of(text, needle) >= 0
;

:: last_index_of(text = string, needle = string) (( num ))
  let tn = len(text)
  let nn = len(needle)
  if nn == 0 || nn > tn
    <- -1

  let ?pos = -1
  let ?i = 0
  let end = tn - nn
  for (; i <= end; i = i + 1)
    if slice(text, i, i + nn) == needle
      pos = i
  <- pos
;

:: shell_quote(text = string) (( string ))
  let ?p = []: [any]
  push(p, "'")
  let ?chunk_start = 0
  let n = len(text)
  let ?i = 0
  for (; i < n; i = i + 1)
    if slice(text, i, i + 1) == "'"
      if chunk_start < i { push(p, slice(text, chunk_start, i)) }
      push(p, "'\"'\"'")
      chunk_start = i + 1
  if chunk_start < n { push(p, slice(text, chunk_start, n)) }
  push(p, "'")
  <- join(p)
;

:: basename(path = string) (( string ))
  let p = trim(path)
  let idx = last_index_of(p, "/")
  if idx < 0
    <- p
  <- slice(p, idx + 1, len(p))
;

:: dirname(path = string) (( string ))
  let p = trim(path)
  let idx = last_index_of(p, "/")
  if idx <= 0
    <- ""
  <- slice(p, 0, idx)
;

:: stem(file_name = string) (( string ))
  let idx = last_index_of(file_name, ".")
  if idx <= 0
    <- file_name
  <- slice(file_name, 0, idx)
;

:: join_path(dir = string, name = string) (( string ))
  let base = trim(dir)
  let ?leaf = trim(name)

  if len(base) == 0
    <- leaf
  if len(leaf) == 0
    <- base

  let ?out = base
  if !ends_with(out, "/")
    out = str_concat(out, "/")
  if starts_with(leaf, "/")
    leaf = slice(leaf, 1, len(leaf))
  <- str_concat(out, leaf)
;

-- Command-line arguments (argv as array of strings)
: __args() (( [string] )) ;
:: args() (( [string] ))
  <- __args()
;

-- Open native file picker and <- selected path or null
:: open_file_dialog(prompt = string, extension = string) (( any ))
  <- __open_file_dialog(prompt, extension)
;

-- Open native folder picker and <- selected path or null
:: open_folder_dialog(prompt = string) (( any ))
  <- __open_folder_dialog(prompt)
;

-- Open native save dialog and <- selected path or null
:: save_file_dialog(prompt = string, default_name = string, extension = string) (( any ))
  <- __save_file_dialog(prompt, default_name, extension)
;
